---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import CtaButton from '../components/CtaButton.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

const commonProblems = [
  'Too much manual work',
  'Slow request fulfillment',
  'Knowledge scattered across tools',
  'Ticket volumes growing faster than the team',
];
const steps = [
  { icon: 'search', title: 'Review workflows', body: 'Walk through how work actually flows today, not how the diagram says it should.' },
  { icon: 'gauge', title: 'Identify bottlenecks', body: 'Find where time is lost, where work piles up, and why.' },
  { icon: 'gear', title: 'Find automation opportunities', body: 'Spot the repetitive work that should not need a human in the loop.' },
  { icon: 'sparkle', title: 'Evaluate AI use cases', body: 'Decide where AI is genuinely worth it, and where it is just noise.' },
];
const deliverables = [
  'An AI opportunity map',
  'A prioritized roadmap',
  'ROI estimates for the top opportunities',
  'Recommended next steps',
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'AI Opportunity Assessment',
  serviceType: 'Operational and AI opportunity assessment for ServiceNow',
  provider: { '@type': 'Person', name: site.name },
  areaServed: 'Europe',
  url: `${site.url}/ai-opportunity-assessment/`,
};
---

<BaseLayout
  title="AI Opportunity Assessment"
  description="A 2-4 week assessment that maps your bottlenecks, automation opportunities, and the AI use cases worth pursuing, with a prioritized roadmap and ROI estimates."
  jsonLd={jsonLd}
>
  <PageHeader eyebrow="Flagship engagement · 2-4 weeks" title="AI Opportunity Assessment">
    The easiest place to start. In two to four weeks I map where your operations lose time, what to
    automate, and where AI is genuinely worth it, with a roadmap you can act on.
  </PageHeader>

  <Section>
    <p class="eyebrow">Common problems</p>
    <h2 class="section-h2 display">This is for you if any of these sound familiar</h2>
    <ul class="rows" role="list">
      {commonProblems.map((p) => (
        <li><span class="row-icon"><Icon name="target" size={18} /></span>{p}</li>
      ))}
    </ul>
  </Section>

  <Section tone="surface">
    <p class="eyebrow">What happens</p>
    <h2 class="section-h2 display">How the assessment works</h2>
    <div class="steps">
      {steps.map((s, i) => (
        <article class="step" data-reveal style={`--reveal-delay:${i * 90}ms`}>
          <span class="card-icon"><Icon name={s.icon} /></span>
          <h3 class="card-title">{s.title}</h3>
          <p class="muted">{s.body}</p>
        </article>
      ))}
    </div>
  </Section>

  <Section>
    <p class="eyebrow">What you get</p>
    <h2 class="section-h2 display">Deliverables</h2>
    <ul class="rows" role="list">
      {deliverables.map((d) => (
        <li><span class="row-icon"><Icon name="chart" size={18} /></span>{d}</li>
      ))}
    </ul>
  </Section>

  <Section tone="dark">
    <div class="cta-band">
      <h2 class="cta-h2 display">Start with an assessment</h2>
      <p class="cta-lead">Low commitment, high clarity. You leave with a plan whether or not we build it together.</p>
      <div class="cluster">
        <CtaButton href="/contact/" size="lg">Book a consultation</CtaButton>
        <CtaButton href="/services/" variant="secondary" size="lg">See all services</CtaButton>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .section-h2 {
    font-size: var(--step-3);
    margin-bottom: 1.5rem;
  }
  .rows {
    display: grid;
    gap: 0.7rem;
    max-width: 52ch;
  }
  .rows li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--text);
  }
  .row-icon {
    display: inline-grid;
    place-items: center;
    flex: 0 0 auto;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-sm);
    background: var(--accent-soft);
    color: var(--accent);
  }
  .steps {
    display: grid;
    gap: clamp(1rem, 0.5rem + 1.5vw, 1.5rem);
    grid-template-columns: 1fr;
  }
  .step {
    padding: 1.5rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .card-icon {
    display: inline-grid;
    place-items: center;
    width: 2.7rem;
    height: 2.7rem;
    border-radius: var(--radius);
    background: var(--accent-soft);
    color: var(--accent);
    margin-bottom: 0.75rem;
  }
  .card-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-1);
    margin-bottom: 0.4rem;
  }
  .cta-band {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
    max-width: 46rem;
  }
  .cta-h2 {
    font-size: var(--step-3);
  }
  .cta-lead {
    color: #cfc9be;
    max-width: 52ch;
    line-height: 1.6;
  }
  @media (min-width: 640px) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
