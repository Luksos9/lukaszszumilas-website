---
import { site } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';
import Flag from './Flag.astro';
import { getPrimaryNav } from '../i18n/data';
import {
  useTranslations, localizeForNav, defaultLang, languages, translatedPaths, type Lang,
} from '../i18n/ui';

interface Props {
  lang?: Lang;
}
const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);

const nav = getPrimaryNav(lang);
const links = nav.filter((i) => !i.cta);
const cta = nav.find((i) => i.cta);
const homeHref = localizeForNav('/', lang);

const path = Astro.url.pathname;
const norm = (p: string) => (p !== '/' && p.endsWith('/') ? p.slice(0, -1) : p);
const here = norm(path);
const isActive = (href: string) => {
  const h = norm(href);
  return h === '/' ? here === '/' : here === h || here.startsWith(h + '/');
};
const homeActive = here === norm(homeHref);
// On a non-default-locale page, links that fall back to English cross the locale
// boundary; force a full reload so the persisted header re-renders in the right locale.
const crossLocale = (href: string) =>
  lang !== defaultLang && !/^(https?:|mailto:|tel:|#)/.test(href) && !href.startsWith(`/${lang}/`);

// Client-side picker config (kept in sync with the i18n module as locales/pages grow).
const langEntries = Object.entries(languages) as [Lang, string][];
const i18nConfig = {
  langs: Object.keys(languages),
  def: defaultLang as string,
  translated: Array.from(translatedPaths),
};
---

<div class="chrome" transition:persist>
  <a href={homeHref} class="brand" aria-label={`${site.name}, ${t('common.homeAria')}`}>
    <img class="brand-logo brand-logo--dark" src="/logo-mark-dark.webp" alt="" width="460" height="198" fetchpriority="high" />
    <img class="brand-logo brand-logo--light" src="/logo-mark-light.webp" alt="" width="460" height="198" fetchpriority="high" />
  </a>

  <div class="topbar-right">
    <div class="lang" data-lang-picker>
      <button
        class="lang-btn"
        type="button"
        data-lang-btn
        aria-haspopup="true"
        aria-expanded="false"
        aria-label={t('common.chooseLanguage')}
      >
        <svg class="lang-globe" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <circle cx="12" cy="12" r="9" />
          <path d="M3 12h18M12 3c2.5 2.5 2.5 15 0 18M12 3c-2.5 2.5-2.5 15 0 18" />
        </svg>
        <span class="lang-current" data-lang-current>{lang.toUpperCase()}</span>
      </button>
      <div class="lang-menu" data-lang-menu hidden>
        {langEntries.map(([code, name]) => (
          <a
            class:list={['lang-opt', { 'is-active': code === lang }]}
            data-lang-opt={code}
            hreflang={code}
            href={code === defaultLang ? '/' : `/${code}/`}
            data-astro-reload
          >
            <Flag code={code} />
            <span>{name}</span>
          </a>
        ))}
      </div>
    </div>
    <ThemeToggle />
    <button
      class="burger"
      type="button"
      data-burger
      aria-label={t('common.openMenu')}
      aria-expanded="false"
      aria-controls="site-menu"
    >
      <span class="burger-lines" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>
  </div>

  <div class="menu" id="site-menu" data-menu hidden>
    <nav class="menu-inner" aria-label="Primary">
      <a
        href={homeHref}
        class:list={['menu-link', { 'is-active': homeActive }]}
        data-astro-reload={crossLocale(homeHref) ? '' : undefined}
      >{t('common.home')}</a>
      {links.map((i) => (
        <a
          href={i.href}
          class:list={['menu-link', { 'is-active': isActive(i.href) }]}
          aria-current={isActive(i.href) ? 'page' : undefined}
          data-astro-reload={crossLocale(i.href) ? '' : undefined}
        >
          {i.label}
        </a>
      ))}
      {cta && (
        <a
          href={cta.href}
          class="menu-cta"
          data-analytics="book_menu"
          data-astro-reload={crossLocale(cta.href) ? '' : undefined}
        >
          {cta.label} <span aria-hidden="true">→</span>
        </a>
      )}
    </nav>
  </div>

  <nav class="rail" data-rail aria-label="Page sections"></nav>
</div>

<script define:vars={{ i18nConfig }}>
  // Language picker. The chrome is transition:persist'd, so compute hrefs from the
  // live URL on every page-load (like the rail), and bind the toggle only once.
  (() => {
    const setup = () => {
      const root = document.querySelector('[data-lang-picker]');
      if (!root) return;
      const btn = root.querySelector('[data-lang-btn]');
      const menu = root.querySelector('[data-lang-menu]');
      const curLabel = root.querySelector('[data-lang-current]');
      const close = () => {
        menu.setAttribute('hidden', '');
        btn.setAttribute('aria-expanded', 'false');
      };
      if (!root.dataset.bound) {
        root.dataset.bound = '1';
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          if (menu.hasAttribute('hidden')) {
            menu.removeAttribute('hidden');
            btn.setAttribute('aria-expanded', 'true');
          } else {
            close();
          }
        });
        document.addEventListener('click', (e) => {
          if (!root.contains(e.target)) close();
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') close();
        });
        menu.addEventListener('click', () => close());
      }
      // per-page hrefs + active state
      const segs = location.pathname.split('/').filter(Boolean);
      const first = segs[0];
      const isLoc = i18nConfig.langs.includes(first) && first !== i18nConfig.def;
      const curLang = isLoc ? first : i18nConfig.def;
      const rest = isLoc ? segs.slice(1) : segs;
      let stripped = '/' + rest.join('/');
      if (stripped !== '/' && !stripped.endsWith('/')) stripped += '/';
      if (curLabel) curLabel.textContent = curLang.toUpperCase();
      root.querySelectorAll('[data-lang-opt]').forEach((a) => {
        const code = a.getAttribute('data-lang-opt');
        let href;
        if (code === i18nConfig.def) {
          href = stripped;
        } else if (i18nConfig.translated.includes(stripped)) {
          href = '/' + code + (stripped === '/' ? '/' : stripped);
        } else {
          href = '/' + code + '/';
        }
        a.setAttribute('href', href);
        const active = code === curLang;
        a.setAttribute('aria-current', active ? 'true' : 'false');
        a.classList.toggle('is-active', active);
      });
    };
    document.addEventListener('astro:page-load', setup);
  })();
</script>

<script>
  // ---- Hamburger menu (chrome is transition:persist'd, so bind once) ----
  (() => {
    const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
    const menu = document.querySelector<HTMLElement>('[data-menu]');
    if (!burger || !menu || burger.dataset.bound) return;
    burger.dataset.bound = '1';
    const setOpen = (open: boolean) => {
      burger.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
      document.documentElement.classList.toggle('menu-open', open);
    };
    burger.addEventListener('click', () => setOpen(!!menu.hidden));
    menu.addEventListener('click', (e) => {
      if (e.target === menu) setOpen(false);
    });
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
  })();

  // ---- Section scroll-guide: rebuild from the current page's [data-nav] sections ----
  const RAIL_ICONS: Record<string, string> = {
    home: '<path d="M3 11l9-7 9 7"/><path d="M5 10v10h14V10"/>',
    sparkle: '<path d="M12 3l1.7 5.1L19 10l-5.3 1.9L12 17l-1.7-5.1L5 10z"/>',
    trend: '<path d="M3 17l6-6 4 4 7-7"/><path d="M17 8h4v4"/>',
    flow: '<circle cx="5" cy="6" r="2"/><circle cx="19" cy="6" r="2"/><circle cx="12" cy="18" r="2"/><path d="M7 6h10M6.5 7.7 11 16M17.5 7.7 13 16"/>',
    target: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1.5"/>',
    grid: '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
    trophy: '<path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0z"/><path d="M7 6H4v1.5A3.5 3.5 0 0 0 7.5 11M17 6h3v1.5A3.5 3.5 0 0 1 16.5 11"/>',
    book: '<path d="M5 4a2 2 0 0 1 2-2h12v16H7a2 2 0 0 0-2 2z"/><path d="M19 18H7a2 2 0 0 0-2 2"/>',
    arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  };
  let railIO: IntersectionObserver | undefined;
  function buildRail() {
    const rail = document.querySelector<HTMLElement>('[data-rail]');
    if (!rail) return;
    const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-nav]'));
    rail.replaceChildren();
    if (sections.length < 2) {
      rail.dataset.empty = '1';
      return;
    }
    delete rail.dataset.empty;
    const dots = sections.map((sec) => {
      const a = document.createElement('a');
      a.href = '#' + sec.id;
      a.className = 'rail-dot';
      // a section flagged data-nav-cta is the conversion target — highlight it.
      if (sec.hasAttribute('data-nav-cta')) a.classList.add('is-cta');
      const label = sec.getAttribute('data-nav') || '';
      a.setAttribute('aria-label', label);
      const icon = sec.getAttribute('data-nav-icon') || 'target';
      a.innerHTML =
        '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" ' +
        'stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' +
        (RAIL_ICONS[icon] || RAIL_ICONS.target) +
        '</svg>';
      const tip = document.createElement('span');
      tip.className = 'rail-tip';
      tip.textContent = label;
      a.appendChild(tip);
      rail.appendChild(a);
      return a;
    });
    // single ring that glides to whichever dot is active (Lucky X-style):
    // a soft glow + a spinning conic-gradient ring + a glass inner disc, so the
    // active icon is framed by a slowly-rotating orange halo.
    const indicator = document.createElement('span');
    indicator.className = 'rail-indicator';
    indicator.innerHTML =
      '<span class="ri-glow"></span>' +
      '<span class="ri-clip"><span class="ri-spin"></span></span>' +
      '<span class="ri-inner"></span>';
    rail.appendChild(indicator);
    const moveInd = (dot: HTMLElement) => {
      indicator.style.width = dot.offsetWidth + 'px';
      indicator.style.height = dot.offsetHeight + 'px';
      indicator.style.transform =
        'translate(' + dot.offsetLeft + 'px,' + dot.offsetTop + 'px)';
    };
    dots[0].classList.add('is-active');
    moveInd(dots[0]);
    if (railIO) railIO.disconnect();
    railIO = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            const idx = sections.indexOf(e.target as HTMLElement);
            dots.forEach((d, i) => d.classList.toggle('is-active', i === idx));
            if (dots[idx]) moveInd(dots[idx]);
          }
        });
      },
      { rootMargin: '-45% 0px -45% 0px', threshold: 0 }
    );
    sections.forEach((s) => railIO!.observe(s));
  }
  document.addEventListener('astro:page-load', buildRail);

  // ---- Keep the menu's active link in sync (persisted menu) ----
  function syncMenu() {
    const n = (p: string) => (p !== '/' && p.endsWith('/') ? p.slice(0, -1) : p);
    const here = n(location.pathname);
    document.querySelectorAll<HTMLAnchorElement>('.menu-link[href]').forEach((a) => {
      const href = n(new URL(a.href).pathname);
      const active = href === '/' ? here === '/' : here === href || here.startsWith(href + '/');
      a.classList.toggle('is-active', active);
    });
  }
  document.addEventListener('astro:page-load', syncMenu);
</script>

<style>
  /* the persisted wrapper itself takes no space; its children are fixed */
  .chrome {
    display: contents;
  }

  /* brand mark, top-left */
  .brand {
    position: fixed;
    top: clamp(0.85rem, 0.6rem + 1vw, 1.25rem);
    left: clamp(0.9rem, 0.6rem + 1.5vw, 1.6rem);
    z-index: 90;
  }
  .brand-logo {
    display: block;
    height: clamp(1.9rem, 1.5rem + 1vw, 2.4rem);
    width: auto;
  }
  /* theme-aware transparent monogram: white on dark (default), ink on light */
  .brand-logo--light {
    display: none;
  }
  :root[data-theme='light'] .brand-logo--dark {
    display: none;
  }
  :root[data-theme='light'] .brand-logo--light {
    display: block;
  }

  /* language picker */
  .lang {
    position: relative;
  }
  .lang-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    height: 2.9rem;
    padding: 0 0.7rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    border: 1px solid var(--border-strong);
    box-shadow: var(--shadow);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    color: var(--text);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    transition: transform var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .lang-btn:hover {
    transform: translateY(-1px);
    border-color: var(--accent);
  }
  .lang-globe {
    width: 17px;
    height: 17px;
    color: var(--text-muted);
  }
  .lang-menu {
    position: absolute;
    top: calc(100% + 0.4rem);
    right: 0;
    min-width: 8.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.35rem;
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--surface) 94%, transparent);
    border: 1px solid var(--border-strong);
    box-shadow: var(--shadow-lg);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }
  .lang-menu[hidden] {
    display: none;
  }
  .lang-opt {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.6rem;
    border-radius: var(--radius-sm);
    font-size: var(--step--1);
    color: var(--text);
    transition: background var(--dur) var(--ease), color var(--dur) var(--ease);
  }
  .lang-opt:hover {
    background: var(--accent-soft);
  }
  .lang-opt.is-active {
    color: var(--accent-text);
    font-weight: 700;
  }

  /* top-right control group: theme toggle + hamburger (always visible) */
  .topbar-right {
    position: fixed;
    top: clamp(0.85rem, 0.6rem + 1vw, 1.25rem);
    right: clamp(0.9rem, 0.6rem + 1.5vw, 1.6rem);
    z-index: 92;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .burger {
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    border: 1px solid var(--border-strong);
    box-shadow: var(--shadow);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    transition: transform var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .burger:hover {
    transform: translateY(-1px);
    border-color: var(--accent);
  }
  .burger-lines {
    display: grid;
    gap: 5px;
  }
  .burger-lines span {
    display: block;
    width: 20px;
    height: 2px;
    border-radius: 2px;
    background: var(--text);
    transition: transform var(--dur) var(--ease), opacity var(--dur) var(--ease);
  }
  .burger[aria-expanded='true'] .burger-lines span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .burger[aria-expanded='true'] .burger-lines span:nth-child(2) {
    opacity: 0;
  }
  .burger[aria-expanded='true'] .burger-lines span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* full-screen menu overlay */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 91;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    -webkit-backdrop-filter: blur(16px) saturate(1.2);
    backdrop-filter: blur(16px) saturate(1.2);
    animation: menuIn 0.32s var(--ease-out);
  }
  .menu[hidden] {
    display: none;
  }
  @keyframes menuIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  .menu-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    text-align: center;
    padding: 2rem;
  }
  .menu-link {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-2);
    line-height: 1.25;
    color: var(--text-muted);
    padding: 0.25rem 1rem;
    transition: color var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .menu-link:hover {
    color: var(--text);
    transform: translateY(-1px);
  }
  .menu-link.is-active {
    color: var(--accent-text);
  }
  .menu-cta {
    margin-top: 1.1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--accent);
    color: var(--accent-contrast);
    font-weight: 700;
    padding: 0.8rem 1.5rem;
    border-radius: var(--radius-pill);
    transition: background var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .menu-cta:hover {
    background: var(--accent-hover);
    transform: translateY(-2px);
  }

  /* section scroll-guide, right edge — Lucky X-style glass pill with icons */
  .rail {
    position: fixed;
    top: 50%;
    right: clamp(0.6rem, 0.2rem + 1vw, 1.2rem);
    transform: translateY(-50%);
    z-index: 80;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    padding: 0.4rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    border: 1px solid var(--border-strong);
    box-shadow: var(--shadow-lg);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    backdrop-filter: blur(14px) saturate(1.2);
  }
  .rail[data-empty] {
    display: none;
  }
  /* rail dots are created in client JS, so their styles must be :global
     (Astro scoping only tags server-rendered elements). */
  :global(.rail-dot) {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2.15rem;
    height: 2.15rem;
    border-radius: var(--radius-pill);
    color: var(--text-muted);
    transition: color var(--dur) var(--ease), background var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }
  /* single indicator that glides between dots as the active section changes.
     It slides with a gentle overshoot (Lucky X feel) and frames the active icon
     with a slowly-spinning orange conic-gradient ring + soft glow. */
  :global(.rail-indicator) {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 0;
    border-radius: var(--radius-pill);
    pointer-events: none;
    transition: transform 0.5s var(--ease-bounce), width 0.3s var(--ease),
      height 0.3s var(--ease);
  }
  :global(.rail-indicator .ri-glow) {
    position: absolute;
    inset: -5px;
    border-radius: inherit;
    background: var(--accent);
    opacity: 0.18;
    filter: blur(11px);
  }
  :global(.rail-indicator .ri-clip) {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    overflow: hidden;
  }
  :global(.rail-indicator .ri-spin) {
    position: absolute;
    width: 200%;
    height: 200%;
    top: -50%;
    left: -50%;
    animation: railSpin 4.5s linear infinite;
    background: conic-gradient(
      from 0deg,
      #5c2506 0deg, #8a3a08 18deg, #e8733a 38deg, #ffb079 52deg,
      #e8733a 62deg, #ffd2b4 66deg, #ffffff 68deg, #ffffff 72deg,
      #ffd2b4 74deg, #e8733a 82deg, #a04a0a 110deg, #5c2506 138deg,
      #8a3a08 164deg, #e8733a 184deg, #5c2506 196deg, #8a3a08 216deg,
      #e8733a 238deg, #ffb079 252deg, #e8733a 262deg, #ffd2b4 266deg,
      #ffffff 268deg, #ffffff 272deg, #ffd2b4 274deg, #e8733a 286deg,
      #a04a0a 312deg, #5c2506 340deg, #8a3a08 356deg, #5c2506 360deg
    );
  }
  @keyframes railSpin {
    to {
      transform: rotate(360deg);
    }
  }
  :global(.rail-indicator .ri-inner) {
    position: absolute;
    inset: 2px;
    border-radius: inherit;
    background: color-mix(in srgb, var(--surface) 90%, transparent);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    backdrop-filter: blur(14px) saturate(1.2);
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.rail-indicator .ri-spin) {
      animation: none;
    }
    :global(.rail-indicator) {
      transition: transform var(--dur-mid) var(--ease), width var(--dur) var(--ease),
        height var(--dur) var(--ease);
    }
  }
  :global(.rail-dot svg) {
    width: 18px;
    height: 18px;
  }
  :global(.rail-dot:hover) {
    color: var(--text);
    background: var(--accent-soft);
  }
  /* the ring/fill is drawn by the sliding .rail-indicator; the active dot
     just tints its icon (transparent bg so the indicator shows through). */
  :global(.rail-dot.is-active) {
    color: var(--accent-text);
    background: transparent;
  }
  /* the booking CTA dot: persistently filled so it reads as the click target,
     with a gentle attention pulse. Stays accent even when it's the active
     section (declared after .is-active so it wins). */
  :global(.rail-dot.is-cta) {
    color: var(--accent-contrast);
    background: var(--accent);
    box-shadow: 0 2px 12px -3px var(--ring);
