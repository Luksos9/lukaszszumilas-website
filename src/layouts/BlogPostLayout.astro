---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import TagPill from '../components/TagPill.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { site } from '../data/site';
import '../styles/prose.css';

interface Props {
  post: CollectionEntry<'blog'>;
  readingTime: number;
  prev?: CollectionEntry<'blog'> | null;
  next?: CollectionEntry<'blog'> | null;
}

const { post, readingTime, prev, next } = Astro.props;
const { title, description, pubDate, updatedDate, tags, heroImage, ogImage, canonicalURL } =
  post.data;

const postUrl = canonicalURL ?? new URL(`/blog/${post.id}/`, site.url).href;
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@type': 'Person', name: site.name, url: site.url },
  url: postUrl,
};
---

<BaseLayout
  title={title}
  description={description}
  image={ogImage ?? heroImage}
  article={true}
  publishedTime={pubDate}
  canonical={canonicalURL}
  jsonLd={articleJsonLd}
>
  <article class="post">
    <header class="post-header container container-narrow">
      {tags.length > 0 && (
        <div class="post-tags cluster">
          {tags.map((t) => <TagPill tag={t} href={`/tags/${t}/`} />)}
        </div>
      )}
      <h1 class="post-title display">{title}</h1>
      <p class="post-meta">
        <FormattedDate date={pubDate} />
        <span class="dot">·</span>{readingTime} min read
        {updatedDate && (
          <>
            <span class="dot">·</span>updated <FormattedDate date={updatedDate} />
          </>
        )}
      </p>
    </header>

    {heroImage && (
      <div class="post-hero container">
        <img src={heroImage} alt={title} loading="eager" />
      </div>
    )}

    <div class="post-body container container-narrow">
      <div class="prose">
        <slot />
      </div>
    </div>

    <aside class="post-newsletter container container-narrow">
      <div class="nl-inline">
        <div class="nl-inline-text">
          <p class="eyebrow">Newsletter</p>
          <h2 class="nl-inline-title display">Get the next one in your inbox</h2>
          <p class="muted">{site.newsletterName}. ServiceNow and AI, straight to the point.</p>
        </div>
        <NewsletterForm />
      </div>
    </aside>

    {(prev || next) && (
      <nav class="post-nav container container-narrow" aria-label="More posts">
        {prev ? (
          <a href={`/blog/${prev.id}/`} class="post-nav-link">
            <span class="post-nav-dir">← Older</span>
            <span class="post-nav-title">{prev.data.title}</span>
          </a>
        ) : (
          <span></span>
        )}
        {next ? (
          <a href={`/blog/${next.id}/`} class="post-nav-link post-nav-link--next">
            <span class="post-nav-dir">Newer →</span>
            <span class="post-nav-title">{next.data.title}</span>
          </a>
        ) : (
          <span></span>
        )}
      </nav>
    )}
  </article>
</BaseLayout>

<style>
  .post-header {
    padding-block: clamp(2.5rem, 1.75rem + 3vw, 4.5rem) 0;
  }
  .post-tags {
    margin-bottom: 1rem;
  }
  .post-title {
    font-size: var(--step-4);
    margin-bottom: 0.75rem;
  }
  .post-meta {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-subtle);
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    align-items: center;
  }
  .dot {
    color: var(--border-strong);
  }
  .post-hero {
    margin-top: 2rem;
  }
  .post-hero img {
    width: 100%;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow);
  }
  .post-body {
    padding-block: clamp(1.75rem, 1rem + 2vw, 2.75rem);
  }
  .post-newsletter {
    margin-top: 1rem;
  }
  .nl-inline {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .nl-inline-title {
    font-size: var(--step-2);
    margin: 0.2rem 0 0.4rem;
  }
  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 2.5rem;
  }
  .post-nav-link {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color var(--dur), transform var(--dur);
  }
  .post-nav-link:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .post-nav-link--next {
    text-align: right;
  }
  .post-nav-dir {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--accent);
    font-weight: 700;
  }
  .post-nav-title {
    font-weight: 600;
    font-size: var(--step--1);
    color: var(--text);
  }
  @media (min-width: 640px) {
    .nl-inline {
      grid-template-columns: 1fr auto;
      align-items: center;
    }
  }
</style>
