---
// Tiny inline-SVG flag for the language picker. Inline SVG (not emoji) so it
// renders identically on every OS, including Windows. Rounded via the wrapper's
// overflow, so no clip-paths / id collisions.
interface Props {
  code: string;
  class?: string;
}
const { code, class: cls = '' } = Astro.props;
---

<span class:list={['flag', cls]} aria-hidden="true">
  {code === 'pl' ? (
    <svg viewBox="0 0 20 14" preserveAspectRatio="none">
      <rect width="20" height="7" fill="#ffffff" />
      <rect y="7" width="20" height="7" fill="#dc143c" />
    </svg>
  ) : (
    <svg viewBox="0 0 20 14" preserveAspectRatio="none">
      <rect width="20" height="14" fill="#012169" />
      <path d="M0 0 20 14 M20 0 0 14" stroke="#ffffff" stroke-width="3" />
      <path d="M0 0 20 14 M20 0 0 14" stroke="#c8102e" stroke-width="1.6" />
      <path d="M10 0 V14 M0 7 H20" stroke="#ffffff" stroke-width="4.6" />
      <path d="M10 0 V14 M0 7 H20" stroke="#c8102e" stroke-width="2.6" />
    </svg>
  )}
</span>

<style>
  .flag {
    display: inline-block;
    width: 20px;
    height: 14px;
    border-radius: 3px;
    overflow: hidden;
    flex: 0 0 auto;
    line-height: 0;
    box-shadow: 0 0 0 1px rgba(128, 128, 128, 0.25);
  }
  .flag svg {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
