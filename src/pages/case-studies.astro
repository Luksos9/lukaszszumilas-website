---
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseStudies from '../components/pages/CaseStudies.astro';
import { useTranslations } from '../i18n/ui';

const lang = 'en' as const;
const t = useTranslations(lang);
---

<BaseLayout
  lang={lang}
  locales={['en', 'pl']}
  title="Case Studies"
  description={t('pages.caseStudies.metaDescription')}
>
  <CaseStudies lang={lang} />
</BaseLayout>
