---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import CtaButton from '../components/CtaButton.astro';
import { services } from '../data/services';
import { site } from '../data/site';
---

<BaseLayout
  title="Services"
  description="ServiceNow and AI consulting: AI opportunity assessments, AI & ServiceNow implementations, platform development, and architecture reviews."
>
  <PageHeader eyebrow="Services" title="How I can help">
    Consulting for teams that run on ServiceNow and want AI that actually ships. From the first
    assessment through implementation, development, and review.
  </PageHeader>

  <Section>
    <div class="services-list">
      {services.map((s) => (
        <article id={s.anchor} class="service">
          <h2 class="service-title display">{s.title}</h2>
          {s.problem && <p class="service-problem">{s.problem}</p>}
          {s.examples && (
            <div>
              <p class="service-label">What it covers</p>
              <ul class="service-items" role="list">
                {s.examples.map((e) => <li>{e}</li>)}
              </ul>
            </div>
          )}
          {s.deliverables && (
            <div>
              <p class="service-label">What you get</p>
              <ul class="service-items" role="list">
                {s.deliverables.map((d) => <li>{d}</li>)}
              </ul>
            </div>
          )}
          {s.outcome && (
            <p class="service-outcome"><strong>Outcome:</strong> {s.outcome}</p>
          )}
        </article>
      ))}
    </div>
  </Section>

  <Section tone="dark">
    <div class="cta-band">
      <h2 class="cta-h2 display">Have a project or a problem worth solving?</h2>
      <p class="cta-lead">
        Tell me what you're working on. I'll tell you honestly whether I'm the right person for it.
      </p>
      <div class="cluster">
        <CtaButton href="/contact/" size="lg">Book a consultation</CtaButton>
        <CtaButton href={site.socials.linkedin} variant="secondary" size="lg" external>Connect on LinkedIn</CtaButton>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .services-list {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 1.5rem + 2.5vw, 3.75rem);
    max-width: 72ch;
  }
  .service {
    scroll-margin-top: 6rem;
  }
  .service-title {
    font-size: var(--step-3);
    margin-bottom: 0.75rem;
  }
  .service-problem {
    color: var(--text-muted);
  }
  .service-label {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.78rem;
    color: var(--text-subtle);
    font-weight: 700;
    margin: 1.25rem 0 0.5rem;
  }
  .service-items {
    display: grid;
    gap: 0.4rem;
    padding-left: 1.2rem;
  }
  .service-items li {
    color: var(--text);
  }
  .service-items li::marker {
    color: var(--accent-text);
  }
  .service-outcome {
    margin-top: 1.25rem;
    padding: 0.85rem 1.1rem;
    background: var(--accent-soft);
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }
  .cta-band {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
    max-width: 46rem;
  }
  .cta-h2 {
    font-size: var(--step-3);
  }
  .cta-lead {
    color: #cfc9be;
    max-width: 52ch;
    line-height: 1.6;
  }
</style>
