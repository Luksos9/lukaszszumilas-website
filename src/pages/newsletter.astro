---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { site } from '../data/site';
---

<BaseLayout title="Newsletter" description="ServiceNow Accelerator: practical ServiceNow and AI in your inbox, from Lukasz Szumilas.">
  <PageHeader eyebrow="Newsletter" title={site.newsletterName}>
    Practical ServiceNow and AI in your inbox. The useful stuff, no fluff.
  </PageHeader>

  <Section>
    <div class="nl-page">
      <ul class="nl-points flow" role="list">
        <li>What governed AI on ServiceNow actually looks like in production.</li>
        <li>Scripting, CMDB and CSDM, and the platform details that matter.</li>
        <li>Certification strategy from someone who's passed 17 of them.</li>
        <li>No spam, no daily noise. Send only when it's worth your time.</li>
      </ul>
      <div class="nl-box">
        <NewsletterForm variant="card" />
        <p class="muted nl-note">Unsubscribe anytime. Your email stays between us.</p>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .nl-page {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
    max-width: 52rem;
  }
  .nl-points {
    line-height: 1.5;
  }
  .nl-points li {
    color: var(--text-muted);
    padding-left: 1.6rem;
    position: relative;
  }
  .nl-points li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 700;
  }
  .nl-box {
    padding: 1.75rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .nl-note {
    margin-top: 0.85rem;
    font-size: var(--step--1);
  }
  @media (min-width: 680px) {
    .nl-page {
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }
  }
</style>
