---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import CtaButton from '../components/CtaButton.astro';
import ServiceCard from '../components/ServiceCard.astro';
import PostCard from '../components/PostCard.astro';
import ClientStrip from '../components/ClientStrip.astro';
import Framework from '../components/Framework.astro';
import AiValueStream from '../components/AiValueStream.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { services } from '../data/services';
import { areas } from '../data/areas';
import { problems } from '../data/problems';
import { caseStudies } from '../data/caseStudies';
import { engagements } from '../data/engagements';
import { snDomains } from '../data/snDomains';
import { whoIWorkWith } from '../data/whoIWorkWith';

// Set true and drop /public/lukasz-cutout.png for the exact cut-out hero.
const HAS_CUTOUT = false;

const credibility = [
  'ServiceNow Instructor',
  'Practical AI & Automation',
  'Enterprise Process Improvement',
  '10,000+ students taught',
];

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: site.name,
    url: site.url,
    jobTitle: 'Operational Efficiency Advisor',
    description: site.description,
    sameAs: [site.socials.linkedin, site.socials.udemy, site.socials.github],
    knowsAbout: ['ServiceNow', 'Workflow automation', 'Process improvement', 'AI Agents', 'Now Assist', 'ITSM'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: 'Lukasz Szumilas — ServiceNow, AI & operational improvement',
    url: site.url,
    description: site.description,
    areaServed: 'Europe',
    serviceType: ['ServiceNow consulting', 'AI implementation', 'Process automation', 'Operational improvement'],
    provider: { '@type': 'Person', name: site.name },
  },
];
---

<BaseLayout jsonLd={jsonLd}>
  <!-- 1. HERO -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-text">
        <p class="eyebrow" data-reveal>Operational Efficiency Advisor</p>
        <h1 class="hero-title display">
          <span data-reveal style="--reveal-delay:80ms">Reduce Manual Work.</span>
          <span data-reveal style="--reveal-delay:200ms">Improve Productivity.</span>
          <span data-reveal style="--reveal-delay:320ms">Scale <span class="accent">Operations.</span></span>
        </h1>
        <p class="hero-lead lead" data-reveal style="--reveal-delay:440ms">
          I help organizations identify bottlenecks, redesign workflows, automate repetitive work,
          and apply AI where it creates measurable business value.
        </p>
        <div class="hero-cta cluster" data-reveal style="--reveal-delay:560ms">
          <CtaButton href="/contact/" size="lg">Book a consultation</CtaButton>
          <CtaButton href="/services/" variant="secondary" size="lg">Explore my approach</CtaButton>
        </div>
        <ul class="cred" role="list" data-reveal style="--reveal-delay:680ms">
          {credibility.map((c) => (
            <li class="cred-item">{c}</li>
          ))}
        </ul>
      </div>

      <div class="hero-photo" data-reveal style="--reveal-delay:240ms">
        <img class="hero-vector" src="/hero-vector.svg" alt="" aria-hidden="true" />
        {HAS_CUTOUT ? (
          <img class="hero-cutout" src="/lukasz-cutout.png" alt="Lukasz Szumilas" width="900" height="1349" fetchpriority="high" />
        ) : (
          <div class="hero-frame">
            <img src="/lukasz.webp" alt="Lukasz Szumilas" width="900" height="1349" fetchpriority="high" />
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- 2. VALUE-PROPS BAR -->
  <div class="valuebar">
    <div class="container valuebar-grid">
      <div class="vp"><span class="vp-icon"><Icon name="trophy" size={20} /></span><span class="vp-title">Measurable results</span></div>
      <div class="vp"><span class="vp-icon"><Icon name="coins" size={20} /></span><span class="vp-title">Lower operational costs</span></div>
      <div class="vp"><span class="vp-icon"><Icon name="clock" size={20} /></span><span class="vp-title">Higher efficiency and capacity</span></div>
      <div class="vp"><span class="vp-icon"><Icon name="smile" size={20} /></span><span class="vp-title">Happier employees and customers</span></div>
      <div class="vp"><span class="vp-icon"><Icon name="chart" size={20} /></span><span class="vp-title">Data-driven improvement</span></div>
    </div>
  </div>

  <!-- 3. WHO I WORK WITH -->
  <Section>
    <div class="who" data-reveal>
      <span class="who-label">Who I work with</span>
      <ul class="who-list" role="list">
        {whoIWorkWith.map((r) => <li>{r}</li>)}
      </ul>
    </div>
  </Section>

  <!-- 4. CONTRARIAN -->
  <Section tone="surface">
    <div class="contrarian">
      <div>
        <p class="eyebrow" data-reveal>The truth about AI</p>
        <h2 class="contrarian-title display">
          <span data-reveal>Most companies don't</span>
          <span data-reveal style="--reveal-delay:140ms">need more AI tools.</span>
        </h2>
        <p class="contrarian-sub" data-reveal style="--reveal-delay:300ms">
          They need better processes, automation, and the right AI use cases.
        </p>
      </div>
      <div class="contrarian-body" data-reveal style="--reveal-delay:200ms">
        <p>
          Most AI projects underwhelm because they start with the model. The results come from
          fixing the work first, in this order:
        </p>
        <ol class="why-order">
          <li>Fix the process.</li>
          <li>Automate the repetitive parts.</li>
          <li>Improve how people find knowledge.</li>
          <li>Then apply AI where it creates real value.</li>
        </ol>
        <p>That's the order I work in with every client.</p>
      </div>
    </div>
  </Section>

  <!-- 5. FRAMEWORK -->
  <Section>
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow">My operational improvement framework</p>
        <h2 class="section-h2 display">A practical path from inefficiency to impact</h2>
      </div>
    </div>
    <Framework />
  </Section>

  <!-- 6. WHERE AI CREATES VALUE -->
  <Section tone="surface">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow">Where AI creates value</p>
        <h2 class="section-h2 display">AI helps at specific points, not everywhere</h2>
      </div>
    </div>
    <AiValueStream />
  </Section>

  <!-- 7. PROBLEMS -->
  <Section>
    <p class="eyebrow" data-reveal>Problems I solve</p>
    <h2 class="section-h2 display" data-reveal>You're probably dealing with at least one of these</h2>
    <div class="grid-3">
      {problems.map((p, i) => (
        <article class="card" data-reveal style={`--reveal-delay:${i * 80}ms`}>
          <span class="card-icon"><Icon name={p.icon} /></span>
          <h3 class="card-title">{p.title}</h3>
          <p class="muted">{p.body}</p>
        </article>
      ))}
    </div>
  </Section>

  <!-- 8. CAPABILITIES -->
  <Section tone="surface">
    <p class="eyebrow" data-reveal>What I do</p>
    <h2 class="section-h2 display" data-reveal>Capabilities, framed by outcome</h2>
    <div class="grid-4">
      {areas.map((a, i) => (
        <article class="card" data-reveal style={`--reveal-delay:${i * 90}ms`}>
          <span class="card-icon"><Icon name={a.icon} /></span>
          <h3 class="card-title">{a.title}</h3>
          <p class="muted">{a.body}</p>
        </article>
      ))}
    </div>
  </Section>

  <!-- 9. TYPICAL ENGAGEMENTS -->
  <Section>
    <p class="eyebrow" data-reveal>Typical engagements</p>
    <h2 class="section-h2 display" data-reveal>How we'd work together</h2>
    <div class="grid-4">
      {engagements.map((e, i) => {
        const Tag = e.href ? 'a' : 'div';
        return (
          <Tag href={e.href} class="eng" data-reveal style={`--reveal-delay:${i * 80}ms`}>
            {e.duration && <span class="eng-duration">{e.duration}</span>}
            <h3 class="card-title">{e.title}</h3>
            <p class="muted">{e.body}</p>
            {e.href && <span class="eng-cta">Learn more →</span>}
          </Tag>
        );
      })}
    </div>
  </Section>

  <!-- 10. SERVICENOW EXPERTISE -->
  <Section tone="surface">
    <p class="eyebrow" data-reveal>ServiceNow expertise</p>
    <h2 class="section-h2 display" data-reveal>Where I work on the platform</h2>
    <ul class="chips" role="list" data-reveal>
      {snDomains.map((d) => <li class="chip">{d}</li>)}
    </ul>
  </Section>

  <!-- 11. INDUSTRY EXPERIENCE -->
  <Section>
    <p class="eyebrow" data-reveal>Industry experience</p>
    <h2 class="section-h2 display" data-reveal>Enterprise environments</h2>
    <ClientStrip />
  </Section>

  <!-- 12. CASE STUDIES -->
  <Section tone="surface">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow">Selected work</p>
        <h2 class="section-h2 display">Real impact in the enterprise</h2>
      </div>
      <a href="/case-studies/" class="see-all">All case studies →</a>
    </div>
    <div class="grid-3">
      {caseStudies.map((c, i) => (
        <a href="/case-studies/" class="case" data-reveal style={`--reveal-delay:${i * 90}ms`}>
          <span class="case-sector">{c.sector}</span>
          <h3 class="case-title">{c.title}</h3>
          <p class="case-summary">{c.outcome}</p>
          <span class="case-cta">Read case study →</span>
        </a>
      ))}
    </div>
    <p class="muted case-note">Anonymized. Specifics shared under NDA on a call.</p>
  </Section>

  <!-- 13. INSIGHTS -->
  <Section>
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow">Latest insights</p>
        <h2 class="section-h2 display">Practical writing on ServiceNow &amp; AI</h2>
      </div>
      <a href="/blog/" class="see-all">All articles →</a>
    </div>
    {posts.length > 0 ? (
      <div class="grid-3">
        {posts.map((post, i) => (
          <div data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <PostCard post={post} />
          </div>
        ))}
      </div>
    ) : (
      <p class="muted">New articles are landing soon.</p>
    )}
  </Section>

  <!-- 14. FINAL CTA -->
  <section class="final-cta">
    <div class="container final-cta-inner" data-reveal>
      <div>
        <h2 class="final-cta-title display">Let's discuss your next ServiceNow or AI initiative</h2>
        <p class="final-cta-sub">
          Book a free consultation call and we'll find where a better process and the right AI
          actually move the needle for you.
        </p>
      </div>
      <CtaButton href="/contact/" size="lg">Book a consultation</CtaButton>
    </div>
  </section>
</BaseLayout>

<style>
  /* HERO */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem) clamp(1.5rem, 1rem + 2vw, 3rem);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }
  .hero-title {
    font-size: var(--step-5);
    margin-bottom: 1.1rem;
    line-height: 1.04;
  }
  .hero-title span {
    display: block;
  }
  .hero-title .accent {
    display: inline;
    color: var(--accent);
  }
  .hero-lead {
    max-width: 52ch;
    margin-bottom: 1.9rem;
  }
  .cred {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 1.9rem;
  }
  .cred-item {
    position: relative;
    padding-left: 1rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .cred-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }
  .hero-photo {
    position: relative;
    justify-self: center;
    width: 100%;
    max-width: 26rem;
  }
  .hero-vector {
    position: absolute;
    inset: -6% -16% -2% -16%;
    width: 132%;
    height: auto;
    z-index: 0;
    opacity: 0.7;
    pointer-events: none;
  }
  .hero-frame {
    position: relative;
    z-index: 1;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border-strong);
    box-shadow: var(--shadow-lg);
  }
  .hero-frame img,
  .hero-cutout {
    width: 100%;
    display: block;
  }
  .hero-frame::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 34%;
    background: linear-gradient(transparent, color-mix(in srgb, var(--bg) 88%, transparent));
  }
  .hero-cutout {
    position: relative;
    z-index: 1;
    filter: drop-shadow(0 18px 40px rgba(0, 0, 0, 0.5));
  }
  /* VALUE BAR */
  .valuebar {
    border-block: 1px solid var(--border);
    background: var(--surface);
  }
  .valuebar-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem 1.5rem;
    padding-block: 1.5rem;
  }
  .vp {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  .vp-icon {
    display: inline-grid;
    place-items: center;
    flex: 0 0 auto;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: var(--radius-sm);
    background: var(--accent-soft);
    color: var(--accent);
  }
  .vp-title {
    font-size: var(--step--1);
    color: var(--text-muted);
    line-height: 1.3;
  }
  /* WHO */
  .who {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }
  .who-label {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.72rem;
    color: var(--text-subtle);
    font-weight: 700;
  }
  .who-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
  }
  .who-list li {
    font-weight: 600;
    color: var(--text);
  }
  .who-list li:not(:last-child)::after {
    content: '·';
    margin-left: 0.75rem;
    color: var(--text-subtle);
  }
  /* CONTRARIAN */
  .contrarian {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  .contrarian-title {
    font-size: var(--step-4);
    line-height: 1.05;
  }
  .contrarian-title span {
    display: block;
  }
  .contrarian-sub {
    margin-top: 1rem;
    font-size: var(--step-1);
    font-weight: 600;
    color: var(--accent);
    max-width: 28ch;
  }
  .contrarian-body p {
    color: var(--text-muted);
    line-height: 1.7;
  }
  .why-order {
    margin: 1rem 0;
    padding-left: 1.3rem;
    display: grid;
    gap: 0.4rem;
    color: var(--text);
  }
  .why-order li::marker {
    color: var(--accent);
    font-family: var(--font-mono);
  }
  /* SHARED */
  .section-h2 {
    font-size: var(--step-3);
    margin-bottom: 1.5rem;
  }
  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.75rem;
  }
  .section-head .section-h2 {
    margin-bottom: 0;
  }
  .see-all {
    font-weight: 600;
    color: var(--accent);
    white-space: nowrap;
  }
  .see-all:hover {
    color: var(--accent-hover);
  }
  .grid-3,
  .grid-4 {
    display: grid;
    gap: clamp(1rem, 0.5rem + 1.5vw, 1.5rem);
    grid-template-columns: 1fr;
  }
  .card,
  .eng {
    padding: 1.5rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    height: 100%;
    transition: transform var(--dur) var(--ease), border-color var(--dur), box-shadow var(--dur);
  }
  .card:hover,
  a.eng:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
    box-shadow: var(--shadow);
  }
  .card-icon {
    display: inline-grid;
    place-items: center;
    width: 2.7rem;
    height: 2.7rem;
    border-radius: var(--radius);
    background: var(--accent-soft);
    color: var(--accent);
    margin-bottom: 0.75rem;
  }
  .card-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-1);
    margin-bottom: 0.4rem;
  }
  .eng {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .eng-duration {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--accent);
    background: var(--accent-soft);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-pill);
  }
  .eng .muted {
    flex: 1 0 auto;
  }
  .eng-cta {
    font-weight: 600;
    color: var(--accent);
    font-size: var(--step--1);
  }
  /* CHIPS */
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 0.7rem;
  }
  .chip {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: var(--step--1);
    color: var(--text);
    border: 1px solid var(--border-strong);
    background: var(--card);
    padding: 0.5rem 0.95rem;
    border-radius: var(--radius-pill);
  }
  /* CASE STUDIES */
  .case {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
    padding: 1.5rem;
    background: var(--card);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    transition: transform var(--dur) var(--ease), box-shadow var(--dur), border-color var(--dur);
  }
  .case:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--accent);
  }
  .case-summary {
    color: var(--text-muted);
    font-size: var(--step--1);
    flex: 1 0 auto;
  }
  .case-sector {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: var(--step--1);
    color: var(--accent);
    font-weight: 700;
  }
  .case-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-1);
  }
  .case-cta {
    font-weight: 600;
    color: var(--accent);
    font-size: var(--step--1);
  }
  .case-note {
    margin-top: 1.25rem;
    font-size: var(--step--1);
  }
  /* FINAL CTA (clean, no glow) */
  .final-cta {
    background: var(--lx-dark);
    color: var(--lx-cream);
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
    margin-top: var(--section-y);
    border-top: 1px solid var(--border);
  }
  .final-cta-inner {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
  }
  .final-cta-title {
    font-size: var(--step-3);
    max-width: 22ch;
  }
  .final-cta-sub {
    margin-top: 0.6rem;
    max-width: 50ch;
    color: #cfc9be;
  }
  @media (min-width: 560px) {
    .grid-3,
    .grid-4 {
      grid-template-columns: repeat(2, 1fr);
    }
    .valuebar-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 760px) {
    .contrarian {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }
  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: 1.35fr 1fr;
    }
    .grid-3 {
      grid-template-columns: repeat(3, 1fr);
    }
    .grid-4 {
      grid-template-columns: repeat(4, 1fr);
    }
    .valuebar-grid {
      grid-template-columns: repeat(5, 1fr);
    }
    .final-cta-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
