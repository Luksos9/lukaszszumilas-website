---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import CtaButton from '../components/CtaButton.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

const pillars = [
  {
    icon: 'cube',
    title: 'ServiceNow depth',
    body: '4+ years across banking, insurance and manufacturing — ITSM, Service Portal and Employee Center, workflow automation and integrations built to survive a security review.',
  },
  {
    icon: 'sparkle',
    title: 'AI that ships',
    body: 'Process first, AI second. MCP and Now Assist done with real governance — and I’m in the Anthropic Claude Partner Network on the consulting track.',
  },
  {
    icon: 'shield',
    title: 'Governance built in',
    body: 'GDPR- and EU AI Act-aware by default. AI you can put in front of an auditor, not just a slide — the part most “AI projects” skip.',
  },
];
const creds = ['10,000+ students taught', '4+ years on ServiceNow', 'Banking · Insurance · Manufacturing'];
---

<BaseLayout
  title="About"
  description="Lukasz Szumilas helps organizations reduce manual work and improve operations with ServiceNow, AI, and process design."
>
  <PageHeader eyebrow="About" title="Lukasz Szumilas">
    Operational Efficiency Advisor. I help organizations reduce manual work and improve how they
    run, using ServiceNow, AI, and process design.
  </PageHeader>

  <Section>
   <div class="about-intro">
    <div class="page-body flow">
      <p>
        I'm a self-taught generalist who learned to build, automate, write, and teach by refusing
        to outsource my own education. ServiceNow is where that curiosity turned into a career.
      </p>
      <p>
        For 4+ years I've worked on ServiceNow in banking, insurance, and manufacturing: ITSM,
        Service Portal and Employee Center, workflow automation, and integrations. Demanding
        environments where a build has to hold up to a security review. That shaped how I think
        about operations, and about AI.
      </p>
      <p>
        The thing I'm actually good at is making complicated things simple. It's what made my
        courses work, with more than 10,000 students on Udemy through <a href="/teaching/">Lucky X</a>,
        and it's what enterprises pay for: someone who can look at a tangle of process and tools and
        explain the path to less manual work.
      </p>
      <p>
        My bias is process first, AI second. The biggest wins usually come from fixing the
        workflow and automating the repetitive parts, then applying AI where it creates measurable
        value. Most "AI projects" skip that first step. I don't.
      </p>
    </div>
    <div class="about-photo" data-reveal="scale" style="--reveal-delay:120ms">
      <img src="/lukasz-cutout.webp" alt="Lukasz Szumilas" width="900" height="1349" loading="eager" />
    </div>
   </div>
  </Section>

  <Section tone="surface">
    <div class="about-head" data-reveal>
      <p class="eyebrow">What makes me different</p>
      <h2 class="section-h2 display">ServiceNow depth × AI × governance</h2>
    </div>
    <div class="pillars">
      {pillars.map((p, i) => (
        <article class="pillar" data-reveal="scale" style={`--reveal-delay:${i * 80}ms`}>
          <span class="pillar-icon"><Icon name={p.icon} size={22} /></span>
          <h3 class="pillar-title">{p.title}</h3>
          <p class="muted">{p.body}</p>
        </article>
      ))}
    </div>
    <ul class="cred-row" data-reveal>
      {creds.map((c) => <li>{c}</li>)}
    </ul>
  </Section>

  <Section>
    <p class="eyebrow">How I think</p>
    <h2 class="section-h2 display">I work in diagrams, not walls of text</h2>
    <div class="page-body flow">
      <p>
        Process maps, value streams, and AI opportunity maps. When I explain where work gets stuck
        or where AI actually helps, I draw it. That clarity is the same thing that makes a project
        land: everyone can see the plan before we build it.
      </p>
    </div>
  </Section>

  <Section tone="surface">
    <div class="two-col">
      <div>
        <p class="eyebrow">What I do</p>
        <ul class="do-list flow" role="list">
          <li><strong>Consulting.</strong> Operational improvement with ServiceNow, AI, and process design.</li>
          <li><strong>Teaching.</strong> Lucky X certification courses on Udemy, 10,000+ students.</li>
          <li><strong>Writing.</strong> ServiceNow and AI on the platform, here and on LinkedIn.</li>
        </ul>
      </div>
      <div>
        <p class="eyebrow">Languages</p>
        <ul class="do-list flow" role="list">
          <li>Polish, native</li>
          <li>English, C2</li>
          <li>German, B1</li>
        </ul>
        <div class="cv-cta">
          <CtaButton href={site.socials.linkedin} variant="secondary" external>Full background on LinkedIn</CtaButton>
        </div>
      </div>
    </div>
  </Section>

  <Section tone="dark">
    <div class="cta-band">
      <h2 class="section-h2 display">Want to work together?</h2>
      <div class="cluster">
        <CtaButton href="/contact/">Book a consultation</CtaButton>
        <CtaButton href="/services/" variant="secondary">See the services</CtaButton>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .page-body {
    max-width: var(--maxw-prose);
    font-size: var(--step-0);
    line-height: 1.75;
  }
  .page-body a {
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .about-intro {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    align-items: start;
  }
  .about-photo {
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: radial-gradient(120% 70% at 50% 0%, var(--accent-soft), transparent 70%), var(--surface);
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    max-width: 20rem;
    margin: 0 auto;
  }
  .about-photo img {
    display: block;
    width: 100%;
    height: auto;
  }
  @media (min-width: 820px) {
    .about-intro {
      grid-template-columns: 1.5fr 1fr;
    }
    .about-photo {
      margin: 0;
    }
  }
  .section-h2 {
    font-size: var(--step-3);
    margin-bottom: 1.25rem;
  }
  .about-head {
    margin-bottom: clamp(1.5rem, 1rem + 2vw, 2.25rem);
  }
  .about-head .section-h2 {
    margin-bottom: 0;
  }
  .pillars {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  .pillar {
    padding: clamp(1.3rem, 1rem + 1vw, 1.75rem);
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }
  .pillar-icon {
    display: inline-grid;
    place-items: center;
    width: 2.7rem;
    height: 2.7rem;
    border-radius: var(--radius);
    background: var(--accent-soft);
    color: var(--accent-text);
    margin-bottom: 0.7rem;
  }
  .pillar-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-1);
    margin-bottom: 0.4rem;
  }
  .cred-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
    padding: 0;
    list-style: none;
  }
  .cred-row li {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text);
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
  }
  .two-col {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
  }
  .do-list {
    line-height: 1.5;
  }
  .do-list li {
    color: var(--text-muted);
  }
  .cv-cta {
    margin-top: 1.5rem;
  }
  .cta-band {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: flex-start;
  }
  @media (min-width: 720px) {
    .two-col {
      grid-template-columns: 1fr 1fr;
    }
    .pillars {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
