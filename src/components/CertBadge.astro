---
interface Props {
  code: string;
  name?: string;
}
const { code, name } = Astro.props;
---

<div class="cert-badge">
  <span class="cert-code">{code}</span>
  {name && <span class="cert-name">{name}</span>}
</div>

<style>
  .cert-badge {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.85rem 1rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .cert-code {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--accent);
    font-size: var(--step-0);
  }
  .cert-name {
    font-size: var(--step--1);
    color: var(--text-muted);
    line-height: 1.35;
  }
</style>
