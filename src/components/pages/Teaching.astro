---
import PageHeader from '../PageHeader.astro';
import Section from '../Section.astro';
import StatBadge from '../StatBadge.astro';
import CourseCard from '../CourseCard.astro';
import CtaButton from '../CtaButton.astro';
import { site } from '../../data/site';
import { teachingStats } from '../../data/courses';
import { getFeaturedCourses } from '../../i18n/data';
import { useTranslations, defaultLang, type Lang } from '../../i18n/ui';

interface Props {
  lang?: Lang;
}
const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const k = (s: string) => t(`pages.teaching.${s}`);
const featuredCourses = getFeaturedCourses(lang);
---

<PageHeader eyebrow={k('eyebrow')} title="Lucky X">
  {k('lead')}
</PageHeader>

<Section>
  <div class="page-body flow">
    <p>{k('p1')}</p>
    <p>{k('p2')}</p>
    <p>{k('p3')}</p>
  </div>

  <div class="teaching-stats">
    <StatBadge value={teachingStats.students} label={k('statStudents')} />
    <StatBadge value={`${teachingStats.rating}★`} label={k('statRating')} />
    <StatBadge value={teachingStats.courses} label={k('statCourses')} />
    <StatBadge value={teachingStats.questions} label={k('statQuestions')} />
  </div>
</Section>

<Section tone="surface">
  <p class="eyebrow">{k('popularEyebrow')}</p>
  <h2 class="section-h2 display">{k('popularTitle')}</h2>
  <div class="grid-courses">
    {featuredCourses.map((c) => (
      <CourseCard code={c.code} title={c.title} url={c.url}>{c.blurb}</CourseCard>
    ))}
  </div>
  <p class="muted catalog-note">{k('catalogNote')}</p>
  <div class="cluster teaching-cta">
    <CtaButton href={site.socials.luckyx} size="lg" external>{k('ctaLuckyx')}</CtaButton>
    <CtaButton href={site.socials.udemy} variant="secondary" size="lg" external>{k('ctaUdemy')}</CtaButton>
  </div>
</Section>

<style>
  .page-body {
    max-width: var(--maxw-prose);
    font-size: var(--step-0);
    line-height: 1.75;
    margin-bottom: 2.5rem;
  }
  .section-h2 {
    font-size: var(--step-3);
    margin-bottom: 1.5rem;
  }
  .teaching-stats {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.25rem, 0.5rem + 3vw, 3rem);
  }
  .grid-courses {
    display: grid;
    gap: clamp(1rem, 0.5rem + 1.5vw, 1.5rem);
    grid-template-columns: 1fr;
  }
  .catalog-note {
    margin-top: 1.25rem;
    font-size: var(--step--1);
  }
  .teaching-cta {
    margin-top: 1.75rem;
  }
  @media (min-width: 640px) {
    .grid-courses {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
