---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { title, description, pubDate, tags } = post.data;
const href = `/blog/${post.id}/`;
const primaryTag = tags[0];
---

<article class="post-card">
  <a href={href} class="post-card-link shine">
    {primaryTag && <span class="post-card-tag">{primaryTag}</span>}
    <h3 class="post-card-title">{title}</h3>
    <p class="post-card-desc">{description}</p>
    <div class="post-card-meta">
      <FormattedDate date={pubDate} />
    </div>
  </a>
</article>

<style>
  .post-card {
    height: 100%;
  }
  .post-card-link {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
    padding: 1.4rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: transform var(--dur-mid) var(--ease-out), box-shadow var(--dur-mid),
      border-color var(--dur-mid);
  }
  .post-card-link:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--accent);
  }
  .post-card-link > * {
    position: relative;
    z-index: 2;
  }
  .post-card-tag {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 700;
    text-transform: lowercase;
    color: var(--accent);
  }
  .post-card-title {
    font-size: var(--step-1);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  .post-card-desc {
    color: var(--text-muted);
    font-size: var(--step--1);
    flex: 1 0 auto;
  }
  .post-card-meta {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-subtle);
  }
</style>
