---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import { site } from '../data/site';

const calendly = site.booking.calendly;
---

<BaseLayout
  title="Book a consultation"
  description="Book a ServiceNow or AI consultation with Lukasz Szumilas, or reach out about a project, workshop, or review."
>
  <PageHeader eyebrow="Contact" title="Book a consultation">
    Consulting, a second opinion on a ServiceNow or AI plan, a workshop, or a quick question. Pick
    whichever is easiest.
  </PageHeader>

  <Section>
    {calendly ? (
      <div class="booking">
        <div class="calendly-inline-widget" data-url={calendly} style="min-width:320px;height:680px;"></div>
        <script is:inline async src="https://assets.calendly.com/assets/external/widget.js"></script>
      </div>
    ) : (
      <p class="muted booking-note">
        Direct online booking is being set up. For now, email me or message me on LinkedIn and we'll
        find a time that works.
      </p>
    )}

    <div class="contact-grid">
      <a class="contact-card" href={`mailto:${site.email}`}>
        <span class="contact-eyebrow">Email</span>
        <span class="contact-value">{site.email}</span>
        <span class="contact-hint muted">Best for project enquiries and detailed questions.</span>
      </a>
      <a class="contact-card" href={site.socials.linkedin} target="_blank" rel="noopener noreferrer">
        <span class="contact-eyebrow">LinkedIn</span>
        <span class="contact-value">Connect or message <span aria-hidden="true">↗</span></span>
        <span class="contact-hint muted">Where I'm most active. Good for a quick hello.</span>
      </a>
    </div>

    <p class="muted contact-note">
      For course support and student questions, use the Q&amp;A on the relevant
      <a href={site.socials.udemy} target="_blank" rel="noopener noreferrer">Udemy course</a> so the
      answer helps everyone.
    </p>
  </Section>
</BaseLayout>

<style>
  .booking {
    margin-bottom: 2.5rem;
  }
  .booking-note {
    margin-bottom: 2rem;
    max-width: 60ch;
  }
  .contact-grid {
    display: grid;
    gap: clamp(1rem, 0.5rem + 1.5vw, 1.5rem);
    grid-template-columns: 1fr;
    max-width: 48rem;
  }
  .contact-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.75rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition: transform var(--dur) var(--ease), border-color var(--dur), box-shadow var(--dur);
  }
  .contact-card:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
    box-shadow: var(--shadow);
  }
  .contact-eyebrow {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: var(--step--1);
    color: var(--accent);
    font-weight: 700;
  }
  .contact-value {
    font-size: var(--step-1);
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .contact-hint {
    font-size: var(--step--1);
  }
  .contact-note {
    margin-top: 1.75rem;
    font-size: var(--step--1);
    max-width: 60ch;
  }
  .contact-note a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  @media (min-width: 600px) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
