---
import { framework } from '../data/framework';
// 5 fixed positions on a circle (radius 40% of the box), starting at top, clockwise.
const positions = [
  { x: 50, y: 9 },
  { x: 88, y: 38 },
  { x: 73, y: 83 },
  { x: 27, y: 83 },
  { x: 12, y: 38 },
];
---

<div class="loop" data-reveal>
  <svg class="loop-ring" viewBox="0 0 100 100" aria-hidden="true">
    <circle class="ring-bg" cx="50" cy="50" r="40" />
    <circle class="ring" cx="50" cy="50" r="40" />
  </svg>
  <div class="loop-center">
    <div class="lc-state lc-state--default is-shown">
      <span class="lc-eyebrow">The loop</span>
      <span class="lc-title">Operations<br />Improvement</span>
    </div>
    {framework.map((s, i) => (
      <div class="lc-state" data-state={i}>
        <span class="lc-eyebrow">Step {s.n}</span>
        <span class="lc-title lc-title--sm">{s.title}</span>
        <span class="lc-body">{s.body}</span>
      </div>
    ))}
  </div>
  {framework.map((s, i) => (
    <button
      type="button"
      class="loop-node"
      data-state={i}
      aria-label={`Step ${s.n}: ${s.title}. ${s.body}`}
      style={`left:${positions[i].x}%;top:${positions[i].y}%;--i:${i}`}
    >
      <span class="ln-num">{s.n}</span>
      <span class="ln-title">{s.title}</span>
    </button>
  ))}
</div>

<script>
  // Hover/focus/tap a step -> its detail morphs into the loop's center.
  // Hover previews; click/tap pins it (toggle); works on touch + keyboard.
  function initLoop() {
    document.querySelectorAll('.loop').forEach((loop) => {
      const states = loop.querySelectorAll('.lc-state');
      const nodes = loop.querySelectorAll('.loop-node');
      if (!nodes.length) return;
      let pinned = -1;
      const show = (idx: number) => {
        states.forEach((s) => {
          const on =
            idx < 0
              ? s.classList.contains('lc-state--default')
              : s.getAttribute('data-state') === String(idx);
          s.classList.toggle('is-shown', on);
        });
      };
      nodes.forEach((node, i) => {
        node.addEventListener('mouseenter', () => show(i));
        node.addEventListener('mouseleave', () => show(pinned));
        node.addEventListener('focus', () => show(i));
        node.addEventListener('blur', () => show(pinned));
        node.addEventListener('click', () => {
          pinned = pinned === i ? -1 : i;
          show(pinned);
        });
      });
    });
  }
  document.addEventListener('astro:page-load', initLoop);
</script>

<style>
  .loop {
    position: relative;
    width: min(30rem, 92vw);
    aspect-ratio: 1;
    margin: 1.5rem auto 0;
  }
  .loop-ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
    overflow: visible;
  }
  .ring-bg {
    fill: none;
    stroke: var(--border-strong);
    stroke-width: 0.6;
  }
  .ring {
    fill: none;
    stroke: var(--accent);
    stroke-width: 0.8;
    stroke-linecap: round;
    stroke-dasharray: 251.2;
    stroke-dashoffset: 251.2;
  }
  .loop.is-visible .ring {
    animation: draw 1.5s var(--ease) 0.25s forwards;
  }
  @keyframes draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  .loop-center {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 50%;
    height: 50%;
    border-radius: var(--radius-pill);
    text-align: center;
    background: var(--card);
    border: 1px solid var(--border);
    overflow: hidden;
  }
  /* each step's detail cross-fades into the center on hover / focus / tap */
  .lc-state {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    padding: clamp(0.6rem, 0.2rem + 2vw, 1.4rem);
    opacity: 0;
    transform: scale(0.94);
    transition: opacity 0.32s var(--ease), transform 0.32s var(--ease);
    pointer-events: none;
  }
  .lc-state.is-shown {
    opacity: 1;
    transform: none;
  }
  .lc-eyebrow {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.62rem;
    color: var(--accent-text);
    font-weight: 700;
  }
  .lc-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(0.95rem, 0.6rem + 1.4vw, 1.3rem);
    line-height: 1.1;
    color: var(--text);
  }
  .lc-title--sm {
    font-size: clamp(0.9rem, 0.6rem + 1vw, 1.1rem);
    line-height: 1.15;
  }
  .lc-body {
    font-size: clamp(0.68rem, 0.5rem + 0.6vw, 0.82rem);
    line-height: 1.35;
    color: var(--text-muted);
    max-width: 94%;
  }
  .loop-node {
    position: absolute;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    width: 8rem;
    padding: 0;
    text-align: center;
    cursor: pointer;
  }
  .loop-node:hover .ln-num,
  .loop-node:focus-visible .ln-num {
    box-shadow: 0 0 0 4px var(--accent-soft);
  }
  .loop-node:hover .ln-title,
  .loop-node:focus-visible .ln-title {
    color: var(--accent-text);
  }
  .ln-num {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-pill);
    background: var(--accent);
    color: var(--accent-contrast);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.8rem;
    transition: box-shadow var(--dur) var(--ease);
  }
  .ln-title {
    font-weight: 600;
    font-size: var(--step--1);
    color: var(--text);
    line-height: 1.2;
    transition: color var(--dur) var(--ease);
  }
  /* keep the circular layout's side nodes inside small viewports */
  @media (max-width: 480px) {
    .loop {
      width: min(30rem, 86vw);
    }
    .loop-node {
      width: 6.4rem;
    }
    .ln-title {
      font-size: 0.7rem;
    }
  }
  /* nodes pop in sequentially as the ring draws */
  .js .loop-node {
    opacity: 0;
  }
  .loop.is-visible .loop-node {
    animation: nodeIn 0.5s var(--ease-out) forwards;
    animation-delay: calc(0.3s + var(--i) * 0.13s);
  }
  @keyframes nodeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  .js .loop-node .ln-num {
    transform: scale(0.5);
  }
  .loop.is-visible .loop-node .ln-num {
    animation: numPop 0.5s var(--ease-spring) forwards;
    animation-delay: calc(0.34s + var(--i) * 0.13s);
  }
  @keyframes numPop {
    from {
      transform: scale(0.5);
    }
    to {
      transform: scale(1);
    }
  }
  .loop.is-visible .loop-center {
    animation: hubPulse 3s var(--ease) 1.5s 2;
  }
  @keyframes hubPulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
    50% {
      box-shadow: 0 0 0 7px var(--accent-soft);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ring {
      stroke-dashoffset: 0;
    }
    .loop.is-visible .ring,
    .loop.is-visible .loop-node,
    .loop.is-visible .loop-node .ln-num,
    .loop.is-visible .loop-center {
      animation: none;
    }
    .js .loop-node {
      opacity: 1;
    }
    .js .loop-node .ln-num {
      transform: none;
    }
  }
</style>
