---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import CtaButton from '../components/CtaButton.astro';
import PostCard from '../components/PostCard.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Icon from '../components/Icon.astro';
import OperationsLoop from '../components/OperationsLoop.astro';
import AiOperatingSystem from '../components/AiOperatingSystem.astro';
import OpportunityMatrix from '../components/OpportunityMatrix.astro';
import { site } from '../data/site';
import { services } from '../data/services';
import { problems } from '../data/problems';
import { caseStudies } from '../data/caseStudies';

const HAS_CUTOUT = true;

const allocation = [
  { pct: 40, label: 'AI + ServiceNow' },
  { pct: 25, label: 'Workflow Automation' },
  { pct: 20, label: 'Architecture & Strategy' },
  { pct: 10, label: 'Training' },
  { pct: 5, label: 'Research' },
];
const proof = [
  'ServiceNow Instructor',
  '10,000+ students taught',
  '4+ years enterprise experience',
  'Speaker & content creator',
];

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: site.name,
    url: site.url,
    jobTitle: 'Operational Efficiency Advisor',
    description: site.description,
    sameAs: [site.socials.linkedin, site.socials.udemy, site.socials.github],
    knowsAbout: ['ServiceNow', 'Workflow automation', 'Process improvement', 'AI Agents', 'Now Assist', 'ITSM'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: 'Lukasz Szumilas — ServiceNow, AI & operational improvement',
    url: site.url,
    description: site.description,
    areaServed: 'Europe',
    serviceType: ['ServiceNow consulting', 'AI implementation', 'Process automation', 'Operational improvement'],
    provider: { '@type': 'Person', name: site.name },
  },
];
---

<BaseLayout jsonLd={jsonLd}>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-text">
        <p class="eyebrow" data-reveal>Operational Efficiency Advisor</p>
        <h1 class="hero-title display">
          <span data-reveal style="--reveal-delay:80ms">Reduce Manual Work.</span>
          <span data-reveal style="--reveal-delay:200ms">Improve Productivity.</span>
          <span data-reveal style="--reveal-delay:320ms">Scale <span class="accent">Operations.</span></span>
        </h1>
        <p class="hero-lead lead" data-reveal style="--reveal-delay:440ms">
          I help organizations <span class="mark">get more done with less manual work</span>, using
          ServiceNow, AI, and process design.
        </p>
        <div class="hero-cta cluster" data-reveal style="--reveal-delay:560ms">
          <CtaButton href="/contact/" size="lg">Book a consultation</CtaButton>
          <CtaButton href="/services/" variant="secondary" size="lg">Explore my approach</CtaButton>
        </div>
        <p class="cred" data-reveal style="--reveal-delay:680ms">ServiceNow instructor · 10,000+ students taught</p>
      </div>
      <div class="hero-photo" data-reveal style="--reveal-delay:240ms">
        <img class="hero-vector" src="/hero-vector.svg" alt="" aria-hidden="true" />
        {HAS_CUTOUT ? (
          <img class="hero-cutout" src="/lukasz-cutout.webp" alt="Lukasz Szumilas" width="900" height="1349" fetchpriority="high" />
        ) : (
          <div class="hero-frame">
            <img src="/lukasz.webp" alt="Lukasz Szumilas" width="900" height="1349" fetchpriority="high" />
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- AI REALITY CHECK -->
  <Section tone="surface">
    <div class="contrarian">
      <div>
        <p class="eyebrow" data-reveal>The AI reality check</p>
        <h2 class="contrarian-title display">
          <span data-reveal>Most companies don't</span>
          <span data-reveal style="--reveal-delay:140ms">need more AI tools.</span>
        </h2>
        <p class="contrarian-sub" data-reveal style="--reveal-delay:300ms">
          They need <span class="mark">better processes</span>, automation, and the right AI use cases.
        </p>
      </div>
      <div class="contrarian-body" data-reveal style="--reveal-delay:200ms">
        <p>Most AI projects underwhelm because they start with the model. The results come from fixing the work first, in order:</p>
        <ol class="why-order">
          <li>Fix the process.</li>
          <li>Automate the repetitive parts.</li>
          <li>Improve how people find knowledge.</li>
          <li>Then apply AI where it creates real value.</li>
        </ol>
        <p>That's the order I work in with every client.</p>
      </div>
    </div>
  </Section>

  <!-- SIGNATURE #1: OPERATIONS IMPROVEMENT LOOP -->
  <Section>
    <div class="sig-head" data-reveal>
      <p class="eyebrow">My methodology</p>
      <h2 class="section-h2 display">The Operations Improvement Loop</h2>
      <p class="sig-sub muted">A repeatable system, not a one-off project. Every engagement runs the loop.</p>
    </div>
    <OperationsLoop />
  </Section>

  <!-- SIGNATURE #2: AI OPERATING SYSTEM -->
  <Section tone="surface">
    <div class="sig-head" data-reveal>
      <p class="eyebrow">How AI fits</p>
      <h2 class="section-h2 display">The AI Operating System</h2>
      <p class="sig-sub muted">AI shouldn't sit in isolation. It works on top of your people, systems, knowledge, and processes.</p>
    </div>
    <AiOperatingSystem />
  </Section>

  <!-- WHERE I SPEND MY TIME -->
  <Section>
    <p class="eyebrow" data-reveal>Where I spend my time</p>
    <h2 class="section-h2 display" data-reveal>What I actually do, by the numbers</h2>
    <div class="alloc">
      {allocation.map((a, i) => (
        <div class="alloc-row" data-reveal style={`--reveal-delay:${i * 80}ms;--pct:${a.pct}%`}>
          <span class="alloc-label">{a.label}</span>
          <span class="alloc-pct">{a.pct}%</span>
          <span class="alloc-track"><span class="alloc-fill"></span></span>
        </div>
      ))}
    </div>
  </Section>

  <!-- PROBLEMS -->
  <Section tone="surface">
    <p class="eyebrow" data-reveal>Problems I solve</p>
    <h2 class="section-h2 display" data-reveal>You're probably dealing with at least one of these</h2>
    <div class="grid-3">
      {problems.map((p, i) => (
        <article class="card" data-reveal style={`--reveal-delay:${i * 80}ms`}>
          <span class="card-icon"><Icon name={p.icon} /></span>
          <h3 class="card-title">{p.title}</h3>
          <p class="muted">{p.body}</p>
        </article>
      ))}
    </div>
  </Section>

  <!-- SERVICES -->
  <Section>
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow">How I help</p>
        <h2 class="section-h2 display">Services</h2>
      </div>
      <a href="/services/" class="see-all">All services →</a>
    </div>
    <div class="grid-3">
      {services.map((s, i) => (
        <div data-reveal style={`--reveal-delay:${i * 70}ms`}>
          <ServiceCard title={s.title} tagline={s.tagline} anchor={s.anchor} icon={s.icon} />
        </div>
      ))}
    </div>
  </Section>

  <!-- SIGNATURE #3: AI OPPORTUNITY MATRIX -->
  <Section tone="surface">
    <div class="sig-head" data-reveal>
      <p class="eyebrow">How I prioritize</p>
      <h2 class="section-h2 display">The AI Opportunity Matrix</h2>
      <p class="sig-sub muted">Not every AI idea deserves building. We start with the quick wins and plan the strategic bets.</p>
    </div>
    <OpportunityMatrix />
  </Section>

  <!-- CASE STUDIES -->
  <Section>
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow">Selected work</p>
        <h2 class="section-h2 display">Enterprise results</h2>
      </div>
      <a href="/case-studies/" class="see-all">All case studies →</a>
    </div>
    <div class="grid-3">
      {caseStudies.map((c, i) => (
        <a href="/case-studies/" class="case" data-reveal style={`--reveal-delay:${i * 90}ms`}>
          <span class="case-sector">{c.sector}</span>
          <h3 class="case-title">{c.title}</h3>
          <p class="case-summary">{c.outcome}</p>
          <span class="case-cta">Read case study →</span>
        </a>
      ))}
    </div>
  </Section>

  <!-- PROOF, NOT PROMISES -->
  <Section tone="surface">
    <p class="eyebrow" data-reveal>Proof, not promises</p>
    <h2 class="section-h2 display" data-reveal>Why this holds up</h2>
    <ul class="proof" role="list" data-reveal>
      {proof.map((p) => <li class="proof-item">{p}</li>)}
    </ul>
  </Section>

  <!-- INSIGHTS -->
  <Section>
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow">Latest insights</p>
        <h2 class="section-h2 display">Practical writing on ServiceNow &amp; AI</h2>
      </div>
      <a href="/blog/" class="see-all">All articles →</a>
    </div>
    {posts.length > 0 ? (
      <div class="grid-3">
        {posts.map((post, i) => (
          <div data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <PostCard post={post} />
          </div>
        ))}
      </div>
    ) : (
      <p class="muted">New articles are landing soon.</p>
    )}
  </Section>

  <!-- FINAL CTA -->
  <section class="final-cta">
    <div class="container final-cta-inner" data-reveal>
      <div>
        <h2 class="final-cta-title display">Let's discuss your next ServiceNow or AI initiative</h2>
        <p class="final-cta-sub">Book a free consultation and we'll find where a better process and the right AI move the needle.</p>
      </div>
      <CtaButton href="/contact/" size="lg">Book a consultation</CtaButton>
    </div>
  </section>
</BaseLayout>

<style>
  /* HERO */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem) clamp(1.5rem, 1rem + 2vw, 3rem);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }
  .hero-title {
    font-size: var(--step-5);
    margin-bottom: 1.1rem;
    line-height: 1.04;
  }
  .hero-title span {
    display: block;
  }
  .hero-title .accent {
    display: inline;
    color: var(--accent);
  }
  .hero-lead {
    max-width: 50ch;
    margin-bottom: 1.9rem;
  }
  .cred {
    margin-top: 1.9rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-subtle);
  }
  .hero-photo {
    position: relative;
    justify-self: center;
    width: 100%;
    max-width: 26rem;
  }
  .hero-vector {
    position: absolute;
    inset: -6% -16% -2% -16%;
    width: 132%;
    height: auto;
    z-index: 0;
    opacity: 0.7;
    pointer-events: none;
  }
  .hero-frame {
    position: relative;
    z-index: 1;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border-strong);
    box-shadow: var(--shadow-lg);
  }
  .hero-frame img,
  .hero-cutout {
    width: 100%;
    display: block;
  }
  .hero-frame::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 34%;
    background: linear-gradient(transparent, color-mix(in srgb, var(--bg) 88%, transparent));
  }
  .hero-cutout {
    position: relative;
    z-index: 1;
    filter: drop-shadow(0 18px 40px rgba(0, 0, 0, 0.5));
  }
  /* SHARED HEADS */
  .section-h2 {
    font-size: var(--step-3);
    margin-bottom: 1.5rem;
  }
  .sig-head {
    text-align: center;
    max-width: 46rem;
    margin: 0 auto 2rem;
  }
  .sig-head .section-h2 {
    margin-bottom: 0.6rem;
  }
  .sig-sub {
    max-width: 52ch;
    margin-inline: auto;
  }
  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.75rem;
  }
  .section-head .section-h2 {
    margin-bottom: 0;
  }
  .see-all {
    font-weight: 600;
    color: var(--accent);
    white-space: nowrap;
  }
  .see-all:hover {
    color: var(--accent-hover);
  }
  /* CONTRARIAN */
  .contrarian {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  .contrarian-title {
    font-size: var(--step-4);
    line-height: 1.05;
  }
  .contrarian-title span {
    display: block;
  }
  .contrarian-sub {
    margin-top: 1rem;
    font-size: var(--step-1);
    font-weight: 600;
    max-width: 30ch;
  }
  .contrarian-body p {
    color: var(--text-muted);
    line-height: 1.7;
  }
  .why-order {
    margin: 1rem 0;
    padding-left: 1.3rem;
    display: grid;
    gap: 0.4rem;
    color: var(--text);
  }
  .why-order li::marker {
    color: var(--accent);
    font-family: var(--font-mono);
  }
  /* ALLOCATION */
  .alloc {
    display: grid;
    gap: 1rem;
    max-width: 46rem;
  }
  .alloc-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.35rem 1rem;
    align-items: center;
  }
  .alloc-label {
    font-weight: 600;
  }
  .alloc-pct {
    font-family: var(--font-mono);
    color: var(--accent);
    font-weight: 700;
  }
  .alloc-track {
    grid-column: 1 / -1;
    height: 0.55rem;
    border-radius: var(--radius-pill);
    background: var(--surface);
    border: 1px solid var(--border);
    overflow: hidden;
  }
  .alloc-fill {
    display: block;
    height: 100%;
    width: 0;
    border-radius: var(--radius-pill);
    background: var(--accent);
    transition: width 1s var(--ease);
  }
  .alloc-row.is-visible .alloc-fill {
    width: var(--pct);
  }
  /* CARDS */
  .grid-3 {
    display: grid;
    gap: clamp(1rem, 0.5rem + 1.5vw, 1.5rem);
    grid-template-columns: 1fr;
  }
  .card {
    padding: 1.5rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    height: 100%;
    transition: transform var(--dur) var(--ease), border-color var(--dur), box-shadow var(--dur);
  }
  .card:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
    box-shadow: var(--shadow);
  }
  .card-icon {
    display: inline-grid;
    place-items: center;
    width: 2.7rem;
    height: 2.7rem;
    border-radius: var(--radius);
    background: var(--accent-soft);
    color: var(--accent);
    margin-bottom: 0.75rem;
  }
  .card-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-1);
    margin-bottom: 0.4rem;
  }
  /* CASE */
  .case {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
    padding: 1.5rem;
    background: var(--card);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    transition: transform var(--dur) var(--ease), box-shadow var(--dur), border-color var(--dur);
  }
  .case:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--accent);
  }
  .case-summary {
    color: var(--text-muted);
    font-size: var(--step--1);
    flex: 1 0 auto;
  }
  .case-sector {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: var(--step--1);
    color: var(--accent);
    font-weight: 700;
  }
  .case-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-1);
  }
  .case-cta {
    font-weight: 600;
    color: var(--accent);
    font-size: var(--step--1);
  }
  /* PROOF */
  .proof {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 0.7rem;
  }
  .proof-item {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: var(--step--1);
    color: var(--text);
    border: 1px solid var(--border-strong);
    background: var(--card);
    padding: 0.5rem 0.95rem;
    border-radius: var(--radius-pill);
  }
  /* FINAL CTA */
  .final-cta {
    background: var(--lx-dark);
    color: var(--lx-cream);
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
    margin-top: var(--section-y);
    border-top: 1px solid var(--border);
  }
  .final-cta-inner {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
  }
  .final-cta-title {
    font-size: var(--step-3);
    max-width: 22ch;
  }
  .final-cta-sub {
    margin-top: 0.6rem;
    max-width: 50ch;
    color: #cfc9be;
  }
  @media (min-width: 560px) {
    .grid-3 {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 760px) {
    .contrarian {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }
  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: 1.35fr 1fr;
    }
    .grid-3 {
      grid-template-columns: repeat(3, 1fr);
    }
    .final-cta-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
