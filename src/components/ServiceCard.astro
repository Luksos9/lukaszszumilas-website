---
import Icon from './Icon.astro';
import ServiceFlow from './ServiceFlow.astro';
import { useTranslations, localizeForNav, defaultLang, type Lang } from '../i18n/ui';

interface Props {
  title: string;
  tagline: string;
  anchor: string;
  icon?: string;
  flow?: string[];
  lang?: Lang;
}
const { title, tagline, anchor, icon, flow, lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const base = localizeForNav('/services/', lang);
const href = `${base}#${anchor}`;
const reload = lang !== defaultLang && !href.startsWith(`/${lang}/`);
---

<a href={href} class="service-card shine" data-astro-reload={reload ? '' : undefined}>
  {flow ? (
    <ServiceFlow steps={flow} />
  ) : icon ? (
    <span class="service-icon"><Icon name={icon} size={22} /></span>
  ) : null}
  <h3 class="service-card-title">{title}</h3>
  <p class="service-card-tag">{tagline}</p>
  <span class="service-card-cta">{t('home.services.learnMore')} <span aria-hidden="true">→</span></span>
</a>

<style>
  .service-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
    padding: clamp(1.4rem, 1rem + 1.2vw, 1.9rem);
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition: transform var(--dur-mid) var(--ease-out), box-shadow var(--dur-mid),
      border-color var(--dur-mid);
  }
  .service-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-lg);
    border-color: var(--accent-text);
  }
  /* keep card text above the shine sweep */
  .service-card > * {
    position: relative;
    z-index: 2;
  }
  .service-icon {
    display: inline-grid;
    place-items: center;
    width: 2.7rem;
    height: 2.7rem;
    border-radius: var(--radius);
    background: var(--accent-soft);
    color: var(--accent-text);
    margin-bottom: 0.3rem;
  }
  .service-card-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-1);
    letter-spacing: -0.01em;
  }
  .service-card-tag {
    color: var(--text-muted);
    font-size: var(--step--1);
    flex: 1 0 auto;
  }
  .service-card-cta {
    margin-top: 0.4rem;
    font-weight: 600;
    color: var(--accent-text);
    font-size: var(--step--1);
  }
</style>
