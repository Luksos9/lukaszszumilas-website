---
import { clients } from '../data/clients';
---

<ul class="client-strip" role="list">
  {clients.map((c) => (
    <li class="client-chip">{c.name}</li>
  ))}
</ul>

<style>
  .client-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 0.75rem;
    align-items: center;
  }
  .client-chip {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: var(--step-0);
    letter-spacing: -0.01em;
    color: var(--text-muted);
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--card);
  }
</style>
