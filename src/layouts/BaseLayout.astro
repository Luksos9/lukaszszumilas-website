---
import '@fontsource-variable/inter';
import '@fontsource/space-mono/400.css';
import '@fontsource/space-mono/700.css';
import '@fontsource-variable/fraunces';
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import { ClientRouter } from 'astro:transitions';
import { defaultLang, localeCodes, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  publishedTime?: Date;
  noindex?: boolean;
  canonical?: string;
  jsonLd?: object;
  lang?: Lang;
  /** Locales this page exists in (for hreflang). Defaults to English-only. */
  locales?: Lang[];
}

const {
  title, description, image, article, publishedTime, noindex, canonical, jsonLd,
  lang = defaultLang,
  locales = [defaultLang],
} = Astro.props;
const t = useTranslations(lang);
---

<!doctype html>
<html lang={localeCodes[lang]}>
  <head>
    <script is:inline>
      // Set theme before paint, and RE-APPLY after every View Transitions swap:
      // the swap copies the incoming document's <html> attributes, which would
      // otherwise drop the runtime data-theme (and .js class) and flash to light.
      (() => {
        const applyTheme = () => {
          let theme = 'dark'; // dark by default; light only if explicitly chosen
          try {
            if (localStorage.getItem('ls-theme') === 'light') theme = 'light';
          } catch (e) {}
          document.documentElement.dataset.theme = theme;
          document.documentElement.classList.add('js');
        };
        applyTheme();
        document.addEventListener('astro:after-swap', applyTheme);
      })();
    </script>
    <BaseHead
      title={title}
      description={description}
      image={image}
      article={article}
      publishedTime={publishedTime}
      noindex={noindex}
      canonical={canonical}
      jsonLd={jsonLd}
      lang={lang}
      locales={locales}
    />
    <link rel="preload" href={interWoff2} as="font" type="font/woff2" crossorigin="anonymous" />
    <Analytics />
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">{t('common.skipToContent')}</a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      // Re-run on every View Transitions navigation (astro:page-load fires on
      // first load AND after each client navigation), so freshly-swapped
      // [data-reveal] elements get observed instead of staying hidden.
      function initReveal() {
        if (!('IntersectionObserver' in window)) return;
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 }
        );
        document.querySelectorAll('[data-reveal]:not(.is-visible)').forEach((el) => io.observe(el));
      }
      document.addEventListener('astro:page-load', initReveal);
    </script>
    <script>
      // Analytics helper — no-ops entirely until a GA4 id is set (window.__GA_ID
      // is defined by Analytics.astro only when site.analytics.ga4Id is present).
      const w = window as any;
      function gaPageView() {
        if (w.gtag && w.__GA_ID) {
          w.gtag('event', 'page_view', {
            page_title: document.title,
            page_location: location.href,
            page_path: location.pathname,
          });
        }
      }
      w.track = (name: string, params?: Record<string, unknown>) => {
        if (w.gtag && w.__GA_ID) w.gtag('event', name, params || {});
      };
      document.addEventListener('astro:page-load', gaPageView);
      document.addEventListener('click', (e) => {
        const target = e.target as Element | null;
        const el = target && target.closest ? target.closest('[data-analytics]') : null;
        if (el) {
          w.track(el.getAttribute('data-analytics') || 'click', {
            label: (el.textContent || '').trim().slice(0, 80),
          });
        }
      });
    </script>
  </body>
</html>
