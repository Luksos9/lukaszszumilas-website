---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Section from '../../components/Section.astro';
import PostCard from '../../components/PostCard.astro';
import TagPill from '../../components/TagPill.astro';
import Icon from '../../components/Icon.astro';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();

// The three things I write about — the content pillars.
const pillars = [
  {
    icon: 'grid',
    title: 'ServiceNow + AI use cases',
    body: 'Where AI actually earns its place on the platform — incident triage, knowledge, AIOps and more.',
  },
  {
    icon: 'trend',
    title: 'Rapid ROI from AI agents',
    body: 'Getting value fast: agents that take repetitive work off your team without losing control.',
  },
  {
    icon: 'shield',
    title: 'Governed AI',
    body: 'AI that passes a security review — MCP, scopes, GDPR and the EU AI Act.',
  },
];
---

<BaseLayout
  title="Insights"
  description="Writing on ServiceNow, governed AI, MCP and Claude, and certification strategy, by Lukasz Szumilas."
>
  <PageHeader eyebrow="Writing" title="Insights">
    ServiceNow scripting and architecture, governed AI on the platform, and practical
    operational improvement.
  </PageHeader>

  <Section>
    <div class="pillars" data-reveal>
      {pillars.map((p) => (
        <article class="pillar">
          <span class="pillar-icon"><Icon name={p.icon} size={20} /></span>
          <div>
            <h2 class="pillar-title">{p.title}</h2>
            <p class="muted">{p.body}</p>
          </div>
        </article>
      ))}
    </div>

    {tags.length > 0 && (
      <div class="blog-topics">
        <span class="topics-label">Topics</span>
        <div class="cluster">
          {tags.map((t) => <TagPill tag={t} href={`/tags/${t}/`} />)}
        </div>
      </div>
    )}

    {posts.length > 0 ? (
      <div class="grid-posts">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    ) : (
      <p class="muted">New articles are landing soon.</p>
    )}
  </Section>
</BaseLayout>

<style>
  .pillars {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
  }
  .pillar {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.85rem;
    align-items: start;
    padding: clamp(1.1rem, 0.9rem + 1vw, 1.4rem);
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .pillar-icon {
    display: inline-grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: var(--radius);
    background: var(--accent-soft);
    color: var(--accent-text);
  }
  .pillar-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-0);
    margin-bottom: 0.2rem;
  }
  .blog-topics {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
    margin-bottom: 2rem;
  }
  .topics-label {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.78rem;
    color: var(--text-subtle);
    font-weight: 700;
  }
  .grid-posts {
    display: grid;
    gap: clamp(1rem, 0.5rem + 1.5vw, 1.5rem);
    grid-template-columns: 1fr;
  }
  @media (min-width: 600px) {
    .grid-posts {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 760px) {
    .pillars {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 900px) {
    .grid-posts {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
