---
// Full-hero technical backdrop: a faint blueprint dot-grid across the whole
// section + a ServiceNow/AI workflow mesh — a glowing AI hub on the right wired
// to nodes, with orange "data" pulses flowing along connectors that sweep across
// the section (above/below the headline, so text stays readable). Behind the
// hero content; dual-theme; reduced-motion safe.
const hex = (cx: number, cy: number, r: number) => {
  const a = 0.866 * r;
  const b = 0.5 * r;
  return `M${cx} ${cy - r} L${cx + a} ${cy - b} L${cx + a} ${cy + b} L${cx} ${cy + r} L${cx - a} ${cy + b} L${cx - a} ${cy - b} Z`;
};

// connectors — `flow` ones carry an animated pulse.
const CONNECTORS = [
  { d: 'M1200 300 C 1260 230, 1300 195, 1320 172', flow: false },
  { d: 'M1200 300 C 1320 300, 1380 300, 1410 300', flow: true },
  { d: 'M1200 300 C 1270 370, 1300 410, 1320 440', flow: false },
  { d: 'M1200 300 C 1210 220, 1190 165, 1180 132', flow: true },
  { d: 'M1200 300 C 1190 400, 1170 470, 1150 500', flow: false },
  { d: 'M1180 132 C 880 80, 620 80, 360 120', flow: true },
  { d: 'M1150 500 C 860 560, 560 560, 280 520', flow: true },
  { d: 'M360 120 C 250 150, 170 200, 120 250', flow: false },
  { d: 'M280 520 C 200 510, 130 495, 90 470', flow: false },
];

type Node = { t: 'rect' | 'circle' | 'hex'; x: number; y: number; r?: number; s?: number };
const NODES: Node[] = [
  { t: 'circle', x: 1320, y: 172, r: 7 },
  { t: 'rect', x: 1398, y: 288, s: 24 },
  { t: 'circle', x: 1320, y: 440, r: 6 },
  { t: 'hex', x: 1180, y: 132, r: 12 },
  { t: 'circle', x: 1150, y: 500, r: 6 },
  { t: 'circle', x: 700, y: 92, r: 5 },
  { t: 'rect', x: 626, y: 532, s: 18 },
  { t: 'circle', x: 360, y: 120, r: 6 },
  { t: 'rect', x: 268, y: 508, s: 22 },
  { t: 'hex', x: 120, y: 250, r: 11 },
  { t: 'circle', x: 90, y: 470, r: 5 },
];
---

<div class="hero-bg" aria-hidden="true">
  <svg viewBox="0 0 1600 620" fill="none" preserveAspectRatio="xMidYMid slice">
    <g class="hb-lines">
      {CONNECTORS.map((c) => <path d={c.d} />)}
    </g>
    <g class="hb-flows">
      {CONNECTORS.filter((c) => c.flow).map((c, i) => (
        <path class="hb-flow" d={c.d} pathLength="100" style={`animation-delay:${-i * 0.7}s`} />
      ))}
    </g>
    <g class="hb-nodes">
      {NODES.map((n) =>
        n.t === 'rect' ? (
          <rect class="hb-node" x={n.x} y={n.y} width={n.s} height={n.s} rx="5" />
        ) : n.t === 'hex' ? (
          <path class="hb-node" d={hex(n.x, n.y, n.r!)} />
        ) : (
          <circle class="hb-node" cx={n.x} cy={n.y} r={n.r} />
        )
      )}
      <!-- central AI hub -->
      <path class="hb-node hb-acc" d={hex(1200, 300, 20)} />
      <circle class="hb-acc-dot" cx="1200" cy="300" r="5" />
    </g>
  </svg>
</div>

<style>
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    color: var(--text-muted);
  }
  /* blueprint dot-grid across the whole hero */
  .hero-bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, currentColor 1.1px, transparent 1.3px);
    background-size: 30px 30px;
    opacity: 0.08;
    -webkit-mask-image: linear-gradient(to bottom, #000 76%, transparent);
    mask-image: linear-gradient(to bottom, #000 76%, transparent);
  }
  .hero-bg svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.66;
    -webkit-mask-image: radial-gradient(135% 130% at 58% 45%, #000 72%, transparent 100%);
    mask-image: radial-gradient(135% 130% at 58% 45%, #000 72%, transparent 100%);
  }
  .hb-lines path {
    stroke: currentColor;
    stroke-width: 1.1;
    opacity: 0.5;
  }
  .hb-flow {
    stroke: var(--accent);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-dasharray: 6 94;
  }
  .js .hb-flow {
    animation: hbFlow 3.6s linear infinite;
  }
  @keyframes hbFlow {
    from { stroke-dashoffset: 0; }
    to { stroke-dashoffset: -100; }
  }
  .hb-node {
    stroke: currentColor;
    stroke-width: 1.6;
    fill: var(--bg);
  }
  .hb-acc {
    stroke: var(--accent);
    fill: var(--accent-soft);
    filter: drop-shadow(0 0 9px var(--ring));
  }
  .hb-acc-dot {
    fill: var(--accent);
  }
  @media (prefers-reduced-motion: reduce) {
    .hb-flow {
      display: none;
    }
  }
</style>
