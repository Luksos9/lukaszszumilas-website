---
import Icon from './Icon.astro';
const inputs = [
  { icon: 'agent', label: 'People' },
  { icon: 'cube', label: 'Systems' },
  { icon: 'book', label: 'Knowledge' },
  { icon: 'sitemap', label: 'Processes' },
];
const outputs = [
  { icon: 'target', label: 'Decisions' },
  { icon: 'gear', label: 'Automation' },
  { icon: 'chart', label: 'Insights' },
];
---

<div class="aios">
  <ul class="aios-row inputs" role="list">
    {inputs.map((n, i) => (
      <li class="node" data-reveal style={`--reveal-delay:${i * 70}ms`}>
        <span class="node-icon"><Icon name={n.icon} size={20} /></span>{n.label}
      </li>
    ))}
  </ul>

  <div class="aios-flow" aria-hidden="true" data-reveal><span class="aios-dot"></span></div>

  <div class="aios-layer" data-reveal>
    <span class="layer-pulse"></span>
    AI Layer
  </div>

  <div class="aios-flow" aria-hidden="true" data-reveal style="--d:0.9s"><span class="aios-dot"></span></div>

  <ul class="aios-row outputs" role="list">
    {outputs.map((n, i) => (
      <li class="node out" data-reveal style={`--reveal-delay:${i * 70}ms`}>
        <span class="node-icon"><Icon name={n.icon} size={20} /></span>{n.label}
      </li>
    ))}
  </ul>
</div>

<style>
  .aios {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
  }
  .aios-row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    width: 100%;
    max-width: 46rem;
    grid-template-columns: repeat(2, 1fr);
  }
  .node {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    font-weight: 600;
    color: var(--text);
  }
  .node-icon {
    display: inline-grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    flex: 0 0 auto;
    border-radius: var(--radius-sm);
    background: var(--accent-soft);
    color: var(--accent-text);
  }
  .aios-flow {
    position: relative;
    width: 2px;
    height: 1.7rem;
    border-radius: 2px;
    background: var(--border-strong);
    overflow: hidden;
  }
  .aios-dot {
    position: absolute;
    left: 50%;
    top: 0;
    width: 6px;
    height: 6px;
    margin-left: -3px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0;
  }
  .js .aios-dot {
    animation: aiosFlow 1.9s var(--ease) infinite;
    animation-delay: var(--d, 0s);
  }
  @keyframes aiosFlow {
    0% {
      top: -6px;
      opacity: 0;
    }
    25% {
      opacity: 1;
    }
    75% {
      opacity: 1;
    }
    100% {
      top: 1.7rem;
      opacity: 0;
    }
  }
  .aios-layer {
    position: relative;
    overflow: hidden;
    width: 100%;
    max-width: 46rem;
    text-align: center;
    padding: 1rem;
    border-radius: var(--radius);
    background: var(--accent-soft);
    border: 1px solid var(--accent);
    color: var(--accent-text);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-1);
    letter-spacing: 0.01em;
  }
  .layer-pulse {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      115deg,
      transparent 38%,
      color-mix(in srgb, var(--accent) 35%, transparent) 50%,
      transparent 62%
    );
    transform: translateX(-130%);
  }
  .aios-layer.is-visible .layer-pulse {
    animation: aiosShimmer 3.6s var(--ease-out) 0.5s infinite;
  }
  @keyframes aiosShimmer {
    0% {
      transform: translateX(-130%);
    }
    55%,
    100% {
      transform: translateX(130%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .aios-dot,
    .layer-pulse {
      display: none;
    }
  }
  @media (min-width: 720px) {
    .aios-row.inputs {
      grid-template-columns: repeat(4, 1fr);
    }
    .aios-row.outputs {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
