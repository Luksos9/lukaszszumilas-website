---
// Day/night slider toggle (à la luckyx.dev): moon + stars on navy in dark mode,
// sun on sky-blue in light mode. Reflects + flips :root[data-theme].
---

<button
  class="theme-slider"
  type="button"
  data-theme-toggle
  aria-label="Toggle light or dark theme"
  title="Toggle theme"
>
  <span class="ts-track" aria-hidden="true">
    <span class="ts-star ts-star--1"></span>
    <span class="ts-star ts-star--2"></span>
    <span class="ts-star ts-star--3"></span>
    <span class="ts-knob"></span>
  </span>
</button>

<script is:inline>
  (() => {
    const root = document.documentElement;
    let animTimer;
    document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.classList.add('theme-anim');
        root.dataset.theme = next;
        try {
          localStorage.setItem('ls-theme', next);
        } catch (e) {}
        clearTimeout(animTimer);
        animTimer = setTimeout(() => root.classList.remove('theme-anim'), 420);
      });
    });
  })();
</script>

<style>
  .theme-slider {
    display: inline-flex;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    border-radius: 999px;
  }
  .theme-slider:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .ts-track {
    position: relative;
    display: block;
    width: 58px;
    height: 30px;
    border-radius: 999px;
    /* night */
    background: linear-gradient(180deg, #2c3c66 0%, #16223f 100%);
    border: 1px solid rgba(255, 255, 255, 0.18);
    box-shadow: inset 0 1px 3px rgba(0, 0, 0, 0.45);
    overflow: hidden;
    transition: background 0.45s var(--ease), border-color 0.45s var(--ease);
  }
  .ts-knob {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    /* moon */
    background: radial-gradient(circle at 35% 32%, #fdfdf6, #e7e1cd);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
    transition: transform 0.45s var(--ease-spring), background 0.45s var(--ease),
      box-shadow 0.45s var(--ease);
  }
  /* moon craters */
  .ts-knob::before,
  .ts-knob::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    background: rgba(40, 40, 40, 0.1);
    transition: opacity 0.3s var(--ease);
  }
  .ts-knob::before {
    width: 6px;
    height: 6px;
    top: 5px;
    left: 13px;
  }
  .ts-knob::after {
    width: 4px;
    height: 4px;
    top: 14px;
    left: 6px;
  }
  .ts-star {
    position: absolute;
    width: 2.5px;
    height: 2.5px;
    border-radius: 50%;
    background: #fff;
    opacity: 0.85;
    transition: opacity 0.35s var(--ease);
  }
  .ts-star--1 {
    top: 7px;
    right: 10px;
  }
  .ts-star--2 {
    top: 16px;
    right: 15px;
    width: 2px;
    height: 2px;
  }
  .ts-star--3 {
    top: 20px;
    right: 8px;
  }

  /* DAY (light theme): slide to the sun on sky-blue */
  :global(:root[data-theme='light']) .ts-track {
    background: linear-gradient(180deg, #8fd3f0 0%, #d4eeff 100%);
    border-color: rgba(0, 0, 0, 0.12);
  }
  :global(:root[data-theme='light']) .ts-knob {
    transform: translateX(28px);
    background: radial-gradient(circle at 50% 50%, #ffdc6b, #ffb52e);
    box-shadow: 0 0 9px rgba(255, 178, 46, 0.75), 0 1px 4px rgba(0, 0, 0, 0.2);
  }
  :global(:root[data-theme='light']) .ts-knob::before,
  :global(:root[data-theme='light']) .ts-knob::after {
    opacity: 0;
  }
  :global(:root[data-theme='light']) .ts-star {
    opacity: 0;
  }
</style>
