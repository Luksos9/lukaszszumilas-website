---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import CtaButton from '../components/CtaButton.astro';
import PostCard from '../components/PostCard.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Icon from '../components/Icon.astro';
import OperationsLoop from '../components/OperationsLoop.astro';
import ProcessEquation from '../components/ProcessEquation.astro';
import { site } from '../data/site';
import { services } from '../data/services';
import { problems } from '../data/problems';
import { caseStudies } from '../data/caseStudies';

const HAS_CUTOUT = true;

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: site.name,
    url: site.url,
    jobTitle: 'Operational Efficiency Advisor',
    description: site.description,
    sameAs: [site.socials.linkedin, site.socials.udemy, site.socials.github],
    knowsAbout: ['ServiceNow', 'Workflow automation', 'Process improvement', 'AI Agents', 'Now Assist', 'ITSM'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: 'Lukasz Szumilas — ServiceNow, AI & operational improvement',
    url: site.url,
    description: site.description,
    areaServed: 'Europe',
    serviceType: ['ServiceNow consulting', 'AI implementation', 'Process automation', 'Operational improvement'],
    provider: { '@type': 'Person', name: site.name },
  },
];
---

<BaseLayout jsonLd={jsonLd}>
  <!-- HERO -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-text">
        <p class="eyebrow" data-reveal>Operational Efficiency Advisor</p>
        <h1 class="hero-title display">
          <span data-reveal style="--reveal-delay:80ms">Reduce Manual Work.</span>
          <span data-reveal style="--reveal-delay:200ms">Improve Productivity.</span>
          <span data-reveal style="--reveal-delay:320ms">Scale <span class="accent">Operations.</span></span>
        </h1>
        <p class="hero-lead lead" data-reveal style="--reveal-delay:440ms">
          I help organizations <span class="mark">get more done with less manual work</span>, using
          ServiceNow, AI, and process design.
        </p>
        <div class="hero-cta cluster" data-reveal style="--reveal-delay:560ms">
          <CtaButton href="/contact/" size="lg">Book a consultation</CtaButton>
          <CtaButton href="/services/" variant="secondary" size="lg">Explore my approach</CtaButton>
        </div>
        <p class="cred" data-reveal style="--reveal-delay:680ms">ServiceNow instructor · 10,000+ students taught</p>
      </div>
      <div class="hero-photo" data-reveal style="--reveal-delay:240ms">
        <img class="hero-vector" src="/hero-vector.svg" alt="" aria-hidden="true" />
        {HAS_CUTOUT ? (
          <img class="hero-cutout" src="/lukasz-cutout.webp" alt="Lukasz Szumilas" width="900" height="1349" fetchpriority="high" />
        ) : (
          <div class="hero-frame">
            <img src="/lukasz.webp" alt="Lukasz Szumilas" width="900" height="1349" fetchpriority="high" />
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- 1. WHY DIFFERENT — THE AI REALITY CHECK -->
  <Section tone="surface">
    <div class="contrarian">
      <div>
        <p class="eyebrow" data-reveal>The AI reality check</p>
        <h2 class="contrarian-title display">
          <span data-reveal>Most companies don't</span>
          <span data-reveal style="--reveal-delay:140ms">need more AI tools.</span>
        </h2>
        <p class="contrarian-sub" data-reveal style="--reveal-delay:300ms">
          They need <span class="mark">better processes</span>, automation, and the right AI use cases.
        </p>
      </div>
      <div class="contrarian-body" data-reveal style="--reveal-delay:200ms">
        <p>Most AI projects underwhelm because they start with the model. The results come from fixing the work first, in order:</p>
        <ol class="why-order">
          <li>Fix the process.</li>
          <li>Automate the repetitive parts.</li>
          <li>Improve how people find knowledge.</li>
          <li>Then apply AI where it creates real value.</li>
        </ol>
        <p>That's the order I work in with every client.</p>
      </div>
    </div>
  </Section>

  <!-- 2. THE MULTIPLIER — PROCESS + AI EQUATION -->
  <Section>
    <div class="sig-head" data-reveal>
      <p class="eyebrow">The multiplier problem</p>
      <h2 class="section-h2 display">Add AI to a broken process and you just get faster chaos</h2>
      <p class="sig-sub muted">AI multiplies whatever it runs on. Fix the process first, and the same AI creates real business impact.</p>
    </div>
    <ProcessEquation />
  </Section>

  <!-- 3. HOW I THINK — THE FRAMEWORK -->
  <Section tone="surface">
    <div class="sig-head" data-reveal>
      <p class="eyebrow">My methodology</p>
      <h2 class="section-h2 display">The Operations Improvement Loop</h2>
      <p class="sig-sub muted">A repeatable system, not a one-off project. Every engagement runs the loop.</p>
    </div>
    <OperationsLoop />
  </Section>

  <!-- 4. DO YOU UNDERSTAND MY WORLD — DIAGNOSTIC LEDGER -->
  <Section>
    <div class="sig-head" data-reveal>
      <p class="eyebrow">Symptoms → Outcomes</p>
      <h2 class="section-h2 display">Does any of this look familiar?</h2>
      <p class="sig-sub muted">Every symptom on the left has a fix on the right. The method in between is always the same.</p>
    </div>
    <div class="dx-ledger">
      {problems.map((p, i) => {
        const weight = p.severity === 'Very Common' ? 'lead' : p.severity === 'Emerging' ? 'trail' : 'mid';
        return (
          <div class="dx-row" data-weight={weight} data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <div class="dx-now">
              <span class="dx-icon"><Icon name={p.icon} size={18} /></span>
              <span class="dx-copy">
                <span class="dx-label">{p.title}</span>
                <span class="dx-body muted">{p.body}</span>
              </span>
              <span class="dx-sev" data-weight={weight}>{p.severity}</span>
            </div>
            <span class="dx-arrow" aria-hidden="true">→</span>
            <div class="dx-next">
              <span class="dx-icon dx-icon--out"><Icon name={p.outIcon} size={18} /></span>
              <span class="dx-outcome">{p.outcome}</span>
            </div>
          </div>
        );
      })}
    </div>
    <p class="dx-pattern" data-reveal>
      This isn't six features — it's one method shown six times:
      <span class="accent">every symptom resolves into an outcome the loop produces.</span>
    </p>
    <div class="dx-bridge" data-reveal>
      <span class="dx-bridge-rule" aria-hidden="true"></span>
      <a class="dx-bridge-link" href="/services/">See how I turn these into outcomes <span class="dx-bridge-arrow" aria-hidden="true">→</span></a>
    </div>
  </Section>

  <!-- 5. CAN YOU HELP ME — SERVICES -->
  <Section tone="surface">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow">How I help</p>
        <h2 class="section-h2 display">Services</h2>
      </div>
      <a href="/services/" class="see-all">All services →</a>
    </div>
    <div class="grid-3">
      {services.map((s, i) => (
        <div data-reveal style={`--reveal-delay:${i * 70}ms`}>
          <ServiceCard title={s.title} tagline={s.tagline} anchor={s.anchor} icon={s.icon} />
        </div>
      ))}
    </div>
  </Section>

  <!-- 6. HAVE YOU DONE IT BEFORE — CASE STUDIES (TRANSFORMATION) -->
  <Section>
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow">Selected work</p>
        <h2 class="section-h2 display">From symptom to outcome</h2>
      </div>
      <a href="/case-studies/" class="see-all">All case studies →</a>
    </div>
    <div class="cs-list">
      {caseStudies.map((c, i) => (
        <article class="cs" data-reveal style={`--reveal-delay:${i * 90}ms`}>
          <header class="cs-head">
            <span class="cs-sector">{c.sector}</span>
            <h3 class="cs-title">{c.title}</h3>
          </header>
          <div class="cs-flow">
            <div class="cs-stage">
              <span class="cs-stage-label">Problem</span>
              <p>{c.situation}</p>
            </div>
            <span class="cs-arrow" aria-hidden="true">→</span>
            <div class="cs-stage">
              <span class="cs-stage-label">Approach</span>
              <p>{c.action}</p>
            </div>
            <span class="cs-arrow" aria-hidden="true">→</span>
            <div class="cs-stage cs-stage--out">
              <span class="cs-stage-label">Result</span>
              <p>{c.outcome}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </Section>

  <!-- 7. INSIGHTS -->
  <Section tone="surface">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow">Latest insights</p>
        <h2 class="section-h2 display">Writing on ServiceNow &amp; AI</h2>
      </div>
      <a href="/blog/" class="see-all">All articles →</a>
    </div>
    {posts.length > 0 ? (
      <div class="grid-3">
        {posts.map((post, i) => (
          <div data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <PostCard post={post} />
          </div>
        ))}
      </div>
    ) : (
      <p class="muted">New articles are landing soon.</p>
    )}
  </Section>

  <!-- 8. FINAL CTA -->
  <section class="final-cta">
    <div class="container final-cta-inner" data-reveal>
      <p class="final-cta-eyebrow">Start here</p>
      <h2 class="final-cta-title display">Ready to find the AI opportunities inside your ServiceNow environment?</h2>
      <p class="final-cta-sub">
        Book a free consultation. You'll leave with a clear view of where a better process and the
        right AI move the needle — whether or not we build it together.
      </p>
      <CtaButton href="/contact/" size="lg">Book a consultation</CtaButton>
    </div>
  </section>
</BaseLayout>

<style>
  /* HERO */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem) clamp(1.5rem, 1rem + 2vw, 3rem);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
  }
  .hero-title {
    font-size: var(--step-5);
    margin-bottom: 1.1rem;
    line-height: 1.04;
  }
  .hero-title span {
    display: block;
  }
  .hero-title .accent {
    display: inline;
    color: var(--accent);
  }
  .hero-lead {
    max-width: 50ch;
    margin-bottom: 1.9rem;
  }
  .cred {
    margin-top: 1.9rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-subtle);
  }
  .hero-photo {
    position: relative;
    justify-self: center;
    width: 100%;
    max-width: 26rem;
  }
  .hero-vector {
    position: absolute;
    inset: -6% -16% -2% -16%;
    width: 132%;
    height: auto;
    z-index: 0;
    opacity: 0.7;
    pointer-events: none;
  }
  .hero-frame {
    position: relative;
    z-index: 1;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border-strong);
    box-shadow: var(--shadow-lg);
  }
  .hero-frame img,
  .hero-cutout {
    width: 100%;
    display: block;
  }
  .hero-frame::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 34%;
    background: linear-gradient(transparent, color-mix(in srgb, var(--bg) 88%, transparent));
  }
  .hero-cutout {
    position: relative;
    z-index: 1;
    filter: drop-shadow(0 18px 40px rgba(0, 0, 0, 0.5));
  }
  /* SHARED HEADS */
  .section-h2 {
    font-size: var(--step-3);
    margin-bottom: 1.5rem;
  }
  .sig-head {
    text-align: center;
    max-width: 46rem;
    margin: 0 auto 2rem;
  }
  .sig-head .section-h2 {
    margin-bottom: 0.6rem;
  }
  .sig-sub {
    max-width: 54ch;
    margin-inline: auto;
  }
  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.75rem;
  }
  .section-head .section-h2 {
    margin-bottom: 0;
  }
  .see-all {
    font-weight: 600;
    color: var(--accent);
    white-space: nowrap;
  }
  .see-all:hover {
    color: var(--accent-hover);
  }
  /* CONTRARIAN */
  .contrarian {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  .contrarian-title {
    font-size: var(--step-4);
    line-height: 1.05;
  }
  .contrarian-title span {
    display: block;
  }
  .contrarian-sub {
    margin-top: 1rem;
    font-size: var(--step-1);
    font-weight: 600;
    max-width: 30ch;
  }
  .contrarian-body p {
    color: var(--text-muted);
    line-height: 1.7;
  }
  .why-order {
    margin: 1rem 0;
    padding-left: 1.3rem;
    display: grid;
    gap: 0.4rem;
    color: var(--text);
  }
  .why-order li::marker {
    color: var(--accent);
    font-family: var(--font-mono);
  }
  /* GRID (services, insights) */
  .grid-3 {
    display: grid;
    gap: clamp(1rem, 0.5rem + 1.5vw, 1.5rem);
    grid-template-columns: 1fr;
  }
  /* DIAGNOSTIC LEDGER (problems) */
  .dx-ledger {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    max-width: 54rem;
    margin: 2.25rem auto 0;
  }
  .dx-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;
    align-items: center;
    padding: clamp(0.85rem, 2vw, 1.1rem) clamp(1rem, 2.5vw, 1.35rem);
    border-radius: var(--radius);
    border: 1px solid transparent;
    transition: transform 0.25s var(--ease), border-color 0.25s var(--ease), box-shadow 0.25s var(--ease), opacity 0.5s var(--ease);
  }
  .dx-row[data-weight='lead'] {
    background: var(--card);
    border-color: var(--border);
    box-shadow: var(--shadow-sm);
  }
  .dx-row[data-weight='trail'] {
    border: 1px dashed var(--border);
    opacity: 0.86;
  }
  .dx-row[data-weight='trail'].is-visible {
    opacity: 1;
  }
  .dx-now {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }
  .dx-copy {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
  }
  .dx-label {
    font-weight: 600;
    color: var(--text);
    line-height: 1.2;
  }
  .dx-body {
    font-size: var(--step--1);
    line-height: 1.35;
  }
  .dx-icon {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    flex: 0 0 auto;
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    background: var(--surface);
    border: 1px solid var(--border);
    transition: color 0.25s var(--ease), border-color 0.25s var(--ease);
  }
  .dx-icon--out {
    color: var(--accent);
    background: var(--accent-soft);
    border-color: transparent;
  }
  .dx-arrow {
    color: var(--border-strong);
    font-size: 1.15rem;
    line-height: 1;
    font-weight: 700;
    justify-self: start;
    transform: rotate(90deg);
    transition: color 0.25s var(--ease);
  }
  .dx-next {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .dx-outcome {
    font-weight: 600;
    color: var(--text);
    line-height: 1.2;
  }
  .dx-sev {
    margin-left: auto;
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    padding: 0.18rem 0.5rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--border);
    color: var(--text-subtle);
    white-space: nowrap;
  }
  .dx-sev[data-weight='lead'] {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .dx-sev[data-weight='trail'] {
    color: var(--accent);
    border: 1px dashed var(--accent);
    background: transparent;
  }
  .dx-row:hover .dx-arrow {
    color: var(--accent);
  }
  .dx-row[data-weight='lead']:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    box-shadow: var(--shadow);
  }
  .dx-row[data-weight='mid']:hover .dx-icon,
  .dx-row[data-weight='trail']:hover .dx-icon {
    border-color: var(--accent);
    color: var(--accent);
  }
  .dx-pattern {
    max-width: 46rem;
    margin: 2.25rem auto 0;
    text-align: center;
    color: var(--text-muted);
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.45;
  }
  .dx-pattern .accent {
    color: var(--accent);
  }
  .dx-bridge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .dx-bridge-rule {
    width: 1px;
    height: 2.5rem;
    background: linear-gradient(var(--border-strong), var(--accent));
  }
  .dx-bridge-link {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.07em;
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--accent);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .dx-bridge-arrow {
    transition: transform 0.2s var(--ease);
  }
  .dx-bridge-link:hover .dx-bridge-arrow {
    transform: translateX(4px);
  }
  /* CASE TRANSFORMATION */
  .cs-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .cs {
    padding: clamp(1.25rem, 2vw, 1.75rem);
    background: var(--card);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    transition: border-color 0.25s var(--ease), box-shadow 0.25s var(--ease);
  }
  .cs:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow);
  }
  .cs-head {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin-bottom: 1.1rem;
  }
  .cs-sector {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: var(--step--1);
    color: var(--accent);
    font-weight: 700;
  }
  .cs-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-2);
  }
  .cs-flow {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }
  .cs-stage {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .cs-stage-label {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.62rem;
    font-weight: 700;
    color: var(--text-subtle);
  }
  .cs-stage p {
    color: var(--text-muted);
    font-size: var(--step--1);
    line-height: 1.5;
  }
  .cs-stage--out .cs-stage-label {
    color: var(--accent);
  }
  .cs-stage--out p {
    color: var(--text);
  }
  .cs-arrow {
    color: var(--border-strong);
    font-weight: 700;
    justify-self: start;
    transform: rotate(90deg);
  }
  /* FINAL CTA */
  .final-cta {
    background: var(--lx-dark);
    color: var(--lx-cream);
    padding-block: clamp(3.5rem, 2rem + 6vw, 6.5rem);
    margin-top: var(--section-y);
    border-top: 1px solid var(--border);
  }
  .final-cta-inner {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: center;
    text-align: center;
    max-width: 40rem;
    margin-inline: auto;
  }
  .final-cta-eyebrow {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--step--1);
    color: var(--accent);
    font-weight: 700;
  }
  .final-cta-title {
    font-size: var(--step-4);
    max-width: 18ch;
    line-height: 1.08;
  }
  .final-cta-sub {
    max-width: 54ch;
    color: #cfc9be;
    line-height: 1.6;
  }
  @media (min-width: 560px) {
    .grid-3 {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 720px) {
    .dx-row {
      grid-template-columns: 1fr auto minmax(8rem, 0.8fr);
      gap: clamp(0.75rem, 2vw, 1.6rem);
    }
    .dx-row[data-weight='lead'] .dx-label {
      font-size: var(--step-1);
    }
    .dx-arrow {
      transform: none;
      justify-self: center;
    }
  }
  @media (min-width: 760px) {
    .contrarian {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
    .cs-flow {
      grid-template-columns: 1fr auto 1fr auto 1fr;
      align-items: start;
      gap: 1.25rem;
    }
    .cs-arrow {
      transform: none;
      align-self: center;
    }
  }
  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: 1.35fr 1fr;
    }
    .grid-3 {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
