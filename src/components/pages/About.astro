---
import PageHeader from '../PageHeader.astro';
import Section from '../Section.astro';
import CtaButton from '../CtaButton.astro';
import Icon from '../Icon.astro';
import { site } from '../../data/site';
import { useTranslations, localizeForNav, defaultLang, type Lang } from '../../i18n/ui';

interface Props {
  lang?: Lang;
}
const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const PILLAR_ICONS = ['cube', 'sparkle', 'shield'];
const pillars = t<{ title: string; body: string }[]>('pages.about.pillars');
const creds = t<string[]>('pages.about.creds');
const doItems = t<{ label: string; text: string }[]>('pages.about.doItems');
const langs = t<string[]>('pages.about.langs');
const teachingHref = localizeForNav('/teaching/', lang);
const contactHref = localizeForNav('/contact/', lang);
const servicesHref = localizeForNav('/services/', lang);
const reload = (href: string) => lang !== defaultLang && !href.startsWith(`/${lang}/`);
---

<PageHeader eyebrow={t('pages.about.eyebrow')} title={t('pages.about.title')}>
  {t('pages.about.lead')}
</PageHeader>

<Section>
 <div class="about-intro">
  <div class="page-body flow">
    <p>{t('pages.about.p1')}</p>
    <p>{t('pages.about.p2')}</p>
    <p>{t('pages.about.p3Pre')}<a href={teachingHref} data-astro-reload={reload(teachingHref) ? '' : undefined}>{t('pages.about.p3Link')}</a>{t('pages.about.p3Post')}</p>
    <p>{t('pages.about.p4')}</p>
  </div>
  <div class="about-photo" data-reveal="scale" style="--reveal-delay:120ms">
    <img src="/lukasz-cutout.webp" alt="Lukasz Szumilas" width="900" height="1349" loading="eager" />
  </div>
 </div>
</Section>

<Section tone="surface">
  <div class="about-head" data-reveal>
    <p class="eyebrow">{t('pages.about.diffEyebrow')}</p>
    <h2 class="section-h2 display">{t('pages.about.diffTitle')}</h2>
  </div>
  <div class="pillars">
    {pillars.map((p, i) => (
      <article class="pillar" data-reveal="scale" style={`--reveal-delay:${i * 80}ms`}>
        <span class="pillar-icon"><Icon name={PILLAR_ICONS[i]} size={22} /></span>
        <h3 class="pillar-title">{p.title}</h3>
        <p class="muted">{p.body}</p>
      </article>
    ))}
  </div>
  <ul class="cred-row" data-reveal>
    {creds.map((c) => <li>{c}</li>)}
  </ul>
</Section>

<Section>
  <p class="eyebrow">{t('pages.about.thinkEyebrow')}</p>
  <h2 class="section-h2 display">{t('pages.about.thinkTitle')}</h2>
  <div class="page-body flow">
    <p>{t('pages.about.thinkBody')}</p>
  </div>
</Section>

<Section tone="surface">
  <div class="two-col">
    <div>
      <p class="eyebrow">{t('pages.about.doEyebrow')}</p>
      <ul class="do-list flow" role="list">
        {doItems.map((d) => <li><strong>{d.label}</strong> {d.text}</li>)}
      </ul>
    </div>
    <div>
      <p class="eyebrow">{t('pages.about.langEyebrow')}</p>
      <ul class="do-list flow" role="list">
        {langs.map((l) => <li>{l}</li>)}
      </ul>
      <div class="cv-cta">
        <CtaButton href={site.socials.linkedin} variant="secondary" external>{t('pages.about.cvCta')}</CtaButton>
      </div>
    </div>
  </div>
</Section>

<Section tone="dark">
  <div class="cta-band">
    <h2 class="section-h2 display">{t('pages.about.ctaTitle')}</h2>
    <div class="cluster">
      <CtaButton href={contactHref} reload={reload(contactHref)}>{t('pages.about.ctaBook')}</CtaButton>
      <CtaButton href={servicesHref} variant="secondary" reload={reload(servicesHref)}>{t('pages.about.ctaServices')}</CtaButton>
    </div>
  </div>
</Section>

<style>
  .page-body {
    max-width: var(--maxw-prose);
    font-size: var(--step-0);
    line-height: 1.75;
  }
  .page-body a {
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .about-intro {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    align-items: start;
  }
  .about-photo {
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: radial-gradient(120% 70% at 50% 0%, var(--accent-soft), transparent 70%), var(--surface);
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    max-width: 20rem;
    margin: 0 auto;
  }
  .about-photo img {
    display: block;
    width: 100%;
    height: auto;
  }
  @media (min-width: 820px) {
    .about-intro {
      grid-template-columns: 1.5fr 1fr;
    }
    .about-photo {
      margin: 0;
    }
  }
  .section-h2 {
    font-size: var(--step-3);
    margin-bottom: 1.25rem;
  }
  .about-head {
    margin-bottom: clamp(1.5rem, 1rem + 2vw, 2.25rem);
  }
  .about-head .section-h2 {
    margin-bottom: 0;
  }
  .pillars {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  .pillar {
    padding: clamp(1.3rem, 1rem + 1vw, 1.75rem);
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }
  .pillar-icon {
    display: inline-grid;
    place-items: center;
    width: 2.7rem;
    height: 2.7rem;
    border-radius: var(--radius);
    background: var(--accent-soft);
    color: var(--accent-text);
    margin-bottom: 0.7rem;
  }
  .pillar-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-1);
    margin-bottom: 0.4rem;
  }
  .cred-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
    padding: 0;
    list-style: none;
  }
  .cred-row li {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text);
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
  }
  .two-col {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
  }
  .do-list {
    line-height: 1.5;
  }
  .do-list li {
    color: var(--text-muted);
  }
  .cv-cta {
    margin-top: 1.5rem;
  }
  .cta-band {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-items: flex-start;
  }
  @media (min-width: 720px) {
    .two-col {
      grid-template-columns: 1fr 1fr;
    }
    .pillars {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
