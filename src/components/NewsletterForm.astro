---
import { site } from '../data/site';

interface Props {
  variant?: 'inline' | 'card';
}
const { variant = 'inline' } = Astro.props;
// Posts to the Kit/ConvertKit form from site config. While the id is unset the
// form is dormant (submit disabled + a note) — set site.newsletter.kitFormId to
// activate it.
const formId = site.newsletter.kitFormId;
const KIT_ACTION = formId ? `https://app.kit.com/forms/${formId}/subscriptions` : undefined;
---

<form class:list={['nl-form', `nl-${variant}`]} action={KIT_ACTION} method="post">
  <label class="visually-hidden" for={`nl-email-${variant}`}>Email address</label>
  <input
    id={`nl-email-${variant}`}
    class="nl-input"
    type="email"
    name="email_address"
    required
    placeholder="you@company.com"
    autocomplete="email"
    disabled={!formId}
  />
  <button type="submit" class="nl-submit" data-analytics="newsletter_submit" disabled={!formId}>
    Subscribe
  </button>
</form>
{!formId && (
  <p class="nl-dormant muted">
    Sign-up opens soon — <a href={site.socials.linkedin} target="_blank" rel="noopener noreferrer">follow on LinkedIn</a> in the meantime.
  </p>
)}

<style>
  .nl-form {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .nl-input {
    flex: 1 1 16rem;
    min-width: 0;
    padding: 0.8rem 1rem;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--border-strong);
    background: var(--card);
    color: var(--text);
    transition: border-color var(--dur);
  }
  .nl-input:focus-visible {
    border-color: var(--accent);
    outline: none;
  }
  .nl-submit {
    padding: 0.8rem 1.5rem;
    border-radius: var(--radius-pill);
    background: var(--accent);
    color: var(--accent-contrast);
    font-weight: 600;
    transition: background var(--dur), transform var(--dur);
  }
  .nl-submit:hover {
    background: var(--accent-hover);
    transform: translateY(-1px);
  }
  .nl-card .nl-input {
    background: var(--bg);
  }
  .nl-input:disabled,
  .nl-submit:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }
  .nl-submit:disabled:hover {
    background: var(--accent);
    transform: none;
  }
  .nl-dormant {
    margin-top: 0.7rem;
    font-size: var(--step--1);
  }
  .nl-dormant a {
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
