---
interface Props {
  eyebrow?: string;
  title: string;
}
const { eyebrow, title } = Astro.props;
---

<header class="page-header">
  <div class="container container-narrow">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="page-title display">{title}</h1>
    <div class="page-lead lead"><slot /></div>
  </div>
</header>

<style>
  .page-header {
    /* extra top space clears the top-docked nav before it slides to the bottom */
    padding-block: clamp(5rem, 3.75rem + 3vw, 6.5rem) 0;
  }
  .page-title {
    font-size: var(--step-4);
    margin-bottom: 0.6rem;
  }
  .page-lead {
    max-width: 60ch;
  }
</style>
