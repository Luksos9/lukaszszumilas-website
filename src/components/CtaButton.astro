---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'md' | 'lg';
  external?: boolean;
  /** Show the animated trailing arrow. Defaults on for primary + ghost. */
  arrow?: boolean;
  /** Optional analytics event name (fires via the global tracker on click). */
  analytics?: string;
  class?: string;
}

const { href, variant = 'primary', size = 'md', external = false, arrow, analytics, class: cls = '' } =
  Astro.props;
const showArrow = arrow ?? variant !== 'secondary';
const target = external ? '_blank' : undefined;
const rel = external ? 'noopener noreferrer' : undefined;
---

<a
  href={href}
  class:list={['btn', `btn--${variant}`, `btn--${size}`, cls]}
  target={target}
  rel={rel}
  data-analytics={analytics}
>
  <span class="btn-label"><slot /></span>
  {showArrow && <span class="btn-arrow" aria-hidden="true">→</span>}
</a>

<style>
  .btn {
    position: relative;
    z-index: 0;
    overflow: hidden;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
    font-weight: 600;
    line-height: 1;
    border-radius: var(--radius-pill);
    padding: 0.85em 1.5em;
    border: 1.5px solid transparent;
    white-space: nowrap;
    isolation: isolate;
    transition: transform var(--dur) var(--ease), color var(--dur), border-color var(--dur),
      box-shadow var(--dur);
  }
  .btn-label,
  .btn-arrow {
    position: relative;
    z-index: 2;
  }
  .btn--lg {
    padding: 1em 1.8em;
    font-size: var(--step-1);
  }
  .btn:active {
    transform: translateY(1px);
  }
  .btn-arrow {
    transition: transform var(--dur) var(--ease);
  }
  .btn:hover .btn-arrow {
    transform: translateX(4px);
  }

  /* PRIMARY — "fill from the corner" morph (frosted panel sweeps in) */
  .btn--primary {
    background: transparent;
    color: var(--accent-contrast);
  }
  .btn--primary::before {
    /* the solid orange body */
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: var(--accent);
    border-radius: inherit;
    transition: background var(--dur);
  }
  .btn--primary::after {
    /* dark panel that sweeps in from the corner on hover -> darkens the button */
    content: '';
    position: absolute;
    bottom: 0;
    right: 0;
    z-index: 1;
    width: 2.4em;
    height: 2.4em;
    transform: translate(28%, 48%);
    background: rgba(0, 0, 0, 0.28);
    border-radius: var(--radius-pill);
    opacity: 0;
    transition: transform 0.5s var(--ease), width 0.5s var(--ease), height 0.5s var(--ease),
      border-radius 0.5s var(--ease), opacity 0.3s var(--ease);
  }
  .btn--primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 26px rgba(0, 0, 0, 0.4);
  }
  .btn--primary:hover::after {
    transform: translate(0, 0);
    width: 100%;
    height: 100%;
    border-radius: inherit;
    opacity: 1;
  }
  .btn--primary:active {
    transform: translateY(0);
  }

  /* SECONDARY — glass outline, accent fills from the corner on hover */
  .btn--secondary {
    background: color-mix(in srgb, var(--card) 55%, transparent);
    color: var(--text);
    border-color: var(--border-strong);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }
  .btn--secondary::after {
    content: '';
    position: absolute;
    bottom: 0;
    right: 0;
    z-index: 0;
    width: 2.2em;
    height: 2.2em;
    transform: translate(28%, 48%);
    background: rgba(0, 0, 0, 0.22);
    border-radius: var(--radius-pill);
    opacity: 0;
    transition: transform 0.5s var(--ease), width 0.5s var(--ease), height 0.5s var(--ease),
      border-radius 0.5s var(--ease), opacity 0.3s var(--ease);
  }
  .btn--secondary:hover {
    transform: translateY(-2px);
    border-color: var(--border-strong);
  }
  .btn--secondary:hover::after {
    transform: translate(0, 0);
    width: 100%;
    height: 100%;
    border-radius: inherit;
    opacity: 1;
  }
  .btn--secondary:active {
    transform: translateY(0);
  }

  /* GHOST — "Learn more" text link with an underline that draws in */
  .btn--ghost {
    background: transparent;
    color: var(--text);
    padding-inline: 0.25em;
    border-radius: 0;
    overflow: visible;
  }
  .btn--ghost::after {
    content: '';
    position: absolute;
    left: 0.25em;
    right: 1.7em;
    bottom: 0.2em;
    height: 1.5px;
    background: var(--accent);
    transform: scaleX(0.18);
    transform-origin: left;
    transition: transform 0.35s var(--ease);
  }
  .btn--ghost:hover {
    color: var(--accent-text);
  }
  .btn--ghost:hover::after {
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn,
    .btn::before,
    .btn::after,
    .btn-arrow {
      transition: none !important;
    }
    .btn:hover {
      transform: none;
    }
    .btn:hover .btn-arrow {
      transform: none;
    }
  }
</style>
