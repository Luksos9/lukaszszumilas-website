---
// Hero backdrop: a faint blueprint dot-grid + a ServiceNow/AI "workflow loop"
// that FRAMES the content rather than crossing it. The circuit traces a rounded
// rectangle around the perimeter (nodes = process steps, glowing hex = AI hub),
// with orange "data" pulses orbiting the frame. A frame-shaped mask keeps the
// centre — where the headline and the person sit — completely clear, and the
// side rails only appear on wide screens where real gutters exist. The dot-grid
// fades out of the centre too. Behind the hero content; dual-theme; reduced-motion safe.
const hex = (cx: number, cy: number, r: number) => {
  const a = 0.866 * r;
  const b = 0.5 * r;
  return `M${cx} ${cy - r} L${cx + a} ${cy - b} L${cx + a} ${cy + b} L${cx} ${cy + r} L${cx - a} ${cy + b} L${cx - a} ${cy - b} Z`;
};

// Rounded-rectangle "track" hugging the viewBox perimeter. Sized tall enough that
// its top line sits in the margin above the headline and its bottom line in the
// margin below it, so the loop ENCLOSES the content rather than crossing it.
const TRACK =
  'M214 70 H1386 Q1452 70 1452 136 V474 Q1452 540 1386 540 H214 Q148 540 148 474 V136 Q148 70 214 70 Z';
// The track split into two halves so two pulses orbit it (clockwise).
const FLOW_TOP = 'M148 305 V136 Q148 70 214 70 H1386 Q1452 70 1452 136 V305';
const FLOW_BOTTOM = 'M1452 305 V474 Q1452 540 1386 540 H214 Q148 540 148 474 V305';

type Node = { t: 'rect' | 'circle' | 'hex'; x: number; y: number; r?: number; s?: number };
// Process nodes sitting on the track. Side nodes (y in the mid-band) only show on
// wide screens; top/bottom nodes show whenever the loop is visible.
const NODES: Node[] = [
  { t: 'circle', x: 420, y: 70, r: 6 }, // top
  { t: 'circle', x: 760, y: 70, r: 4 }, // top
  { t: 'rect', x: 1452, y: 210, s: 22 }, // right rail (gutter)
  { t: 'circle', x: 1452, y: 360, r: 6 }, // right rail (gutter)
  { t: 'hex', x: 1140, y: 540, r: 12 }, // bottom
  { t: 'circle', x: 640, y: 540, r: 6 }, // bottom
  { t: 'rect', x: 148, y: 360, s: 20 }, // left rail (gutter)
  { t: 'circle', x: 148, y: 200, r: 6 }, // left rail (gutter)
];

// Short "ports" branching OUTWARD from the track (never toward the centre).
const STUBS: { d: string; n: Node }[] = [
  { d: 'M420 70 V34', n: { t: 'circle', x: 420, y: 30, r: 3 } },
  { d: 'M1452 210 H1508', n: { t: 'rect', x: 1513, y: 205, s: 10 } },
  { d: 'M148 360 H92', n: { t: 'circle', x: 88, y: 360, r: 3 } },
];
---

<div class="hero-bg" aria-hidden="true">
  <svg viewBox="0 0 1600 560" fill="none" preserveAspectRatio="xMidYMid slice">
    <path class="hb-track" d={TRACK} />
    <g class="hb-flows">
      <path class="hb-flow" d={FLOW_TOP} pathLength="100" />
      <path class="hb-flow" d={FLOW_BOTTOM} pathLength="100" style="animation-delay:-2s" />
    </g>
    <g class="hb-stubs">
      {STUBS.map((s) => <path d={s.d} />)}
      {STUBS.map((s) =>
        s.n.t === 'rect' ? (
          <rect class="hb-node" x={s.n.x} y={s.n.y} width={s.n.s} height={s.n.s} rx="2" />
        ) : (
          <circle class="hb-node" cx={s.n.x} cy={s.n.y} r={s.n.r} />
        )
      )}
    </g>
    <g class="hb-nodes">
      {NODES.map((n) =>
        n.t === 'rect' ? (
          <rect class="hb-node" x={n.x - n.s! / 2} y={n.y - n.s! / 2} width={n.s} height={n.s} rx="4" />
        ) : n.t === 'hex' ? (
          <path class="hb-node" d={hex(n.x, n.y, n.r!)} />
        ) : (
          <circle class="hb-node" cx={n.x} cy={n.y} r={n.r} />
        )
      )}
      <!-- AI hub: glowing accent node on the top of the frame -->
      <path class="hb-node hb-acc" d={hex(1120, 70, 20)} />
      <circle class="hb-acc-dot" cx="1120" cy="70" r="5" />
    </g>
  </svg>
</div>

<style>
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    color: var(--text-muted);
  }
  /* blueprint dot-grid — cleared from the centre so it never sits under the text */
  .hero-bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, currentColor 1.1px, transparent 1.3px);
    background-size: 30px 30px;
    opacity: 0.07;
    -webkit-mask-image: radial-gradient(120% 96% at 50% 44%, transparent 0 27%, #000 66%);
    mask-image: radial-gradient(120% 96% at 50% 44%, transparent 0 27%, #000 66%);
  }
  /* the circuit frame: only on screens wide/tall enough to have margins for it */
  .hero-bg svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.62;
    /* top + bottom bands only — keeps the centre clear at every width */
    -webkit-mask-image: linear-gradient(to bottom, #000 0 13%, transparent 24% 76%, #000 87% 100%);
    mask-image: linear-gradient(to bottom, #000 0 13%, transparent 24% 76%, #000 87% 100%);
  }
  @media (max-width: 899px) {
    /* no room for a frame on stacked layouts — keep just the faint dot-grid */
    .hero-bg svg {
      display: none;
    }
  }
  @media (min-width: 1440px) {
    /* real gutters exist — add the side rails for the full loop */
    .hero-bg svg {
      -webkit-mask-image:
        linear-gradient(to bottom, #000 0 13%, transparent 24% 76%, #000 87% 100%),
        linear-gradient(to right, #000 0 10%, transparent 18% 82%, #000 90% 100%);
      -webkit-mask-composite: source-over;
      mask-image:
        linear-gradient(to bottom, #000 0 13%, transparent 24% 76%, #000 87% 100%),
        linear-gradient(to right, #000 0 10%, transparent 18% 82%, #000 90% 100%);
      mask-composite: add;
    }
  }
  .hb-track {
    stroke: currentColor;
    stroke-width: 1.2;
    opacity: 0.5;
  }
  .hb-stubs path {
    stroke: currentColor;
    stroke-width: 1.1;
    opacity: 0.42;
  }
  .hb-flow {
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 7 93;
  }
  .js .hb-flow {
    animation: hbFlow 5s linear infinite;
  }
  @keyframes hbFlow {
    from { stroke-dashoffset: 0; }
    to { stroke-dashoffset: -100; }
  }
  .hb-node {
    stroke: currentColor;
    stroke-width: 1.5;
    fill: var(--bg);
    opacity: 0.9;
  }
  .hb-acc {
    stroke: var(--accent);
    fill: var(--accent-soft);
    opacity: 1;
    filter: drop-shadow(0 0 9px var(--ring));
  }
  .hb-acc-dot {
    fill: var(--accent);
  }
  @media (prefers-reduced-motion: reduce) {
    .hb-flow {
      display: none;
    }
  }
</style>
