---
import { primaryNav } from '../data/nav';
import { site } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const norm = (p: string) => (p !== '/' && p.endsWith('/') ? p.slice(0, -1) : p);
const here = norm(path);
const isActive = (href: string) => {
  const h = norm(href);
  return h === '/' ? here === '/' : here === h || here.startsWith(h + '/');
};
const links = primaryNav.filter((i) => !i.cta);
const cta = primaryNav.find((i) => i.cta);
const homeActive = here === '/';
---

<div class="chrome" transition:persist>
  <a href="/" class="brand" aria-label={`${site.name}, home`}>
    <img class="brand-logo" src="/logo-mark.webp" alt="" width="340" height="172" fetchpriority="high" />
  </a>

  <div class="topbar-right">
    <ThemeToggle />
    <button
      class="burger"
      type="button"
      data-burger
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="site-menu"
    >
      <span class="burger-lines" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>
  </div>

  <div class="menu" id="site-menu" data-menu hidden>
    <nav class="menu-inner" aria-label="Primary">
      <a href="/" class:list={['menu-link', { 'is-active': homeActive }]}>Home</a>
      {links.map((i) => (
        <a
          href={i.href}
          class:list={['menu-link', { 'is-active': isActive(i.href) }]}
          aria-current={isActive(i.href) ? 'page' : undefined}
        >
          {i.label}
        </a>
      ))}
      {cta && (
        <a href={cta.href} class="menu-cta" data-analytics="book_menu">
          {cta.label} <span aria-hidden="true">→</span>
        </a>
      )}
    </nav>
  </div>

  <nav class="rail" data-rail aria-label="Page sections"></nav>
</div>

<script>
  // ---- Hamburger menu (chrome is transition:persist'd, so bind once) ----
  (() => {
    const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
    const menu = document.querySelector<HTMLElement>('[data-menu]');
    if (!burger || !menu || burger.dataset.bound) return;
    burger.dataset.bound = '1';
    const setOpen = (open: boolean) => {
      burger.setAttribute('aria-expanded', String(open));
      menu.hidden = !open;
      document.documentElement.classList.toggle('menu-open', open);
    };
    burger.addEventListener('click', () => setOpen(!!menu.hidden));
    menu.addEventListener('click', (e) => {
      if (e.target === menu) setOpen(false);
    });
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
  })();

  // ---- Section scroll-guide: rebuild from the current page's [data-nav] sections ----
  let railIO: IntersectionObserver | undefined;
  function buildRail() {
    const rail = document.querySelector<HTMLElement>('[data-rail]');
    if (!rail) return;
    const sections = Array.from(document.querySelectorAll<HTMLElement>('[data-nav]'));
    rail.replaceChildren();
    if (sections.length < 2) {
      rail.dataset.empty = '1';
      return;
    }
    delete rail.dataset.empty;
    const dots = sections.map((sec) => {
      const a = document.createElement('a');
      a.href = '#' + sec.id;
      a.className = 'rail-dot';
      const label = sec.getAttribute('data-nav') || '';
      a.setAttribute('aria-label', label);
      const tip = document.createElement('span');
      tip.className = 'rail-tip';
      tip.textContent = label;
      const mark = document.createElement('i');
      mark.className = 'rail-mark';
      a.append(tip, mark);
      rail.appendChild(a);
      return a;
    });
    if (railIO) railIO.disconnect();
    railIO = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            const idx = sections.indexOf(e.target as HTMLElement);
            dots.forEach((d, i) => d.classList.toggle('is-active', i === idx));
          }
        });
      },
      { rootMargin: '-45% 0px -45% 0px', threshold: 0 }
    );
    sections.forEach((s) => railIO!.observe(s));
  }
  document.addEventListener('astro:page-load', buildRail);

  // ---- Keep the menu's active link in sync (persisted menu) ----
  function syncMenu() {
    const n = (p: string) => (p !== '/' && p.endsWith('/') ? p.slice(0, -1) : p);
    const here = n(location.pathname);
    document.querySelectorAll<HTMLAnchorElement>('.menu-link[href]').forEach((a) => {
      const href = n(new URL(a.href).pathname);
      const active = href === '/' ? here === '/' : here === href || here.startsWith(href + '/');
      a.classList.toggle('is-active', active);
    });
  }
  document.addEventListener('astro:page-load', syncMenu);
</script>

<style>
  /* the persisted wrapper itself takes no space; its children are fixed */
  .chrome {
    display: contents;
  }

  /* brand mark, top-left */
  .brand {
    position: fixed;
    top: clamp(0.85rem, 0.6rem + 1vw, 1.25rem);
    left: clamp(0.9rem, 0.6rem + 1.5vw, 1.6rem);
    z-index: 90;
  }
  .brand-logo {
    display: block;
    height: clamp(2rem, 1.6rem + 1vw, 2.5rem);
    width: auto;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow);
  }

  /* top-right control group: theme toggle + hamburger (always visible) */
  .topbar-right {
    position: fixed;
    top: clamp(0.85rem, 0.6rem + 1vw, 1.25rem);
    right: clamp(0.9rem, 0.6rem + 1.5vw, 1.6rem);
    z-index: 92;
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .burger {
    display: grid;
    place-items: center;
    width: 2.9rem;
    height: 2.9rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--surface) 82%, transparent);
    border: 1px solid var(--border-strong);
    box-shadow: var(--shadow);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    transition: transform var(--dur) var(--ease), border-color var(--dur) var(--ease);
  }
  .burger:hover {
    transform: translateY(-1px);
    border-color: var(--accent);
  }
  .burger-lines {
    display: grid;
    gap: 5px;
  }
  .burger-lines span {
    display: block;
    width: 20px;
    height: 2px;
    border-radius: 2px;
    background: var(--text);
    transition: transform var(--dur) var(--ease), opacity var(--dur) var(--ease);
  }
  .burger[aria-expanded='true'] .burger-lines span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .burger[aria-expanded='true'] .burger-lines span:nth-child(2) {
    opacity: 0;
  }
  .burger[aria-expanded='true'] .burger-lines span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* full-screen menu overlay */
  .menu {
    position: fixed;
    inset: 0;
    z-index: 91;
    display: grid;
    place-items: center;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    -webkit-backdrop-filter: blur(16px) saturate(1.2);
    backdrop-filter: blur(16px) saturate(1.2);
    animation: menuIn 0.32s var(--ease-out);
  }
  .menu[hidden] {
    display: none;
  }
  @keyframes menuIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  .menu-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    text-align: center;
    padding: 2rem;
  }
  .menu-link {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-2);
    line-height: 1.25;
    color: var(--text-muted);
    padding: 0.25rem 1rem;
    transition: color var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .menu-link:hover {
    color: var(--text);
    transform: translateY(-1px);
  }
  .menu-link.is-active {
    color: var(--accent-text);
  }
  .menu-cta {
    margin-top: 1.1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--accent);
    color: var(--accent-contrast);
    font-weight: 700;
    padding: 0.8rem 1.5rem;
    border-radius: var(--radius-pill);
    transition: background var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .menu-cta:hover {
    background: var(--accent-hover);
    transform: translateY(-2px);
  }

  /* section scroll-guide, right edge */
  .rail {
    position: fixed;
    top: 50%;
    right: clamp(0.6rem, 0.2rem + 1vw, 1.2rem);
    transform: translateY(-50%);
    z-index: 80;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.85rem;
  }
  .rail[data-empty] {
    display: none;
  }
  .rail-dot {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.55rem;
    cursor: pointer;
    padding: 0.15rem 0;
  }
  .rail-mark {
    display: block;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1.5px solid var(--border-strong);
    background: transparent;
    transition: transform var(--dur) var(--ease), background var(--dur) var(--ease),
      border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .rail-dot:hover .rail-mark {
    border-color: var(--accent);
  }
  .rail-dot.is-active .rail-mark {
    background: var(--accent);
    border-color: var(--accent);
    transform: scale(1.3);
    box-shadow: 0 0 0 4px var(--accent-soft);
  }
  .rail-tip {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.6rem;
    font-weight: 700;
    color: var(--text-subtle);
    white-space: nowrap;
    opacity: 0;
    transform: translateX(6px);
    transition: opacity var(--dur) var(--ease), transform var(--dur) var(--ease);
    pointer-events: none;
  }
  .rail-dot:hover .rail-tip,
  .rail-dot.is-active .rail-tip {
    opacity: 1;
    transform: none;
  }
  .rail-dot.is-active .rail-tip {
    color: var(--accent-text);
  }

  /* lock background scroll while the menu is open */
  :global(html.menu-open) {
    overflow: hidden;
  }

  /* mobile: only the hamburger — hide brand + section rail */
  @media (max-width: 768px) {
    .brand,
    .rail {
      display: none;
    }
  }
</style>
