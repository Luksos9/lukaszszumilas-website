---
import BaseLayout from '../layouts/BaseLayout.astro';
import Teaching from '../components/pages/Teaching.astro';
import { useTranslations } from '../i18n/ui';

const lang = 'en' as const;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} locales={['en', 'pl']} title="Teaching" description={t('pages.teaching.metaDescription')}>
  <Teaching lang={lang} />
</BaseLayout>
