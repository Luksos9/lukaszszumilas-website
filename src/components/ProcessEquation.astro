---
// Signature visual: AI is a multiplier, not a fix. Same AI, two processes, two outcomes.
import { useTranslations, defaultLang, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}
const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const rows = [
  { process: t('home.equation.broken'), result: t('home.equation.chaos'), tone: 'bad' },
  { process: t('home.equation.good'), result: t('home.equation.impact'), tone: 'good' },
];
---

<div class="eq" data-reveal>
  {rows.map((r, i) => (
    <div class:list={['eq-row', `eq-row--${r.tone}`]} data-reveal style={`--reveal-delay:${i * 140}ms`}>
      <span class="eq-term">{r.process}</span>
      <span class="eq-op" aria-hidden="true">×</span>
      <span class="eq-ai">AI</span>
      <span class="eq-op" aria-hidden="true">=</span>
      <span class="eq-result">{r.result}</span>
      <span class="eq-viz" aria-hidden="true">
        {r.tone === 'bad' ? (
          <svg viewBox="0 0 64 36" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <path class="viz-path" d="M3 26 C 11 6 15 31 23 16 C 29 5 33 32 41 17 C 47 7 51 30 61 12" />
          </svg>
        ) : (
          <svg viewBox="0 0 64 36" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <path class="viz-path" d="M3 31 L20 31 L36 17 L60 5 M60 5 L52 5 M60 5 L60 13" />
          </svg>
        )}
      </span>
    </div>
  ))}
</div>

<style>
  .eq {
    display: grid;
    gap: 0.9rem;
    max-width: 48rem;
    margin: 2rem auto 0;
  }
  .eq-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.55rem 0.9rem;
    padding: clamp(1rem, 2vw, 1.4rem) clamp(1.1rem, 2.5vw, 1.6rem);
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--card);
    text-align: center;
  }
  .eq-row--good {
    border-color: var(--accent-text);
    background: var(--accent-soft);
  }
  .eq-term {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-1);
    color: var(--text);
  }
  .eq-ai {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: var(--step-0);
    letter-spacing: 0.04em;
    color: var(--accent-text);
    padding: 0.15rem 0.55rem;
    border-radius: var(--radius-pill);
    background: var(--accent-soft);
  }
  .eq-op {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: var(--step-1);
    color: var(--text-subtle);
  }
  .eq-result {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
    color: var(--text-muted);
  }
  .eq-row--good .eq-result {
    color: var(--accent-text);
  }
  /* outcome visual: a tangled scribble for chaos, a clean rising arrow for impact */
  .eq-viz {
    display: inline-flex;
    flex: 0 0 auto;
    color: var(--text-subtle);
  }
  .eq-viz svg {
    width: 64px;
    height: 36px;
    display: block;
  }
  .eq-row--good .eq-viz {
    color: var(--accent-text);
  }
  .js .eq-viz .viz-path {
    stroke-dasharray: 220;
    stroke-dashoffset: 220;
  }
  .eq-row.is-visible .viz-path {
    animation: vizDraw 1s var(--ease-out) 0.35s forwards;
  }
  @keyframes vizDraw {
    to {
      stroke-dashoffset: 0;
    }
  }
  .js .eq-result {
    transform: scale(0.8);
    opacity: 0;
  }
  .eq-row.is-visible .eq-result {
    animation: eqPop 0.55s var(--ease-spring) 0.2s forwards;
  }
  @keyframes eqPop {
    to {
      transform: scale(1);
      opacity: 1;
    }
  }
  .eq-row--good.is-visible {
    animation: eqGlow 1.5s var(--ease-out) 0.5s 1;
  }
  @keyframes eqGlow {
    0%,
    100% {
      box-shadow: 0 0 0 0 transparent;
    }
    45% {
      box-shadow: 0 0 26px -4px var(--ring);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .js .eq-result {
      transform: none;
      opacity: 1;
    }
    .eq-row.is-visible .eq-result,
    .eq-row--good.is-visible {
      animation: none;
    }
    .js .eq-viz .viz-path {
      stroke-dashoffset: 0;
    }
    .eq-row.is-visible .viz-path {
      animation: none;
    }
  }
</style>
