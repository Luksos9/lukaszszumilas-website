---
// Line-art illustration for a Training category. Matches Icon.astro conventions:
// currentColor strokes + exactly one .illo-accent shape; dual-theme, static.
interface Props {
  illo: string;
  class?: string;
}
const { illo, class: cls = '' } = Astro.props;
---

<svg
  class:list={['t-illo', cls]}
  viewBox="0 0 72 56"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {illo === 'workshops' && (
    <Fragment>
      <rect x="12" y="6" width="48" height="27" rx="3" />
      <path class="illo-accent" d="M19 14h22" />
      <path d="M19 21h34M19 27h26" />
      <circle cx="22" cy="46" r="3.2" /><path d="M16 54a6 6 0 0 1 12 0" />
      <circle cx="36" cy="46" r="3.2" /><path d="M30 54a6 6 0 0 1 12 0" />
      <circle cx="50" cy="46" r="3.2" /><path d="M44 54a6 6 0 0 1 12 0" />
    </Fragment>
  )}
  {illo === 'best-practice' && (
    <Fragment>
      <rect x="16" y="5" width="40" height="46" rx="4" />
      <path class="illo-accent" d="M22 15l3 3 5-6" />
      <path d="M34 16h14" />
      <path d="M22 27l3 3 5-6" />
      <path d="M34 28h14" />
      <path d="M22 39l3 3 5-6" />
      <path d="M34 40h10" />
    </Fragment>
  )}
  {illo === 'ai-adoption' && (
    <Fragment>
      <path class="illo-accent" d="M15 16l2.4 7.4L25 26l-7.6 2.6L15 36l-2.4-7.4L5 26l7.6-2.6z" />
      <path d="M30 28h11M37 23.5l5 4.5-5 4.5" />
      <circle cx="55" cy="28" r="8" /><circle cx="55" cy="28" r="3" />
      <path d="M55 16.5v3.5M55 36v3.5M64.5 28h3.5M42 28h3.5M61.6 21.4l2.5-2.5M46.4 32.1l2.5-2.5M61.6 34.6l2.5 2.5M46.4 23.9l2.5 2.5" />
    </Fragment>
  )}
  {illo === 'enablement' && (
    <Fragment>
      <circle cx="28" cy="16" r="6.5" />
      <path d="M16 46c0-8 5.5-13 12-13s12 5 12 13" />
      <path class="illo-accent" d="M52 48V20M46 28l6-8 6 8" />
    </Fragment>
  )}
</svg>

<style>
  .t-illo {
    width: 100%;
    height: auto;
    max-width: 76px;
    color: var(--text);
  }
  .illo-accent {
    stroke: var(--accent);
  }
</style>
