---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import CtaButton from '../components/CtaButton.astro';
import StatBadge from '../components/StatBadge.astro';
import ServiceCard from '../components/ServiceCard.astro';
import PostCard from '../components/PostCard.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { site } from '../data/site';
import { services } from '../data/services';

// Flip to true once a headshot exists at /public/lukasz.jpg (or update the path).
const HAS_HEADSHOT = false;
const HEADSHOT = '/lukasz.jpg';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  jobTitle: 'ServiceNow & AI Consultant',
  description: site.description,
  sameAs: [site.socials.linkedin, site.socials.udemy, site.socials.github],
  knowsAbout: ['ServiceNow', 'Governed AI', 'Model Context Protocol', 'ITSM', 'CMDB', 'CSDM', 'AI Agents'],
};
---

<BaseLayout jsonLd={personJsonLd}>
  <!-- HERO -->
  <section class="hero">
    <div class:list={['container', 'hero-grid', { 'has-photo': HAS_HEADSHOT }]}>
      <div class="hero-text">
        <p class="eyebrow">ServiceNow &amp; AI consulting</p>
        <h1 class="hero-title display">I Help Companies Improve Operations with AI &amp; ServiceNow</h1>
        <p class="hero-lead lead">
          From ServiceNow implementations and workflow automation to AI solutions that save time,
          reduce manual work, and improve productivity.
        </p>
        <div class="hero-cta cluster">
          <CtaButton href="/contact/" size="lg">Book a consultation</CtaButton>
          <CtaButton href="/blog/" variant="secondary" size="lg">Read the articles</CtaButton>
        </div>
        <div class="hero-proof">
          <StatBadge value="17+" label="ServiceNow certs, first try" />
          <span class="trust-div" aria-hidden="true"></span>
          <StatBadge value="10,000+" label="students taught" />
          <span class="trust-div" aria-hidden="true"></span>
          <StatBadge value="4+ yrs" label="enterprise delivery" />
        </div>
        <p class="hero-sectors muted">
          Enterprise experience across banking, insurance, and manufacturing.
        </p>
      </div>
      {HAS_HEADSHOT && (
        <div class="hero-photo">
          <img src={HEADSHOT} alt="Lukasz Szumilas" width="440" height="520" />
        </div>
      )}
    </div>
  </section>

  <!-- SERVICES OVERVIEW -->
  <Section>
    <div class="section-head">
      <div>
        <p class="eyebrow">Services</p>
        <h2 class="section-h2 display">What I do</h2>
      </div>
      <a href="/services/" class="see-all">All services →</a>
    </div>
    <div class="grid-services">
      {services.map((s) => (
        <ServiceCard title={s.title} tagline={s.tagline} anchor={s.anchor} />
      ))}
    </div>
  </Section>

  <!-- AI DIFFERENTIATOR BAND -->
  <Section tone="dark">
    <div class="ai-band">
      <p class="eyebrow">The differentiator</p>
      <h2 class="section-h2 display">Governed AI on ServiceNow</h2>
      <p class="ai-lead">
        Most AI on ServiceNow stops at the demo. I take it to production: MCP done right, with
        agents that do only what they're allowed to and data that stays where it belongs.
      </p>
      <CtaButton href="/ai-servicenow/">How I do it →</CtaButton>
    </div>
  </Section>

  <!-- WHY WORK WITH ME -->
  <Section tone="surface">
    <p class="eyebrow">Why work with me</p>
    <h2 class="section-h2 display">Enterprise-grade, and I can explain it</h2>
    <div class="grid-why">
      <article class="why-card">
        <h3 class="why-title">Enterprise experience</h3>
        <p class="muted">4+ years delivering ServiceNow for banks, insurers, and manufacturers, in environments with real security review.</p>
      </article>
      <article class="why-card">
        <h3 class="why-title">Educator</h3>
        <p class="muted">10,000+ students learn certification prep from my courses. Teaching keeps the fundamentals sharp and the explanations clear.</p>
      </article>
      <article class="why-card">
        <h3 class="why-title">Technical expertise</h3>
        <p class="muted">17 ServiceNow certifications, every one passed on the first attempt, plus the AI track.</p>
      </article>
    </div>
  </Section>

  <!-- LATEST ARTICLES -->
  <Section>
    <div class="section-head">
      <div>
        <p class="eyebrow">Writing</p>
        <h2 class="section-h2 display">Latest articles</h2>
      </div>
      <a href="/blog/" class="see-all">All posts →</a>
    </div>
    {posts.length > 0 ? (
      <div class="grid-posts">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    ) : (
      <p class="muted">New articles are landing soon.</p>
    )}
  </Section>

  <!-- NEWSLETTER -->
  <Section tone="dark">
    <div class="nl-band">
      <p class="eyebrow">Newsletter</p>
      <h2 class="section-h2 display">{site.newsletterName}</h2>
      <p class="ai-lead">Practical ServiceNow and AI in your inbox. Only when I have something worth your time.</p>
      <NewsletterForm variant="card" />
      <p class="muted nl-note">No spam. Unsubscribe anytime.</p>
    </div>
  </Section>

  <!-- CONTACT CTA -->
  <Section>
    <div class="contact-cta">
      <h2 class="section-h2 display">Let's discuss your project</h2>
      <p class="lead">Tell me what you're working on. I'll tell you honestly whether I'm the right person for it.</p>
      <div class="cluster">
        <CtaButton href="/contact/" size="lg">Book a consultation</CtaButton>
        <CtaButton href="/services/" variant="secondary" size="lg">See the services</CtaButton>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(3rem, 2rem + 5vw, 6rem) clamp(2rem, 1.5rem + 2vw, 3.5rem);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }
  .hero-title {
    font-size: var(--step-5);
    max-width: 16ch;
    margin-bottom: 1.1rem;
  }
  .hero-lead {
    max-width: 56ch;
    margin-bottom: 1.9rem;
  }
  .hero-cta {
    margin-bottom: 2.25rem;
  }
  .hero-proof {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 0.5rem + 2vw, 2rem);
    flex-wrap: wrap;
  }
  .trust-div {
    width: 1px;
    height: 2.5rem;
    background: var(--border-strong);
  }
  .hero-sectors {
    margin-top: 1.1rem;
    font-size: var(--step--1);
  }
  .hero-photo img {
    width: 100%;
    max-width: 26rem;
    border-radius: var(--radius-lg);
    object-fit: cover;
    box-shadow: var(--shadow-lg);
    margin-inline: auto;
  }
  .section-h2 {
    font-size: var(--step-3);
    margin-bottom: 1.25rem;
  }
  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.75rem;
  }
  .section-head .section-h2 {
    margin-bottom: 0;
  }
  .see-all {
    font-weight: 600;
    color: var(--accent);
    white-space: nowrap;
  }
  .see-all:hover {
    color: var(--accent-hover);
  }
  .grid-services,
  .grid-why,
  .grid-posts {
    display: grid;
    gap: clamp(1rem, 0.5rem + 1.5vw, 1.5rem);
    grid-template-columns: 1fr;
  }
  .ai-band,
  .nl-band,
  .contact-cta {
    max-width: 46rem;
  }
  .ai-lead {
    color: #cfc9be;
    max-width: 56ch;
    margin-bottom: 1.75rem;
    line-height: 1.6;
  }
  .why-card {
    padding: 1.5rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .why-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-1);
    margin-bottom: 0.4rem;
  }
  .nl-note {
    margin-top: 0.85rem;
    font-size: var(--step--1);
  }
  .contact-cta {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }
  @media (min-width: 640px) {
    .grid-services,
    .grid-why,
    .grid-posts {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 880px) {
    .hero-grid.has-photo {
      grid-template-columns: 1.4fr 1fr;
    }
    .grid-services {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
