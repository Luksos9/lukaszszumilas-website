---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import ClientStrip from '../components/ClientStrip.astro';
import CtaButton from '../components/CtaButton.astro';
import { site } from '../data/site';

const services = [
  {
    title: 'ServiceNow delivery',
    body: 'ITSM, Service Portal and Employee Center, CMDB and CSDM, and integrations in JavaScript and REST. Clean, supportable builds that survive an upgrade.',
  },
  {
    title: 'Governed AI on ServiceNow',
    body: 'MCP integration patterns, Now Assist, and AI Agent Studio set up with real governance. AI that passes a bank security review, not a demo that fails one.',
  },
  {
    title: 'Platform health and scripting',
    body: 'Performance, query optimization, and the scripting standards that keep an instance from turning into technical debt.',
  },
  {
    title: 'Review and second opinion',
    body: 'A focused look at an architecture, an integration, or an AI plan before you commit to it. Often the cheapest hour you will spend.',
  },
];
---

<BaseLayout title="Work with me" description="ServiceNow consulting plus governed AI: MCP integration, Now Assist, and AI Agent Studio governance for banking and insurance teams.">
  <PageHeader eyebrow="Consulting" title="Work with me">
    ServiceNow delivery plus governed AI, for teams that need it to hold up in production and in
    a security review.
  </PageHeader>

  <Section>
    <div class="grid-services">
      {services.map((s) => (
        <article class="service">
          <h2 class="service-title">{s.title}</h2>
          <p class="muted">{s.body}</p>
        </article>
      ))}
    </div>
  </Section>

  <Section tone="dark">
    <div class="ai-grid">
      <div>
        <p class="eyebrow">The AI difference</p>
        <h2 class="section-h2 display">Most AI on ServiceNow stops at the demo. I take it to production.</h2>
        <p class="ai-lead">
          The gap is governance. Connecting a model to an instance is easy. Doing it so data
          stays where it belongs, every action is auditable, and agents do only what they're
          allowed to is the part that takes real ServiceNow knowledge. That's where I work.
        </p>
        <CtaButton href="/blog/">Read how I think about it →</CtaButton>
      </div>
      <ul class="ai-list" role="list">
        <li>Anthropic Claude Partner Network, consulting track</li>
        <li>CCA-F certified</li>
        <li>MCP integration over brittle custom glue</li>
        <li>A public MCP reference repo you can inspect</li>
      </ul>
    </div>
  </Section>

  <Section tone="surface">
    <p class="eyebrow">Track record</p>
    <h2 class="section-h2 display">Delivered for</h2>
    <ClientStrip />
    <p class="muted proof-note">
      Engagements through consulting partners including Accenture, Reply, CoolPeople, and Nelem,
      in banking and insurance.
    </p>
  </Section>

  <Section>
    <div class="cta-band">
      <h2 class="section-h2 display">Have a ServiceNow or AI problem worth solving?</h2>
      <p class="lead">Tell me what you're working on. I'll tell you honestly whether I'm the right person for it.</p>
      <div class="cluster">
        <CtaButton href="/contact/" size="lg">Get in touch</CtaButton>
        <CtaButton href={site.socials.linkedin} variant="secondary" size="lg" external>Connect on LinkedIn</CtaButton>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .section-h2 {
    font-size: var(--step-3);
    margin-bottom: 1.25rem;
  }
  .grid-services {
    display: grid;
    gap: clamp(1rem, 0.5rem + 1.5vw, 1.75rem);
    grid-template-columns: 1fr;
  }
  .service {
    padding: clamp(1.4rem, 1rem + 1.2vw, 2rem);
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }
  .service-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-2);
    margin-bottom: 0.6rem;
    letter-spacing: -0.01em;
  }
  .ai-grid {
    display: grid;
    gap: 2rem clamp(1.5rem, 1rem + 3vw, 4rem);
    grid-template-columns: 1fr;
    align-items: start;
  }
  .ai-lead {
    color: #cfc9be;
    max-width: 54ch;
    margin-bottom: 1.75rem;
    line-height: 1.6;
  }
  .ai-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .ai-list li {
    padding-left: 1.6rem;
    position: relative;
    color: var(--on-dark);
  }
  .ai-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 700;
  }
  .proof-note {
    margin-top: 1.1rem;
    font-size: var(--step--1);
    max-width: 60ch;
  }
  .cta-band {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    align-items: flex-start;
    max-width: 46rem;
  }
  @media (min-width: 640px) {
    .grid-services {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 720px) {
    .ai-grid {
      grid-template-columns: 1.3fr 1fr;
    }
  }
</style>
