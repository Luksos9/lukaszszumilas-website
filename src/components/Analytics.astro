---
import { site } from '../data/site';
const id = site.analytics.ga4Id;
---

{
  id && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${id}`} />
      <script is:inline define:vars={{ id }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag('js', new Date());
        // Disable the automatic page_view; we send it on every astro:page-load
        // (View Transitions don't reload the page) from the helper in BaseLayout.
        gtag('config', id, { anonymize_ip: true, send_page_view: false });
        window.__GA_ID = id;
      </script>
    </>
  )
}
