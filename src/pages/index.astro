---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import CtaButton from '../components/CtaButton.astro';
import StatBadge from '../components/StatBadge.astro';
import ServiceCard from '../components/ServiceCard.astro';
import PostCard from '../components/PostCard.astro';
import ClientStrip from '../components/ClientStrip.astro';
import Framework from '../components/Framework.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { services } from '../data/services';
import { areas } from '../data/areas';
import { problems } from '../data/problems';
import { caseStudies } from '../data/caseStudies';
import { valueProps } from '../data/valueProps';

// Flip to true and drop a transparent PNG at /public/lukasz-cutout.png for the
// exact cut-out hero. Until then the framed photo is used.
const HAS_CUTOUT = false;

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  jobTitle: 'ServiceNow & AI Specialist',
  description: site.description,
  sameAs: [site.socials.linkedin, site.socials.udemy, site.socials.github],
  knowsAbout: ['ServiceNow', 'Governed AI', 'Model Context Protocol', 'ITSM', 'CMDB', 'CSDM', 'AI Agents'],
};
---

<BaseLayout jsonLd={personJsonLd}>
  <!-- 1. HERO -->
  <section class="hero">
    <span class="hero-dots" aria-hidden="true"></span>
    <div class="container hero-grid">
      <div class="hero-text">
        <p class="eyebrow" data-reveal>ServiceNow &amp; AI Specialist</p>
        <h1 class="hero-title display">
          <span data-reveal style="--reveal-delay:80ms">I Help Companies</span>
          <span data-reveal style="--reveal-delay:200ms">Improve Operations</span>
          <span data-reveal style="--reveal-delay:320ms">with <span class="accent">AI &amp; ServiceNow</span></span>
        </h1>
        <p class="hero-lead lead" data-reveal style="--reveal-delay:440ms">
          I design practical solutions that improve processes, automate work, and apply AI where
          it delivers measurable business impact.
        </p>
        <div class="hero-cta cluster" data-reveal style="--reveal-delay:560ms">
          <CtaButton href="/contact/" size="lg">Book a consultation</CtaButton>
          <CtaButton href="/services/" variant="secondary" size="lg">Explore my approach</CtaButton>
        </div>
        <div class="hero-stats" data-reveal style="--reveal-delay:680ms">
          <StatBadge value="17+" label="ServiceNow certifications" />
          <StatBadge value="10,000+" label="students trained" />
          <StatBadge value="Enterprise" label="banking, insurance, manufacturing" />
        </div>
      </div>

      <div class="hero-photo" data-reveal style="--reveal-delay:240ms">
        <img class="hero-flow" src="/hero-flow.svg" alt="" aria-hidden="true" />
        {HAS_CUTOUT ? (
          <img class="hero-cutout" src="/lukasz-cutout.png" alt="Lukasz Szumilas" width="900" height="1349" fetchpriority="high" />
        ) : (
          <div class="hero-frame">
            <img src="/lukasz.webp" alt="Lukasz Szumilas" width="900" height="1349" fetchpriority="high" />
          </div>
        )}
        <span class="hero-note">
          Practical solutions. Real impact.
          <svg class="hero-arrow" viewBox="0 0 80 50" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 6c20 28 44 36 70 30" />
            <path d="M62 30l12 6-4-13" />
          </svg>
        </span>
      </div>
    </div>
  </section>

  <!-- value-props bar -->
  <div class="valuebar">
    <div class="container valuebar-grid">
      {valueProps.map((v) => (
        <div class="vp">
          <span class="vp-icon"><Icon name={v.icon} size={20} /></span>
          <span class="vp-title">{v.title}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- 2. CONTRARIAN -->
  <Section tone="surface">
    <div class="contrarian">
      <div>
        <p class="eyebrow" data-reveal>The truth about AI</p>
        <h2 class="contrarian-title display">
          <span data-reveal>Most companies don't</span>
          <span data-reveal style="--reveal-delay:140ms">need more AI tools.</span>
        </h2>
        <p class="contrarian-sub" data-reveal style="--reveal-delay:300ms">
          They need better processes, automation, and the right AI use cases.
        </p>
      </div>
      <div class="contrarian-body" data-reveal style="--reveal-delay:200ms">
        <p>
          Plenty of teams start with AI because it's the thing to do this year. The bigger wins
          almost always come from fixing the workflow first, then adding AI where it moves a
          number you actually care about.
        </p>
        <p>That's the order I work in with every client.</p>
        <blockquote class="contrarian-quote">
          Real change happens when the technology, the process, and the people pull in the same
          direction.
        </blockquote>
      </div>
    </div>
  </Section>

  <!-- 3. FRAMEWORK -->
  <Section>
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow">My AI &amp; ServiceNow framework</p>
        <h2 class="section-h2 display">A practical path from inefficiency to impact</h2>
      </div>
    </div>
    <Framework />
  </Section>

  <!-- 4. AREAS -->
  <Section tone="surface">
    <p class="eyebrow" data-reveal>Areas I work in</p>
    <h2 class="section-h2 display" data-reveal>Where I spend my time</h2>
    <div class="grid-4">
      {areas.map((a, i) => (
        <article class="card" data-reveal style={`--reveal-delay:${i * 90}ms`}>
          <span class="card-icon"><Icon name={a.icon} /></span>
          <h3 class="card-title">{a.title}</h3>
          <p class="muted">{a.body}</p>
        </article>
      ))}
    </div>
  </Section>

  <!-- 5. PROBLEMS -->
  <Section>
    <p class="eyebrow" data-reveal>Problems I solve</p>
    <h2 class="section-h2 display" data-reveal>You're probably dealing with at least one of these</h2>
    <div class="grid-3">
      {problems.map((p, i) => (
        <article class="card" data-reveal style={`--reveal-delay:${i * 80}ms`}>
          <span class="card-icon"><Icon name={p.icon} /></span>
          <h3 class="card-title">{p.title}</h3>
          <p class="muted">{p.body}</p>
        </article>
      ))}
    </div>
  </Section>

  <!-- 6. SERVICES -->
  <Section tone="surface">
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow">How I help</p>
        <h2 class="section-h2 display">Services that drive real business impact</h2>
      </div>
      <a href="/services/" class="see-all">All services →</a>
    </div>
    <div class="grid-services">
      {services.map((s, i) => (
        <div data-reveal style={`--reveal-delay:${i * 70}ms`}>
          <ServiceCard title={s.title} tagline={s.tagline} anchor={s.anchor} icon={s.icon} />
        </div>
      ))}
    </div>
  </Section>

  <!-- 7. CASE STUDIES -->
  <Section>
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow">Selected work</p>
        <h2 class="section-h2 display">Real impact in the enterprise</h2>
      </div>
      <a href="/case-studies/" class="see-all">All case studies →</a>
    </div>
    <div class="grid-3">
      {caseStudies.map((c, i) => (
        <a href="/case-studies/" class="case" data-reveal style={`--reveal-delay:${i * 90}ms`}>
          <span class="case-sector">{c.sector}</span>
          <h3 class="case-title">{c.title}</h3>
          <p class="case-summary">{c.summary}</p>
          <span class="case-cta">Read case study →</span>
        </a>
      ))}
    </div>
    <p class="muted case-note">Anonymized. Specifics shared under NDA on a call.</p>
  </Section>

  <!-- 8. WHY TRUST ME (static) -->
  <Section tone="surface">
    <p class="eyebrow">Why organizations trust me</p>
    <h2 class="section-h2 display">Proof, not promises</h2>
    <div class="trust-stats">
      <StatBadge value="17+" label="ServiceNow certifications" />
      <StatBadge value="10,000+" label="students taught worldwide" />
      <StatBadge value="4+ yrs" label="enterprise project experience" />
    </div>
    <ul class="trust-points" role="list">
      <li><strong>Enterprise experience.</strong> Banking, insurance, and manufacturing.</li>
      <li><strong>Educator.</strong> 10,000+ students through Lucky X courses.</li>
      <li><strong>Speaker and content creator.</strong> Sharing practical ServiceNow and AI knowledge.</li>
    </ul>
  </Section>

  <!-- 9. INSIGHTS -->
  <Section>
    <div class="section-head" data-reveal>
      <div>
        <p class="eyebrow">Latest insights</p>
        <h2 class="section-h2 display">Practical writing on ServiceNow &amp; AI</h2>
      </div>
      <a href="/blog/" class="see-all">All articles →</a>
    </div>
    {posts.length > 0 ? (
      <div class="grid-3">
        {posts.map((post, i) => (
          <div data-reveal style={`--reveal-delay:${i * 90}ms`}>
            <PostCard post={post} />
          </div>
        ))}
      </div>
    ) : (
      <p class="muted">New articles are landing soon.</p>
    )}
  </Section>

  <!-- 10. FINAL CTA -->
  <section class="final-cta">
    <span class="final-dots" aria-hidden="true"></span>
    <div class="container final-cta-inner" data-reveal>
      <div>
        <h2 class="final-cta-title display">Let's discuss your next ServiceNow or AI initiative</h2>
        <p class="final-cta-sub">
          Book a free consultation call and we'll find where AI and a better process actually move
          the needle for you.
        </p>
      </div>
      <CtaButton href="/contact/" size="lg">Book a consultation</CtaButton>
    </div>
  </section>
</BaseLayout>

<style>
  /* HERO */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 5rem) clamp(1.5rem, 1rem + 2vw, 3rem);
  }
  .hero-dots {
    position: absolute;
    inset: auto -60px -60px auto;
    width: 320px;
    height: 320px;
    background-image: radial-gradient(var(--accent) 1.2px, transparent 1.2px);
    background-size: 16px 16px;
    opacity: 0.18;
    -webkit-mask-image: radial-gradient(closest-side, #000, transparent);
    mask-image: radial-gradient(closest-side, #000, transparent);
    pointer-events: none;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
    position: relative;
  }
  .hero-title {
    font-size: var(--step-5);
    margin-bottom: 1.1rem;
    line-height: 1.04;
  }
  .hero-title span {
    display: block;
  }
  .hero-title .accent {
    display: inline;
    color: var(--accent);
  }
  .hero-lead {
    max-width: 50ch;
    margin-bottom: 1.9rem;
  }
  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1rem, 0.5rem + 2vw, 2rem);
    align-items: center;
  }
  .hero-photo {
    position: relative;
    justify-self: center;
    width: 100%;
    max-width: 26rem;
  }
  .hero-flow {
    position: absolute;
    inset: -8% -14% -2% -14%;
    width: 128%;
    height: auto;
    z-index: 0;
    pointer-events: none;
  }
  .hero-frame {
    position: relative;
    z-index: 1;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--border-strong);
    box-shadow: var(--shadow-lg);
  }
  .hero-frame img,
  .hero-cutout {
    width: 100%;
    display: block;
  }
  .hero-frame::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 34%;
    background: linear-gradient(transparent, color-mix(in srgb, var(--bg) 88%, transparent));
  }
  .hero-cutout {
    position: relative;
    z-index: 1;
    filter: drop-shadow(0 18px 40px rgba(0, 0, 0, 0.5));
  }
  .hero-note {
    position: absolute;
    top: 0.5rem;
    left: -0.5rem;
    z-index: 2;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--step-0);
    color: var(--text-muted);
    display: none;
  }
  .hero-arrow {
    position: absolute;
    top: 1.6rem;
    left: 0.5rem;
    width: 70px;
    height: 44px;
    color: var(--accent);
    transform: scaleX(-1);
  }
  /* VALUE BAR */
  .valuebar {
    border-block: 1px solid var(--border);
    background: var(--surface);
  }
  .valuebar-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem 1.5rem;
    padding-block: 1.5rem;
  }
  .vp {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }
  .vp-icon {
    display: inline-grid;
    place-items: center;
    flex: 0 0 auto;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: var(--radius-sm);
    background: var(--accent-soft);
    color: var(--accent);
  }
  .vp-title {
    font-size: var(--step--1);
    color: var(--text-muted);
    line-height: 1.3;
  }
  /* CONTRARIAN */
  .contrarian {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  .contrarian-title {
    font-size: var(--step-4);
    line-height: 1.05;
  }
  .contrarian-title span {
    display: block;
  }
  .contrarian-sub {
    margin-top: 1rem;
    font-size: var(--step-1);
    font-weight: 600;
    color: var(--accent);
    max-width: 28ch;
  }
  .contrarian-body p {
    color: var(--text-muted);
    line-height: 1.7;
  }
  .contrarian-body p + p {
    margin-top: 1rem;
  }
  .contrarian-quote {
    margin-top: 1.5rem;
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--accent);
    background: var(--card);
    border-radius: var(--radius);
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.4;
  }
  /* SHARED */
  .section-h2 {
    font-size: var(--step-3);
    margin-bottom: 1.5rem;
  }
  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 1.75rem;
  }
  .section-head .section-h2 {
    margin-bottom: 0;
  }
  .see-all {
    font-weight: 600;
    color: var(--accent);
    white-space: nowrap;
  }
  .see-all:hover {
    color: var(--accent-hover);
  }
  .grid-3,
  .grid-4,
  .grid-services {
    display: grid;
    gap: clamp(1rem, 0.5rem + 1.5vw, 1.5rem);
    grid-template-columns: 1fr;
  }
  .card {
    padding: 1.5rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    height: 100%;
    transition: transform var(--dur) var(--ease), border-color var(--dur), box-shadow var(--dur);
  }
  .card:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
    box-shadow: var(--shadow);
  }
  .card-icon {
    display: inline-grid;
    place-items: center;
    width: 2.7rem;
    height: 2.7rem;
    border-radius: var(--radius);
    background: var(--accent-soft);
    color: var(--accent);
    margin-bottom: 0.75rem;
  }
  .card-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-1);
    margin-bottom: 0.4rem;
  }
  /* CASE STUDIES */
  .case {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    height: 100%;
    padding: 1.5rem;
    background: var(--card);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    transition: transform var(--dur) var(--ease), box-shadow var(--dur), border-color var(--dur);
  }
  .case:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: var(--accent);
  }
  .case-summary {
    color: var(--text-muted);
    font-size: var(--step--1);
    flex: 1 0 auto;
  }
  .case-sector {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: var(--step--1);
    color: var(--accent);
    font-weight: 700;
  }
  .case-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-1);
  }
  .case-cta {
    font-weight: 600;
    color: var(--accent);
    font-size: var(--step--1);
  }
  .case-note {
    margin-top: 1.25rem;
    font-size: var(--step--1);
  }
  /* TRUST */
  .trust-stats {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(1.25rem, 0.5rem + 3vw, 3rem);
    margin-bottom: 1.75rem;
  }
  .trust-points {
    display: grid;
    gap: 0.6rem;
    max-width: 60ch;
  }
  .trust-points li {
    color: var(--text-muted);
  }
  /* FINAL CTA */
  .final-cta {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(120% 140% at 80% 50%, rgba(232, 115, 58, 0.22), transparent 60%),
      var(--lx-dark);
    color: var(--lx-cream);
    padding-block: clamp(2.5rem, 1.5rem + 4vw, 4.5rem);
    margin-top: var(--section-y);
    border-top: 1px solid var(--border);
  }
  .final-dots {
    position: absolute;
    inset: -40px auto -40px -40px;
    width: 280px;
    background-image: radial-gradient(var(--accent) 1.2px, transparent 1.2px);
    background-size: 16px 16px;
    opacity: 0.16;
    -webkit-mask-image: radial-gradient(closest-side, #000, transparent);
    mask-image: radial-gradient(closest-side, #000, transparent);
    pointer-events: none;
  }
  .final-cta-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    align-items: flex-start;
  }
  .final-cta-title {
    font-size: var(--step-3);
    max-width: 22ch;
  }
  .final-cta-sub {
    margin-top: 0.6rem;
    max-width: 50ch;
    color: #cfc9be;
  }
  @media (min-width: 560px) {
    .grid-3,
    .grid-4 {
      grid-template-columns: repeat(2, 1fr);
    }
    .valuebar-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 760px) {
    .hero-note {
      display: block;
    }
    .contrarian {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }
  @media (min-width: 900px) {
    .hero-grid {
      grid-template-columns: 1.35fr 1fr;
    }
    .grid-3 {
      grid-template-columns: repeat(3, 1fr);
    }
    .grid-4 {
      grid-template-columns: repeat(4, 1fr);
    }
    .grid-services {
      grid-template-columns: repeat(3, 1fr);
    }
    .valuebar-grid {
      grid-template-columns: repeat(5, 1fr);
    }
    .final-cta-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
