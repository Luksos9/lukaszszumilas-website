---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import CtaButton from '../components/CtaButton.astro';
import { caseStudies } from '../data/caseStudies';
---

<BaseLayout
  title="Case Studies"
  description="Anonymized ServiceNow and AI engagements across banking, insurance, and manufacturing, in situation / action / outcome form."
>
  <PageHeader eyebrow="Proof of value" title="Selected work, in detail">
    Anonymized engagements, told the way I run them: a symptom, the method that fixes it, and the
    outcome. Same loop every time — find the bottleneck, improve the process, automate it, apply AI,
    measure. Names and exact figures, I'll walk you through on a call.
  </PageHeader>

  <Section>
    <div class="pov-list">
      {caseStudies.map((c, i) => (
        <article class="pov-card" data-reveal style={`--reveal-delay:${i * 80}ms`}>
          <header class="pov-head">
            <div class="pov-tags">
              <span class="pov-sector">{c.sector}</span>
              <span class="pov-persona">{c.persona}</span>
            </div>
            <h2 class="pov-title display">{c.title}</h2>
            <p class="pov-context muted">{c.sectorNote}</p>
          </header>
          <div class="pov-body">
            <dl class="sao">
              <div><dt>Symptom</dt><dd>{c.situation}</dd></div>
              <div><dt>Method</dt><dd>{c.action}</dd></div>
              <div><dt>Outcome</dt><dd>{c.outcome}</dd></div>
            </dl>
            <p class="pov-target"><span class="micro-tag">Typical target</span>{c.target}</p>
          </div>
        </article>
      ))}
    </div>
    <p class="muted cs-note">
      Client names and exact figures are kept private — the targets above are what this kind of work
      aims at. <a href="/contact/">Book a call</a> and I'll walk you through the real numbers.
    </p>
  </Section>

  <Section tone="dark">
    <div class="cta-band">
      <h2 class="cta-h2 display">Have a similar problem?</h2>
      <p class="cta-lead">
        Tell me what's slowing your team down. We'll find where a better process and the right AI
        actually help.
      </p>
      <div class="cluster">
        <CtaButton href="/contact/" size="lg">Book a consultation</CtaButton>
        <CtaButton href="/services/" variant="secondary" size="lg">See the services</CtaButton>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .pov-list {
    display: flex;
    flex-direction: column;
    gap: clamp(1rem, 0.6rem + 1.5vw, 1.75rem);
  }
  .pov-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem 2rem;
    padding: clamp(1.4rem, 1rem + 1.5vw, 2rem);
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }
  .pov-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.6rem;
  }
  .pov-sector {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.62rem;
    font-weight: 700;
    color: var(--accent-text);
    background: var(--accent-soft);
    border: 1px solid var(--accent);
    border-radius: var(--radius-pill);
    padding: 0.18rem 0.55rem;
  }
  .pov-persona {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.62rem;
    font-weight: 700;
    color: var(--text-subtle);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    padding: 0.18rem 0.55rem;
  }
  .pov-title {
    font-size: var(--step-2);
    line-height: 1.15;
    margin-bottom: 0.5rem;
  }
  .pov-context {
    font-size: var(--step--1);
    line-height: 1.5;
  }
  .pov-target {
    margin-top: 1rem;
    padding: 0.8rem 1rem;
    background: var(--accent-soft);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    line-height: 1.5;
  }
  .micro-tag {
    display: inline-block;
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.6rem;
    font-weight: 700;
    color: var(--accent-text);
    border: 1px solid var(--accent);
    border-radius: var(--radius-pill);
    padding: 0.1rem 0.45rem;
    margin-right: 0.5rem;
    vertical-align: middle;
  }
  .sao {
    display: grid;
    gap: 0.85rem;
    margin: 0;
  }
  .sao dt {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.72rem;
    color: var(--text-subtle);
    font-weight: 700;
    margin-bottom: 0.15rem;
  }
  .sao dd {
    margin: 0;
    color: var(--text-muted);
    line-height: 1.55;
  }
  .cs-note {
    margin-top: 1.75rem;
    max-width: 60ch;
    font-size: var(--step--1);
  }
  .cs-note a {
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .cta-band {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
    max-width: 46rem;
  }
  .cta-h2 {
    font-size: var(--step-3);
  }
  .cta-lead {
    color: #cfc9be;
    max-width: 52ch;
    line-height: 1.6;
  }
  @media (min-width: 760px) {
    /* story layout: header column + body column */
    .pov-card {
      grid-template-columns: 0.85fr 1.15fr;
      align-items: start;
    }
  }
</style>
