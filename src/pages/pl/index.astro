---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Home from '../../components/pages/Home.astro';
import { site } from '../../data/site';
import { useTranslations } from '../../i18n/ui';

const lang = 'pl' as const;
const t = useTranslations(lang);
const role = t('common.role');
const description = t('home.metaDescription');

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: site.name,
    url: site.url,
    jobTitle: role,
    description,
    sameAs: [site.socials.linkedin, site.socials.udemy, site.socials.github],
    knowsAbout: ['ServiceNow', 'Workflow automation', 'Process improvement', 'AI Agents', 'Now Assist', 'ITSM'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: 'Lukasz Szumilas — ServiceNow, AI & operational improvement',
    url: site.url,
    description,
    areaServed: 'Europe',
    serviceType: ['ServiceNow consulting', 'AI implementation', 'Process automation', 'Operational improvement'],
    provider: { '@type': 'Person', name: site.name },
  },
];
---

<BaseLayout lang={lang} locales={['en', 'pl']} description={description} jsonLd={jsonLd}>
  <Home lang={lang} />
</BaseLayout>
