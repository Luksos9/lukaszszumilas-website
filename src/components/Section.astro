---
interface Props {
  id?: string;
  tone?: 'default' | 'surface' | 'dark';
  class?: string;
}
const { id, tone = 'default', class: cls = '' } = Astro.props;
---

<section id={id} class:list={['section', `tone-${tone}`, cls]}>
  <div class="container">
    <slot />
  </div>
</section>

<style>
  .tone-surface {
    background: var(--surface);
  }
  .tone-dark {
    background: var(--lx-dark);
    color: var(--on-dark);
  }
  .tone-dark :global(.muted) {
    color: #b9b3a8;
  }
</style>
