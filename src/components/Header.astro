---
import { primaryNav } from '../data/nav';
import { site } from '../data/site';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const norm = (p: string) => (p !== '/' && p.endsWith('/') ? p.slice(0, -1) : p);
const here = norm(path);
const isActive = (href: string) => {
  const h = norm(href);
  return h === '/' ? here === '/' : here === h || here.startsWith(h + '/');
};

const links = primaryNav.filter((i) => !i.cta);
const cta = primaryNav.find((i) => i.cta);
const homeActive = here === '/';
---

<nav class="dock" aria-label="Primary" transition:persist>
  <a
    href="/"
    class:list={['dock-item dock-brand', { 'is-active': homeActive }]}
    aria-label={`${site.name}, home`}
    aria-current={homeActive ? 'page' : undefined}
  >
    <span class="dock-brandmark" aria-hidden="true">ŁS</span>
  </a>

  <span class="dock-divider" aria-hidden="true"></span>

  {links.map((i) => (
    <a
      href={i.href}
      class:list={['dock-item', { 'is-active': isActive(i.href) }]}
      aria-label={i.label}
      title={i.label}
      aria-current={isActive(i.href) ? 'page' : undefined}
    >
      <span class="dock-ico"><Icon name={i.icon ?? 'target'} size={20} /></span>
      <span class="dock-label">{i.label}</span>
    </a>
  ))}

  <span class="dock-divider" aria-hidden="true"></span>

  <ThemeToggle />

  {cta && (
    <a href={cta.href} class="dock-cta" aria-label={cta.label} data-analytics="book_dock">
      <span class="dock-cta-label">Book a call</span>
      <span class="dock-cta-arrow" aria-hidden="true">→</span>
    </a>
  )}
</nav>

<script>
  // The dock is transition:persist'd, so its server-rendered active state is
  // frozen from the first page. Re-sync the active item on every navigation.
  function syncDock() {
    const norm = (p: string) => (p !== '/' && p.endsWith('/') ? p.slice(0, -1) : p);
    const here = norm(location.pathname);
    document.querySelectorAll<HTMLAnchorElement>('.dock-item[href]').forEach((a) => {
      const href = norm(new URL(a.href).pathname);
      const active = href === '/' ? here === '/' : here === href || here.startsWith(href + '/');
      a.classList.toggle('is-active', active);
      if (active) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
    });
  }
  document.addEventListener('astro:page-load', syncDock);
</script>

<style>
  .dock {
    position: fixed;
    left: 0;
    right: 0;
    bottom: calc(0.9rem + env(safe-area-inset-bottom, 0px));
    z-index: 100;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    width: max-content;
    margin-inline: auto;
    max-width: calc(100vw - 1.25rem);
    padding: 0.4rem;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--surface) 80%, transparent);
    border: 1px solid var(--border-strong);
    box-shadow: var(--shadow-lg);
    -webkit-backdrop-filter: blur(16px) saturate(1.3);
    backdrop-filter: blur(16px) saturate(1.3);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .dock::-webkit-scrollbar {
    display: none;
  }
  .dock {
    animation: dockIn 0.6s var(--ease-out) 0.15s backwards;
  }
  @keyframes dockIn {
    from {
      opacity: 0;
      transform: translateY(26px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .dock-item {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    flex: 0 0 auto;
    padding: 0.5rem 0.62rem;
    border-radius: var(--radius-pill);
    color: var(--text-muted);
    font-weight: 600;
    font-size: var(--step--1);
    line-height: 1;
    white-space: nowrap;
    transition: color var(--dur) var(--ease), background var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease), transform var(--dur) var(--ease);
  }
  .dock-item:hover {
    color: var(--text);
    background: var(--accent-soft);
    transform: translateY(-2px);
  }
  .dock-ico {
    display: inline-grid;
    place-items: center;
  }
  .dock-label {
    display: none;
  }
  .dock-item.is-active {
    color: var(--accent);
    background: var(--accent-soft);
    box-shadow: 0 0 0 1.5px var(--accent), 0 0 20px -3px rgba(232, 115, 58, 0.55);
  }
  .dock-brand {
    padding: 0.32rem;
  }
  .dock-brandmark {
    display: grid;
    place-items: center;
    width: 1.95rem;
    height: 1.95rem;
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: var(--accent-contrast);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: -0.02em;
  }
  .dock-divider {
    flex: 0 0 auto;
    width: 1px;
    height: 1.7rem;
    background: var(--border);
    display: none;
  }
  .dock-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    flex: 0 0 auto;
    background: var(--accent);
    color: var(--accent-contrast);
    font-weight: 700;
    font-size: var(--step--1);
    padding: 0.6rem 0.85rem;
    border-radius: var(--radius-pill);
    white-space: nowrap;
    transition: background var(--dur) var(--ease), transform var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease);
  }
  .dock-cta:hover {
    background: var(--accent-hover);
    transform: translateY(-1px);
    box-shadow: 0 8px 22px rgba(232, 115, 58, 0.45);
  }
  .dock-cta-label {
    display: none;
  }
  .dock-cta-arrow {
    transition: transform var(--dur) var(--ease);
  }
  .dock-cta:hover .dock-cta-arrow {
    transform: translateX(3px);
  }

  /* the theme toggle is a flex child of the dock — keep it from shrinking */
  .dock :global(.theme-toggle) {
    flex: 0 0 auto;
  }
  /* tighten so the whole dock fits small phones without an internal scroll */
  @media (max-width: 520px) {
    .dock {
      gap: 0.15rem;
      padding: 0.3rem;
      max-width: calc(100vw - 0.6rem);
    }
    .dock-item {
      padding: 0.55rem 0.48rem;
    }
    .dock-brand {
      padding: 0.28rem;
    }
    .dock-brandmark {
      width: 1.7rem;
      height: 1.7rem;
    }
    .dock :global(.theme-toggle) {
      width: 2rem;
      height: 2rem;
    }
    .dock-cta {
      padding: 0.5rem 0.6rem;
    }
  }
  /* >=480px: label the CTA */
  @media (min-width: 480px) {
    .dock-cta-label {
      display: inline;
    }
  }
  /* >=720px: dividers + the active item shows its label */
  @media (min-width: 720px) {
    .dock {
      gap: 0.3rem;
      padding: 0.45rem;
    }
    .dock-divider {
      display: block;
    }
    .dock-item.is-active .dock-label {
      display: inline;
    }
  }
  /* >=1100px: every item shows its label */
  @media (min-width: 1100px) {
    .dock-label {
      display: inline;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .dock-cta:hover {
      transform: none;
    }
    .dock-cta:hover .dock-cta-arrow {
      transform: none;
    }
  }
</style>
