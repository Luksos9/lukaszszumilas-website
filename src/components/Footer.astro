---
import { footerNav } from '../data/nav';
import { site } from '../data/site';
import SocialLinks from './SocialLinks.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href="/" class="brand" aria-label={`${site.name}, home`}>
        <span class="brand-mark" aria-hidden="true">ŁS</span>
        <span class="brand-name">{site.name}</span>
      </a>
      <p class="footer-blurb muted">
        Operational Efficiency Advisor. I help organizations reduce manual work and improve
        operations with ServiceNow, AI, and process design.
      </p>
      <SocialLinks />
    </div>

    {footerNav.map((col) => (
      <nav class="footer-col" aria-label={col.title}>
        <h2 class="footer-col-title">{col.title}</h2>
        <ul role="list">
          {col.items.map((i) => (
            <li>
              <a
                href={i.href}
                target={i.external ? '_blank' : undefined}
                rel={i.external ? 'noopener noreferrer' : undefined}
              >
                {i.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ))}
  </div>

  <div class="container footer-bottom">
    <p class="muted">© {year} {site.name}. All rights reserved.</p>
    <p class="muted">
      Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>,
      hosted on GitHub Pages.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--section-y);
    background: var(--surface);
    border-top: 1px solid var(--border);
    /* extra bottom space so the fixed bottom-center dock never covers footer content */
    padding-block: clamp(2.5rem, 1.5rem + 3vw, 4rem) clamp(5.5rem, 4.5rem + 4vw, 7.5rem);
  }
  .footer-grid {
    display: grid;
    gap: 2rem clamp(1.5rem, 1rem + 2vw, 3rem);
    grid-template-columns: 1fr;
  }
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 30rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 700;
  }
  .brand-mark {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: var(--accent-contrast);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.82rem;
  }
  .footer-blurb {
    font-size: var(--step--1);
    line-height: 1.6;
    max-width: 32ch;
  }
  .footer-col-title {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--text-subtle);
    margin-bottom: 0.9rem;
  }
  .footer-col ul {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .footer-col a {
    color: var(--text-muted);
    transition: color var(--dur);
  }
  .footer-col a:hover {
    color: var(--accent);
  }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: var(--step--1);
  }
  .footer-bottom a {
    color: var(--text-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .footer-bottom a:hover {
    color: var(--accent);
  }
  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: 1.6fr 1fr 1fr 1fr;
    }
  }
</style>
