---
import '@fontsource-variable/inter';
import '@fontsource/space-mono/400.css';
import '@fontsource/space-mono/700.css';
import '@fontsource-variable/fraunces';
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '../styles/tokens.css';
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
  publishedTime?: Date;
  noindex?: boolean;
  canonical?: string;
  jsonLd?: object;
}

const { title, description, image, article, publishedTime, noindex, canonical, jsonLd } =
  Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>
      // Set theme before paint to avoid flash-of-incorrect-theme.
      (() => {
        try {
          // Dark by default; light only if the visitor explicitly chose it.
          const stored = localStorage.getItem('ls-theme');
          document.documentElement.dataset.theme = stored === 'light' ? 'light' : 'dark';
        } catch (e) {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
      document.documentElement.classList.add('js');
    </script>
    <BaseHead
      title={title}
      description={description}
      image={image}
      article={article}
      publishedTime={publishedTime}
      noindex={noindex}
      canonical={canonical}
      jsonLd={jsonLd}
    />
    <link rel="preload" href={interWoff2} as="font" type="font/woff2" crossorigin="anonymous" />
    <Analytics />
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      // Re-run on every View Transitions navigation (astro:page-load fires on
      // first load AND after each client navigation), so freshly-swapped
      // [data-reveal] elements get observed instead of staying hidden.
      function initReveal() {
        if (!('IntersectionObserver' in window)) return;
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 }
        );
        document.querySelectorAll('[data-reveal]:not(.is-visible)').forEach((el) => io.observe(el));
      }
      document.addEventListener('astro:page-load', initReveal);
    </script>
    <script>
      // Analytics helper — no-ops entirely until a GA4 id is set (window.__GA_ID
      // is defined by Analytics.astro only when site.analytics.ga4Id is present).
      const w = window as any;
      function gaPageView() {
        if (w.gtag && w.__GA_ID) {
          w.gtag('event', 'page_view', {
            page_title: document.title,
            page_location: location.href,
            page_path: location.pathname,
          });
        }
      }
      w.track = (name: string, params?: Record<string, unknown>) => {
        if (w.gtag && w.__GA_ID) w.gtag('event', name, params || {});
      };
      document.addEventListener('astro:page-load', gaPageView);
      document.addEventListener('click', (e) => {
        const target = e.target as Element | null;
        const el = target && target.closest ? target.closest('[data-analytics]') : null;
        if (el) {
          w.track(el.getAttribute('data-analytics') || 'click', {
            label: (el.textContent || '').trim().slice(0, 80),
          });
        }
      });
    </script>
  </body>
</html>
