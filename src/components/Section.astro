---
interface Props {
  id?: string;
  tone?: 'default' | 'surface' | 'dark';
  class?: string;
  /** Adds an id + data-nav so the section appears in the right-edge scroll guide. */
  navLabel?: string;
  /** Icon name (see Header rail icons) shown for this section in the scroll guide. */
  navIcon?: string;
  /** Opt-in: renders a `decor` slot behind the content and clips it (background art). */
  decor?: boolean;
}
const { id, tone = 'default', class: cls = '', navLabel, navIcon, decor = false } = Astro.props;
const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const sectionId = id ?? (navLabel ? slugify(navLabel) : undefined);
---

<section
  id={sectionId}
  class:list={['section', `tone-${tone}`, { 'has-decor': decor }, cls]}
  data-nav={navLabel}
  data-nav-icon={navIcon}
>
  {decor && <slot name="decor" />}
  <div class="container">
    <slot />
  </div>
</section>

<style>
  .tone-surface {
    background: var(--surface);
  }
  .tone-dark {
    background: var(--lx-dark);
    color: var(--on-dark);
  }
  .tone-dark :global(.muted) {
    color: #b9b3a8;
  }
  /* only decorated sections clip + establish a stacking context */
  .section.has-decor {
    position: relative;
    isolation: isolate;
    overflow: clip;
  }
  .section.has-decor > .container {
    position: relative;
    z-index: 1;
  }
</style>
