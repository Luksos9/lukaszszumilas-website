---
import { site } from '../data/site';
import SocialLinks from './SocialLinks.astro';
import { getFooterNav } from '../i18n/data';
import { useTranslations, localizeForNav, defaultLang, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
}
const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const footerNav = getFooterNav(lang);
const homeHref = localizeForNav('/', lang);
const year = new Date().getFullYear();
const crossLocale = (href: string) =>
  lang !== defaultLang && !/^(https?:|mailto:|tel:|#)/.test(href) && !href.startsWith(`/${lang}/`);
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href={homeHref} class="brand" aria-label={`${site.name}, ${t('common.homeAria')}`}>
        <img class="footer-logo footer-logo--dark" src="/footer-logo-dark.webp" alt="" width="480" height="311" loading="lazy" />
        <img class="footer-logo footer-logo--light" src="/footer-logo-light.webp" alt="" width="480" height="311" loading="lazy" />
      </a>
      <p class="footer-blurb muted">{t('footer.blurb')}</p>
      <SocialLinks />
    </div>

    {footerNav.map((col) => (
      <nav class="footer-col" aria-label={col.title}>
        <h2 class="footer-col-title">{col.title}</h2>
        <ul role="list">
          {col.items.map((i) => (
            <li>
              <a
                href={i.href}
                target={i.external ? '_blank' : undefined}
                rel={i.external ? 'noopener noreferrer' : undefined}
                data-astro-reload={crossLocale(i.href) ? '' : undefined}
              >
                {i.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ))}
  </div>

  <div class="container footer-bottom">
    <p class="muted">© {year} {site.name}. {t('footer.rights')}</p>
    <p class="muted">
      {t('footer.builtPre')} <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>{t('footer.builtPost')}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--section-y);
    background: var(--surface);
    border-top: 1px solid var(--border);
    padding-block: clamp(2.5rem, 1.5rem + 3vw, 4rem) clamp(2.5rem, 1.5rem + 2vw, 3.5rem);
  }
  .footer-grid {
    display: grid;
    gap: 2rem clamp(1.5rem, 1rem + 2vw, 3rem);
    grid-template-columns: 1fr;
  }
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 30rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 700;
  }
  .footer-logo {
    display: block;
    width: clamp(11rem, 9rem + 6vw, 13.5rem);
    height: auto;
  }
  /* theme-aware lockup: white text for dark (default), ink text for light.
     transparent backgrounds, so no boxed look. */
  .footer-logo--light {
    display: none;
  }
  :root[data-theme='light'] .footer-logo--dark {
    display: none;
  }
  :root[data-theme='light'] .footer-logo--light {
    display: block;
  }
  .brand-mark {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: var(--accent-contrast);
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.82rem;
  }
  .footer-blurb {
    font-size: var(--step--1);
    line-height: 1.6;
    max-width: 32ch;
  }
  .footer-col-title {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--text-subtle);
    margin-bottom: 0.9rem;
  }
  .footer-col ul {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .footer-col a {
    color: var(--text-muted);
    transition: color var(--dur);
  }
  .footer-col a:hover {
    color: var(--accent-text);
  }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: var(--step--1);
  }
  .footer-bottom a {
    color: var(--text-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .footer-bottom a:hover {
    color: var(--accent-text);
  }
  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: 1.6fr 1fr 1fr 1fr;
    }
  }
</style>
