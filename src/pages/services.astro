---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import CtaButton from '../components/CtaButton.astro';
import TrainingIllustration from '../components/TrainingIllustration.astro';
import { services } from '../data/services';
import { site } from '../data/site';
---

<BaseLayout
  title="Services"
  description="ServiceNow and AI consulting: AI opportunity assessments, AI & ServiceNow implementations, platform development, and architecture reviews."
>
  <PageHeader eyebrow="Services" title="How I can help">
    Consulting for teams that run on ServiceNow and want AI that actually ships. From the first
    assessment through implementation, development, and review.
  </PageHeader>

  <Section>
    <div class="services-list">
      {services.map((s) => (
        <article id={s.anchor} class:list={['service', { 'service--featured': s.categories }]}>
          <h2 class="service-title display">{s.title}</h2>
          {s.problem && <p class="service-problem">{s.problem}</p>}
          {s.examples && (
            <div>
              <p class="service-label">What it covers</p>
              <ul class="service-items" role="list">
                {s.examples.map((e) => <li>{e}</li>)}
              </ul>
            </div>
          )}
          {s.deliverables && !s.categories && (
            <div>
              <p class="service-label">What you get</p>
              <ul class="service-items" role="list">
                {s.deliverables.map((d) => <li>{d}</li>)}
              </ul>
            </div>
          )}
          {s.categories && (
            <div class="train">
              <p class="service-label">What you get</p>
              <div class="train-grid">
                {s.categories.map((c) => (
                  <div class="train-card shine">
                    <span class="train-illo"><TrainingIllustration illo={c.illo} /></span>
                    <h3 class="train-card-title">{c.title}</h3>
                    <p class="train-card-blurb muted">{c.blurb}</p>
                  </div>
                ))}
              </div>
            </div>
          )}
          {s.outcome && (
            <p class="service-outcome"><strong>Outcome:</strong> {s.outcome}</p>
          )}
        </article>
      ))}
    </div>
  </Section>

  <Section tone="dark">
    <div class="cta-band">
      <h2 class="cta-h2 display">Have a project or a problem worth solving?</h2>
      <p class="cta-lead">
        Tell me what you're working on. I'll tell you honestly whether I'm the right person for it.
      </p>
      <div class="cluster">
        <CtaButton href="/contact/" size="lg">Book a consultation</CtaButton>
        <CtaButton href={site.socials.linkedin} variant="secondary" size="lg" external>Connect on LinkedIn</CtaButton>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .services-list {
    display: flex;
    flex-direction: column;
    gap: clamp(2rem, 1.5rem + 2.5vw, 3.75rem);
    max-width: 72ch;
  }
  .service {
    scroll-margin-top: 6rem;
  }
  .service-title {
    font-size: var(--step-3);
    margin-bottom: 0.75rem;
  }
  .service-problem {
    color: var(--text-muted);
  }
  .service-label {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.78rem;
    color: var(--text-subtle);
    font-weight: 700;
    margin: 1.25rem 0 0.5rem;
  }
  .service-items {
    display: grid;
    gap: 0.4rem;
    padding-left: 1.2rem;
  }
  .service-items li {
    color: var(--text);
  }
  .service-items li::marker {
    color: var(--accent-text);
  }
  .service-outcome {
    margin-top: 1.25rem;
    padding: 0.85rem 1.1rem;
    background: var(--accent-soft);
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }
  /* featured service (Training) — illustrated grid in a distinct panel */
  .service--featured {
    padding: clamp(1.4rem, 1rem + 2vw, 2.25rem);
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
  }
  .train-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 0.5rem;
  }
  .train-card {
    padding: 1.25rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .train-card:hover {
    border-color: var(--accent);
    box-shadow: var(--shadow);
  }
  .train-card > * {
    position: relative;
    z-index: 2;
  }
  .train-illo {
    display: block;
    width: 76px;
    color: var(--text);
    margin-bottom: 0.6rem;
  }
  .train-card-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--step-1);
    margin-bottom: 0.3rem;
  }
  .train-card-blurb {
    font-size: var(--step--1);
    line-height: 1.5;
  }
  @media (min-width: 560px) {
    .train-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  .cta-band {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
    max-width: 46rem;
  }
  .cta-h2 {
    font-size: var(--step-3);
  }
  .cta-lead {
    color: #cfc9be;
    max-width: 52ch;
    line-height: 1.6;
  }
</style>
