---
// Ambient process/workflow background fragments. Faint, static, dual-theme via
// currentColor + opacity; one accent shape per scene. aria-hidden, never clickable.
// Always mount inside a clipped (overflow:clip) positioned host (Section decor slot).
interface Props {
  variant: 'corner-br' | 'diamond-corner' | 'pipeline-edge' | 'grid';
  class?: string;
}
const { variant, class: cls = '' } = Astro.props;
const svgAttrs = {
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': '1.5',
  'stroke-linecap': 'round',
  'stroke-linejoin': 'round',
  focusable: 'false',
} as const;
---

<div class:list={['bgdecor', `bgdecor--${variant}`, cls]} aria-hidden="true">
  {variant === 'corner-br' && (
    <svg viewBox="0 0 320 260" preserveAspectRatio="xMidYMid slice" {...svgAttrs}>
      <rect x="20" y="24" width="92" height="44" rx="9" />
      <path d="M34 42h64M34 54h40" />
      <path d="M112 46h40" />
      <path d="M146 40l8 6-8 6" />
      <path d="M196 16 L236 46 L196 76 L156 46 Z" />
      <path d="M236 46h64" />
      <path class="bd-accent" d="M292 40l8 6-8 6" />
      <path d="M196 76v40h-56" />
      <rect x="64" y="104" width="72" height="30" rx="15" />
      <circle cx="196" cy="76" r="3" fill="currentColor" stroke="none" />
    </svg>
  )}
  {variant === 'diamond-corner' && (
    <svg viewBox="0 0 220 220" preserveAspectRatio="xMidYMid slice" {...svgAttrs}>
      <path class="bd-accent" d="M70 30 L110 64 L70 98 L30 64 Z" />
      <path d="M110 64h26v52" />
      <path d="M130 110l6 8 6-8" />
      <path d="M150 150 L196 188 L150 226 L104 188 Z" />
      <circle cx="136" cy="64" r="3" fill="currentColor" stroke="none" />
    </svg>
  )}
  {variant === 'pipeline-edge' && (
    <svg viewBox="0 0 640 120" preserveAspectRatio="xMidYMax slice" {...svgAttrs}>
      <line x1="-40" y1="86" x2="680" y2="86" />
      <rect x="60" y="66" width="58" height="40" rx="8" /><path d="M74 82h30" />
      <rect x="230" y="66" width="58" height="40" rx="8" /><path d="M244 82h30" />
      <rect x="400" y="66" width="58" height="40" rx="8" /><path d="M414 82h30" />
      <rect x="570" y="66" width="58" height="40" rx="8" /><path d="M584 82h30" />
      <path class="bd-accent" d="M118 86h100" /><path class="bd-accent" d="M218 80l8 6-8 6" />
      <path d="M288 86h100" /><path d="M388 80l8 6-8 6" />
      <path d="M458 86h100" /><path d="M558 80l8 6-8 6" />
      <circle cx="60" cy="86" r="3" fill="currentColor" stroke="none" />
      <circle cx="230" cy="86" r="3" fill="currentColor" stroke="none" />
      <circle cx="400" cy="86" r="3" fill="currentColor" stroke="none" />
      <circle cx="570" cy="86" r="3" fill="currentColor" stroke="none" />
    </svg>
  )}
  {/* grid = pure CSS, no markup */}
</div>

<style>
  .bgdecor {
    position: absolute;
    z-index: 0;
    color: var(--text);
    pointer-events: none;
    user-select: none;
  }
  .bgdecor svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .bd-accent {
    stroke: var(--accent);
  }

  .bgdecor--corner-br {
    width: clamp(180px, 22vw, 300px);
    aspect-ratio: 320 / 260;
    right: -40px;
    bottom: -30px;
    opacity: 0.05;
  }
  .bgdecor--diamond-corner {
    width: clamp(150px, 18vw, 240px);
    aspect-ratio: 1 / 1;
    top: -34px;
    right: -30px;
    opacity: 0.05;
  }
  .bgdecor--pipeline-edge {
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: clamp(72px, 12vh, 120px);
    opacity: 0.055;
  }
  /* blueprint grid — the closing band is always dark, so fixed light lines */
  .bgdecor--grid {
    inset: 0;
    opacity: 0.05;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.6) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.6) 1px, transparent 1px);
    background-size: 40px 40px;
    -webkit-mask-image: radial-gradient(ellipse 75% 85% at 50% 50%, #000 28%, transparent 80%);
    mask-image: radial-gradient(ellipse 75% 85% at 50% 50%, #000 28%, transparent 80%);
  }

  /* opacity is the only theme-conditional value (dialed for ink-on-cream vs white-on-black) */
  :global(:root[data-theme='dark']) .bgdecor--corner-br {
    opacity: 0.06;
  }
  :global(:root[data-theme='dark']) .bgdecor--diamond-corner {
    opacity: 0.055;
  }
  :global(:root[data-theme='dark']) .bgdecor--pipeline-edge {
    opacity: 0.045;
  }

  @media (max-width: 640px) {
    .bgdecor--diamond-corner {
      display: none;
    }
  }
</style>
